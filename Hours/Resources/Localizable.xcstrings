          }
        }
      }
    },
    "One name per line, or paste a list. Each gets the crew, usual day and extras you choose next.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Name pro Zeile, oder eine Liste einfügen. Jede bekommt die Mannschaft, den üblichen Tag und die Extras, die du als Nächstes wählst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nombre por línea, o pega una lista. Cada una recibe la cuadrilla, el día habitual y los extras que elijas después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nom par ligne, ou collez une liste. Chacun reçoit l’équipe, la journée type et les options que vous choisirez ensuite."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedan naziv po retku, ili zalijepi popis. Svako dobiva ekipu, uobičajeni dan i dodatke koje biraš dalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un nome per riga, o incolla un elenco. Ognuno avrà la squadra, la giornata tipo e gli extra che scegli dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén naam per regel, of plak een lijst. Elk krijgt de ploeg, de gewone dag en de extra’s die je hierna kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna nazwa w wierszu albo wklej listę. Każda dostanie ekipę, zwykły dzień i dodatki, które wybierzesz dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um nome por linha, ou cola uma lista. Cada uma fica com a equipa, o dia habitual e os extras que escolheres a seguir."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eno ime na vrstico ali prilepi seznam. Vsako dobi ekipo, običajni dan in dodatke, ki jih izbereš naprej."
          }
        }
      }
    },
    "One sheet per person": {
