    "Add each site's address and place later, in its settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresse und Ort jeder Baustelle später in ihren Einstellungen ergänzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la dirección y el lugar de cada obra después, en sus ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez l’adresse et le lieu de chaque chantier plus tard, dans ses réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresu i mjesto svakog gradilišta dodaj kasnije u njegovim postavkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Indirizzo e luogo di ogni cantiere si aggiungono dopo, nelle sue impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg adres en plek van elke bouwplaats later toe, in de instellingen ervan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres i miejsce każdej budowy dodasz później w jej ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a morada e o local de cada obra depois, nas definições dela."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov in kraj vsakega gradbišča dodaš pozneje v njegovih nastavitvah."
          }
        }
      }
    },
