    "First it saves where the site is, from your current location — so do this standing at the site.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst speichert es, wo die Baustelle ist, aus deinem aktuellen Standort – mach das also auf der Baustelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero guarda dónde está la obra a partir de tu ubicación actual, así que hazlo estando en la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "D’abord, il enregistre l’emplacement du chantier à partir de votre position actuelle : faites-le donc sur le chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije sprema gdje je gradilište, iz tvoje trenutne lokacije — zato to napravi dok stojiš na gradilištu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima salva dove si trova il cantiere, dalla tua posizione attuale: fallo quindi mentre sei in cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eerst bewaart het waar de bouwplaats is, vanaf je huidige locatie — doe dit dus terwijl je op de bouwplaats staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zapisuje, gdzie jest budowa, na podstawie twojej bieżącej lokalizacji — zrób to więc, stojąc na budowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Primeiro guarda onde fica a obra a partir da tua localização atual — por isso faz isto estando na obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprej shrani, kje je gradbišče, iz tvoje trenutne lokacije — zato to naredi, ko stojiš na gradbišču."
          }
        }
      }
    },
