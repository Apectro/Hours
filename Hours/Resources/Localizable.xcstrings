    "Notifications are switched off for Zeitkonto in the Settings app. Turn them on there and this will start working.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitteilungen sind für Zeitkonto in der Einstellungen-App ausgeschaltet. Schalte sie dort ein, dann funktioniert das hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las notificaciones de Zeitkonto están desactivadas en la app Ajustes. Actívalas allí y esto empezará a funcionar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les notifications de Zeitkonto sont désactivées dans l'app Réglages. Activez-les là-bas et ceci fonctionnera."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavijesti za Zeitkonto isključene su u aplikaciji Postavke. Uključi ih ondje i ovo će početi raditi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
