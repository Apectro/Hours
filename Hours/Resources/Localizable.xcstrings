    "Marks each day as %@. Any hours on those days are removed if the type does not use times.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Markiert jeden Tag als %@. Stunden an diesen Tagen werden entfernt, wenn die Art keine Zeiten verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada día como %@. Las horas de esos días se eliminan si el tipo no usa horarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Marque chaque jour comme %@. Les heures de ces jours sont supprimées si le type n'utilise pas d'horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označava svaki dan kao %@. Sati na tim danima uklanjaju se ako vrsta ne koristi vremena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna ogni giorno come %@. Le ore su quei giorni vengono rimosse se il tipo non usa gli orari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Markeert elke dag als %@. Uren op die dagen worden verwijderd als het type geen tijden gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Oznacza każdy dzień jako %@. Godziny w tych dniach są usuwane, jeśli typ nie używa godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca cada dia como %@. As horas desses dias são removidas se o tipo não usar horários."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi vsak dan kot %@. Ure na teh dnevih se odstranijo, če vrsta ne uporablja časov."
          }
        }
      }
    },
