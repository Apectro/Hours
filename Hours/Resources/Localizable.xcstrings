            "value": "Je eerste invoer"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój pierwszy wpis"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O teu primeiro registo"
          }
        },
        "sl": {
