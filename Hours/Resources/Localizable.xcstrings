    "Pick a different range, or switch on “Include days with no entry” in export options.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle einen anderen Zeitraum oder aktiviere „Tage ohne Eintrag einbeziehen“ in den Exportoptionen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige otro intervalo o activa «Incluir días sin registro» en las opciones de exportación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une autre plage, ou activez « Inclure les jours sans saisie » dans les options d’export."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi drugi raspon ili uključi „Uključi dane bez unosa” u postavkama izvoza."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un intervallo diverso o attiva «Includi i giorni senza voci» nelle opzioni di esportazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een ander bereik, of zet ‘Dagen zonder invoer meenemen’ aan bij de exportopties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz inny zakres albo włącz „Uwzględnij dni bez wpisu” w opcjach eksportu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe outro intervalo ou liga «Incluir dias sem registo» nas opções de exportação."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi drug obseg ali vklopi »Vključi dneve brez vnosa« v možnostih izvoza."
          }
        }
      }
    },
