    "Turn this off to keep a day's details without counting it towards any total.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das aus, um die Angaben eines Tages zu behalten, ohne ihn in Summen einzurechnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para conservar los detalles de un día sin incluirlo en los totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez ceci pour conserver les détails d’un jour sans le compter dans les totaux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi ovo da zadržiš podatke o danu, a da se ne računa ni u jedan zbroj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivalo per conservare i dettagli di un giorno senza includerlo nei totali."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit uit om de gegevens van een dag te bewaren zonder mee te tellen in totalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz to, aby zachować szczegóły dnia bez wliczania go do sum."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativa isto para manter os detalhes de um dia sem o incluir nos totais."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopi to, če želiš obdržati podatke o dnevu, ne da bi se štel v seštevke."
          }
        }
      }
    },
