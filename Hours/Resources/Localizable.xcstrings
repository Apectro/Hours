    "Drag to reorder. Columns for fields you have switched off are never offered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umsortieren ziehen. Spalten für ausgeschaltete Felder werden nie angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Las columnas de los campos desactivados nunca se ofrecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Les colonnes des champs désactivés ne sont jamais proposées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za promjenu redoslijeda. Stupci za isključena polja se nikad ne nude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Le colonne dei campi disattivati non vengono mai proposte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herordenen. Kolommen voor uitgeschakelde velden worden nooit aangeboden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Kolumny wyłączonych pól nigdy nie są proponowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrasta para reordenar. As colunas dos campos desligados nunca são oferecidas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Povleci za spremembo vrstnega reda. Stolpci za izklopljena polja se nikoli ne ponudijo."
          }
        }
      }
    },
