            "value": "Trascina per riordinare. Le colonne dei campi disattivati non vengono mai proposte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep om te herordenen. Kolommen voor uitgeschakelde velden worden nooit aangeboden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zmienić kolejność. Kolumny wyłączonych pól nigdy nie są proponowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
