    "Remove the public holidays that were added? Holidays you added yourself stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die hinzugefügten gesetzlichen Feiertage entfernen? Selbst eingetragene Feiertage bleiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Quitar los festivos añadidos? Los que añadiste tú se quedan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirer les jours fériés ajoutés ? Ceux que vous avez ajoutés vous-même restent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukloniti dodane državne blagdane? Blagdani koje si sam dodao ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovere le festività nazionali aggiunte? Quelle che hai aggiunto tu restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De toegevoegde feestdagen verwijderen? Feestdagen die je zelf hebt toegevoegd blijven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć dodane święta państwowe? Święta dodane przez ciebie zostaną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remover os feriados adicionados? Os que adicionaste tu ficam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranim dodane državne praznike? Prazniki, ki si jih dodal sam, ostanejo."
          }
        }
      }
    },
