    "With several breaks switched on, each can be a length or a pair of times.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit mehreren Pausen kann jede eine Dauer oder ein Zeitpaar sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con varios descansos activados, cada uno puede ser una duración o un par de horarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec plusieurs pauses activées, chacune peut être une durée ou un couple d’horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz uključene višestruke pauze, svaka može biti trajanje ili par vremena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con più pause attive, ciascuna può essere una durata o una coppia di orari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met meerdere pauzes aan kan elke pauze een duur of een paar tijden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy włączonych wielu przerwach każda może być czasem trwania lub parą godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com várias pausas ativas, cada uma pode ser uma duração ou um par de horários."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je vklopljenih več odmorov, je lahko vsak trajanje ali par časov."
          }
        }
      }
    },
