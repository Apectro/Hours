    "Overtime you had before using the app. The balance counts from the start date, or else from your first recorded day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden, die du schon vor der App hattest. Der Saldo zählt ab dem Startdatum, sonst ab deinem ersten erfassten Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra que tenías antes de la app. El saldo cuenta desde la fecha de inicio o, si no, desde tu primer día registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures supplémentaires que vous aviez avant l’app. Le solde part de la date de début, sinon de votre premier jour saisi."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni koje si imao prije aplikacije. Saldo se broji od datuma početka, inače od tvog prvog zabilježenog dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli straordinari che avevi prima dell’app. Il saldo parte dalla data di inizio, altrimenti dal tuo primo giorno registrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De overuren die je had vóór de app. Het saldo telt vanaf de startdatum, anders vanaf je eerste vastgelegde dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny, które miałeś przed aplikacją. Saldo liczy się od daty początkowej, a bez niej od pierwszego zapisanego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas extra que tinhas antes da app. O saldo conta a partir da data de início ou, sem ela, do teu primeiro dia registado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure, ki si jih imel pred aplikacijo. Saldo se šteje od datuma začetka, sicer od tvojega prvega zabeleženega dne."
          }
        }
      }
    },
    "Overtime, surcharges and paid days off can be added later in Settings › Pay.": {
      "extractionState": "manual",
      "localizations": {
