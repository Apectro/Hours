    "Their days on every site, with the hours and any days away: one page to check against the payslip, or to sign.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tage auf allen Baustellen, mit den Stunden und den Abwesenheiten: eine Seite zum Abgleich mit der Lohnabrechnung oder zum Unterschreiben."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días en todas las obras, con las horas y las ausencias: una página para cotejar con la nómina o para firmar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours sur tous les chantiers, avec les heures et les absences : une page à comparer avec la fiche de paie, ou à signer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani na svim gradilištima, sa satima i danima odsutnosti: jedna stranica za provjeru platne liste ili za potpis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni in tutti i cantieri, con le ore e le assenze: una pagina da confrontare con la busta paga o da firmare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dagen op alle bouwplaatsen, met de uren en de afwezigheid: één pagina om met de loonstrook te vergelijken of te ondertekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni na wszystkich budowach, z godzinami i nieobecnościami: jedna strona do porównania z paskiem wypłaty lub do podpisu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias em todas as obras, com as horas e as ausências: uma página para conferir com o recibo de vencimento ou para assinar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevi na vseh gradbiščih, z urami in dnevi odsotnosti: ena stran za primerjavo s plačilno listo ali za podpis."
          }
        }
      }
    },
