            "state": "translated",
            "value": "Ore modificate dopo la firma del %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uren gewijzigd na ondertekening op %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny zmienione po podpisaniu %@"
          }
        },
        "pt": {
          "stringUnit": {
