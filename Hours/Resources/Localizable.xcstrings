          }
        }
      }
    },
    "An archived job keeps everything already recorded against it but stops expecting hours and stops being offered for new work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Tätigkeit behält alles bisher Erfasste, erwartet aber keine Stunden mehr und wird für neue Arbeit nicht mehr angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trabajo archivado conserva todo lo ya registrado, pero deja de prever horas y de ofrecerse para trabajo nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poste archivé conserve tout ce qui y a déjà été enregistré, mais cesse d’attendre des heures et n’est plus proposé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirani posao zadržava sve što je već zabilježeno, ali više ne očekuje sate niti se nudi za novi rad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lavoro archiviato conserva tutto ciò che è già registrato, ma smette di prevedere ore e non viene più proposto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde functie behoudt alles wat er al is vastgelegd, maar verwacht geen uren meer en wordt niet meer aangeboden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana praca zachowuje wszystko, co już zapisano, ale przestaje oczekiwać godzin i nie jest proponowana do nowej pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um trabalho arquivado mantém tudo o que já foi registado, mas deixa de prever horas e de ser oferecido para trabalho novo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirano delo obdrži vse že zabeleženo, a ne pričakuje več ur in se ne ponuja za novo delo."
          }
        }
      }
    },
    "An archived site keeps every recorded day and its whole crew, and stops appearing among your active sites.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine archivierte Baustelle behält jeden erfassten Tag und ihre ganze Mannschaft und erscheint nicht mehr unter deinen aktiven Baustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una obra archivada conserva cada día registrado y toda su cuadrilla, y deja de aparecer entre tus obras activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chantier archivé conserve chaque jour enregistré et toute son équipe, et n’apparaît plus parmi vos chantiers actifs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirano gradilište zadržava svaki zabilježeni dan i cijelu ekipu te se više ne prikazuje među aktivnim gradilištima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cantiere archiviato conserva ogni giorno registrato e tutta la squadra, e non compare più tra i cantieri attivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gearchiveerde bouwplaats houdt elke vastgelegde dag en de hele ploeg, en verschijnt niet meer bij je actieve bouwplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarchiwizowana budowa zachowuje każdy zapisany dzień i całą ekipę, ale nie pojawia się już wśród aktywnych budów."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma obra arquivada mantém todos os dias registados e toda a equipa, e deixa de aparecer entre as obras ativas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirano gradbišče obdrži vsak zabeležen dan in vso ekipo ter se ne prikazuje več med aktivnimi gradbišči."
          }
        }
      }
    },
    "An end time earlier than the start is treated as an overnight shift.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Ende vor dem Beginn gilt als Nachtschicht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fin anterior al inicio se trata como turno de noche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fin antérieure au début est traitée comme un poste de nuit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kraj raniji od početka tretira se kao noćna smjena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una fine precedente all’inizio viene trattata come turno notturno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een einde vóór de start geldt als nachtdienst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koniec wcześniejszy niż początek traktowany jest jako zmiana nocna."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um fim anterior ao início é tratado como turno noturno."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konec pred začetkom se šteje za nočno izmeno."
          }
        }
      }
    },
    "Appearance": {
      "extractionState": "manual",
      "localizations": {
