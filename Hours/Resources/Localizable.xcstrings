    "Nothing is added until you have seen the list. The holidays come from tables inside the app; nothing is looked up online.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird hinzugefügt, bevor du die Liste gesehen hast. Die Feiertage stammen aus Tabellen in der App; nichts wird online abgefragt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se añade nada hasta que hayas visto la lista. Los festivos vienen de tablas dentro de la app; no se consulta nada en internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est ajouté avant que vous ayez vu la liste. Les jours fériés viennent de tableaux intégrés à l’app ; rien n’est recherché en ligne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne dodaje dok ne vidiš popis. Blagdani dolaze iz tablica u aplikaciji; ništa se ne traži na internetu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene aggiunto nulla finché non hai visto l'elenco. Le festività vengono da tabelle nell'app; nulla viene cercato online."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets toegevoegd voordat je de lijst hebt gezien. De feestdagen komen uit tabellen in de app; er wordt niets online opgezocht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie dodane, zanim zobaczysz listę. Święta pochodzą z tabel w aplikacji; nic nie jest sprawdzane w internecie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é adicionado antes de veres a lista. Os feriados vêm de tabelas dentro da app; nada é consultado online."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič se ne doda, dokler ne vidiš seznama. Prazniki so iz tabel v aplikaciji; nič se ne išče na spletu."
          }
        }
      }
    },
    "Nothing is deleted from this device, and nothing is deleted from iCloud either — it simply stops being updated.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird von diesem Gerät gelöscht und auch nichts aus iCloud – es wird einfach nicht mehr aktualisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se borra nada de este dispositivo ni de iCloud: simplemente deja de actualizarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n'est supprimé de cet appareil, ni d'iCloud — la copie cesse simplement d'être mise à jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne briše s ovog uređaja, a ni iz iClouda — samo se prestaje ažurirati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene eliminato nulla da questo dispositivo, né da iCloud: semplicemente smette di aggiornarsi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets van dit apparaat verwijderd en ook niets uit iCloud — het wordt gewoon niet meer bijgewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie usunięte z tego urządzenia ani z iCloud — po prostu przestanie być aktualizowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é apagado deste dispositivo nem do iCloud — simplesmente deixa de ser atualizado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič se ne izbriše s te naprave in nič iz iClouda — preprosto se neha posodabljati."
          }
        }
      }
    },
    "Nothing is recorded and the clock stops.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird nichts erfasst und die Uhr stoppt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se registra nada y el fichaje se detiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est enregistré et le pointage s’arrête."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne bilježi i sat se zaustavlja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene registrato nulla e la timbratura si ferma."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt niets vastgelegd en de klok stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie zostanie zapisane, a zegar się zatrzyma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é registado nada e o registo para."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nič se ne zabeleži in ura se ustavi."
          }
        }
      }
    },
    "Nothing recorded in %@ yet. Your review fills in as the days do.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ ist noch nichts erfasst. Dein Rückblick füllt sich mit den Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada registrado en %@. Tu resumen se llena a medida que pasan los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’enregistré en %@ pour l’instant. Votre bilan se remplit au fil des jours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za %@. još ništa nije upisano. Tvoj pregled puni se zajedno s danima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel %@ non c’è ancora niente. Il tuo riepilogo si riempie insieme ai giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ is nog niets vastgelegd. Je overzicht vult zich met de dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %@ nic jeszcze nie zapisano. Twoje podsumowanie wypełni się razem z dniami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
