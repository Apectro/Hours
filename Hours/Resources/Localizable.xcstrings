    "Overtime needs expected hours to measure against, so it follows that setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden brauchen Sollstunden als Maßstab, also folgen sie dieser Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra necesitan horas previstas con las que medirse, así que siguen ese ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures supplémentaires ont besoin d’heures prévues comme référence : elles suivent donc ce réglage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni trebaju planirane sate kao mjerilo pa slijede tu postavku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli straordinari hanno bisogno di ore previste come riferimento, quindi seguono quell’impostazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overuren hebben verwachte uren nodig als maatstaf, dus ze volgen die instelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny potrzebują wymaganych godzin jako punktu odniesienia, więc podążają za tym ustawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas extra precisam de horas previstas como referência, por isso seguem essa definição."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure potrebujejo predvidene ure kot merilo, zato sledijo tej nastavitvi."
          }
        }
      }
    },
