    "%@ is closed, so that shift was not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist abgeschlossen, daher wurde diese Schicht nicht erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está cerrado, así que ese turno no se registró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est clôturé, ce poste n'a donc pas été enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je zatvoren, pa ta smjena nije zabilježena."
          }
