    "Days before the change keep the pay they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage vor der Änderung behalten ihren bisherigen Lohn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días anteriores al cambio conservan el pago que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours antérieurs au changement gardent la rémunération qu’ils avaient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani prije promjene zadržavaju plaću koju su imali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni prima della modifica mantengono la paga che avevano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen vóór de wijziging houden het loon dat ze hadden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni przed zmianą zachowują dotychczasowe wynagrodzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias antes da alteração mantêm o pagamento que tinham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevi pred spremembo obdržijo plačilo, ki so ga imeli."
          }
        }
      }
    },
    "Days before the change keep the week they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage vor der Änderung behalten ihre bisherige Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días anteriores al cambio conservan la semana que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours antérieurs au changement gardent la semaine qu’ils avaient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani prije promjene zadržavaju tjedan koji su imali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni prima della modifica mantengono la settimana che avevano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen vóór de wijziging houden de week die ze hadden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni przed zmianą zachowują dotychczasowy tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias antes da alteração mantêm a semana que tinham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevi pred spremembo obdržijo teden, ki so ga imeli."
          }
        }
      }
    },
    "Days carried over are used first. Any not taken by the expiry date are lost. The figure belongs to this leave year, so it does not carry into the next one by itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragene Tage werden zuerst verbraucht. Was bis zum Verfallsdatum nicht genommen ist, verfällt. Die Zahl gilt für dieses Urlaubsjahr und wandert nicht von selbst ins nächste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días arrastrados se usan primero. Los que no se disfruten antes de la fecha de caducidad se pierden. La cifra es de este año de vacaciones y no pasa sola al siguiente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours reportés sont pris en premier. Ceux qui ne sont pas pris avant la date d’expiration sont perdus. Ce nombre vaut pour cette année de congés et ne passe pas tout seul à la suivante."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preneseni dani troše se prvi. Oni koji se ne iskoriste do datuma isteka propadaju. Broj vrijedi za ovu godinu odmora i ne prenosi se sam u sljedeću."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni riportati si usano per primi. Quelli non goduti entro la scadenza vanno persi. Il numero vale per questo anno di ferie e non passa da solo al successivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meegenomen dagen gaan eerst op. Wat niet vóór de vervaldatum is opgenomen, vervalt. Het getal hoort bij dit verlofjaar en gaat niet vanzelf mee naar het volgende."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeniesione dni wykorzystuje się najpierw. Te niewykorzystane do daty wygaśnięcia przepadają. Liczba dotyczy tego roku urlopowego i nie przechodzi sama na następny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias transitados são usados primeiro. Os que não forem gozados até à data de caducidade perdem-se. O número pertence a este ano de férias e não passa sozinho para o seguinte."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preneseni dnevi se porabijo najprej. Tisti, ki niso izkoriščeni do datuma zapadlosti, propadejo. Število velja za to dopustniško leto in se ne prenese samo v naslednje."
          }
        }
      }
    },
