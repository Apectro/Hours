          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures modifiées après la signature du %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati promijenjeni nakon potpisa %@"
          }
        },
        "it": {
