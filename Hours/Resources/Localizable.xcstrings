    "Takes the start, end, break and work days from Settings › Working hours again.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übernimmt Beginn, Ende, Pause und Arbeitstage wieder aus Einstellungen › Arbeitszeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a tomar el inicio, el fin, el descanso y los días de trabajo de Ajustes › Horario laboral."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reprend le début, la fin, la pause et les jours de travail depuis Réglages › Heures de travail."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno uzima početak, kraj, pauzu i radne dane iz Postavke › Radno vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riprende inizio, fine, pausa e giorni di lavoro da Impostazioni › Orario di lavoro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neemt begin, einde, pauze en werkdagen weer over uit Instellingen › Werktijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znów bierze początek, koniec, przerwę i dni pracy z Ustawienia › Godziny pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Volta a usar o início, o fim, a pausa e os dias de trabalho de Definições › Horário de trabalho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova vzame začetek, konec, odmor in delovne dni iz Nastavitve › Delovni čas."
          }
        }
      }
    },
    "Tap a day to see it below. Tap it again to write your hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Tag, um ihn unten zu sehen. Tippe noch einmal, um deine Stunden einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un día para verlo abajo. Tócalo otra vez para anotar tus horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un jour pour le voir en dessous. Touchez-le à nouveau pour saisir vos heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni dan da ga vidiš ispod. Dodirni ga opet da upišeš sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un giorno per vederlo sotto. Toccalo di nuovo per scrivere le ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een dag om hem hieronder te zien. Tik nog eens om je uren in te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dzień, żeby zobaczyć go poniżej. Stuknij jeszcze raz, żeby wpisać godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num dia para o veres em baixo. Toca outra vez para registar as horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni dan, da ga vidiš spodaj. Tapni ga še enkrat, da vpišeš ure."
          }
        }
      }
    },
    "Tap to confirm. Touch and hold for other reasons.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippen zum Bestätigen. Halten für andere Gründe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para confirmar. Mantén pulsado para otros motivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez pour confirmer. Maintenez pour d’autres motifs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni za potvrdu. Zadrži za druge razloge."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca per confermare. Tieni premuto per altri motivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik om te bevestigen. Houd vast voor andere redenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij, aby potwierdzić. Przytrzymaj, by wybrać inny powód."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca para confirmar. Mantém premido para outros motivos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni za potrditev. Pridrži za druge razloge."
          }
        }
