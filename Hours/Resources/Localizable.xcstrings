    "Same crew, times, allowance and reminders as one of your sites. You only change the name and place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gleiche Mannschaft, Zeiten, Auslöse und Erinnerungen wie eine deiner Baustellen. Du änderst nur Name und Ort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La misma cuadrilla, horario, dieta y recordatorios que una de tus obras. Solo cambias el nombre y el lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Même équipe, horaires, indemnité et rappels qu’un de vos chantiers. Vous ne changez que le nom et le lieu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ista ekipa, vremena, terenski dodatak i podsjetnici kao na jednom od tvojih gradilišta. Mijenjaš samo naziv i mjesto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stessa squadra, orari, trasferta e promemoria di uno dei tuoi cantieri. Cambi solo nome e luogo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zelfde ploeg, tijden, toelage en herinneringen als een van je bouwplaatsen. Je verandert alleen de naam en de plek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta sama ekipa, godziny, dieta i przypomnienia co na jednej z twoich budów. Zmieniasz tylko nazwę i miejsce."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A mesma equipa, horários, ajudas de custo e lembretes de uma das tuas obras. Só mudas o nome e o local."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ista ekipa, časi, terenski dodatek in opomniki kot na enem od tvojih gradbišč. Spremeniš le ime in kraj."
          }
        }
      }
    },
