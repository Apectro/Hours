    "Excel on Windows needs the byte-order mark to read accented characters correctly. Numbers, Google Sheets and LibreOffice are happy either way.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel unter Windows braucht die Byte-Order-Mark, um Zeichen mit Akzenten richtig zu lesen. Numbers, Google Sheets und LibreOffice kommen mit beidem zurecht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel en Windows necesita la marca de orden de bytes para leer bien los caracteres acentuados. Numbers, Google Sheets y LibreOffice funcionan igual con o sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel sous Windows a besoin de l’indicateur d’ordre des octets pour lire correctement les caractères accentués. Numbers, Google Sheets et LibreOffice s’accommodent des deux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel na Windowsu treba oznaku redoslijeda bajtova da ispravno čita znakove s dijakritikom. Numbers, Google Sheets i LibreOffice rade i ovako i onako."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel su Windows ha bisogno del byte order mark per leggere correttamente i caratteri accentati. Numbers, Google Fogli e LibreOffice funzionano comunque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel op Windows heeft de byte-order mark nodig om letters met accenten goed te lezen. Numbers, Google Sheets en LibreOffice werken hoe dan ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel w Windowsie potrzebuje znacznika kolejności bajtów, aby poprawnie odczytać znaki diakrytyczne. Numbers, Arkusze Google i LibreOffice działają tak czy inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Excel no Windows precisa da marca de ordem de bytes para ler corretamente os caracteres acentuados. O Numbers, o Google Sheets e o LibreOffice funcionam de qualquer forma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel v Windowsu potrebuje oznako vrstnega reda bajtov, da pravilno prebere znake z diakritiko. Numbers, Google Preglednice in LibreOffice delujejo tako ali tako."
          }
        }
      }
    },
