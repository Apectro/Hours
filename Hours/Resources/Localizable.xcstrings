    "Write one under a day's hours on the site screen.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schreib es auf dem Baustellenbildschirm unter die Stunden eines Tages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo en la pantalla de la obra, debajo de las horas de un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez-le sur l’écran du chantier, sous les heures d’un jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši ga na zaslonu gradilišta ispod sati nekog dana."
          }
        },
        "it": {
