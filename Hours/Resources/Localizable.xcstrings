    "Sync couldn't start: Zeitkonto couldn't confirm that this copy may use iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: Zeitkonto konnte nicht bestätigen, dass diese Kopie iCloud nutzen darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: Zeitkonto no pudo confirmar que esta copia pueda usar iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : Zeitkonto n'a pas pu confirmer que cette copie peut utiliser iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: Zeitkonto nije mogao potvrditi da ova kopija smije koristiti iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: Zeitkonto non ha potuto confermare che questa copia possa usare iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: Zeitkonto kon niet bevestigen dat deze kopie iCloud mag gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: Zeitkonto nie mógł potwierdzić, że ta kopia może używać iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: o Zeitkonto não conseguiu confirmar que esta cópia pode usar o iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: Zeitkonto ni mogel potrditi, da ta kopija sme uporabljati iCloud."
          }
        }
      }
    },
    "Sync couldn't start: Zeitkonto stopped while connecting to iCloud last time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: Zeitkonto wurde beim letzten Mal beim Verbinden mit iCloud beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: la última vez Zeitkonto se cerró mientras se conectaba a iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : la dernière fois, Zeitkonto s'est arrêté pendant la connexion à iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: Zeitkonto se prošli put zaustavio dok se povezivao s iCloudom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: l'ultima volta Zeitkonto si è chiuso mentre si collegava a iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: Zeitkonto stopte de vorige keer tijdens het verbinden met iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: ostatnim razem Zeitkonto zamknął się podczas łączenia z iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: da última vez, o Zeitkonto fechou enquanto se ligava ao iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: Zeitkonto se je zadnjič ustavil med povezovanjem z iCloudom."
          }
        }
      }
    },
    "Sync couldn't start: iCloud wouldn't open the data on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: iCloud wollte die Daten auf diesem Gerät nicht öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: iCloud no quiso abrir los datos de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : iCloud n'a pas voulu ouvrir les données de cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: iCloud nije htio otvoriti podatke na ovom uređaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: iCloud non ha aperto i dati su questo dispositivo."
          }
        },
