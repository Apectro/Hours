    "Usually a day off, but not a public holiday by law": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Meist frei, aber kein gesetzlicher Feiertag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suele ser libre, pero no es festivo por ley"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Généralement chômé, mais pas un jour férié légal"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obično slobodan dan, ali nije zakonski blagdan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di solito libero, ma non è una festività per legge"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Meestal vrij, maar wettelijk geen feestdag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykle wolne, ale nie jest to święto ustawowe"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Normalmente livre, mas não é feriado por lei"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Običajno prost dan, a ni zakonski praznik"
          }
        }
      }
    },
