    "Clocked out. That shift had been running over a day, so %@ was capped — worth checking.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgestempelt. Diese Schicht lief über einen Tag, daher wurde %@ gekappt — bitte prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fichaje de salida. Ese turno llevaba más de un día, así que %@ se limitó — conviene revisarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pointage de sortie. Ce poste tournait depuis plus d'un jour, donc %@ a été plafonné — à vérifier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava. Ta je smjena trajala dulje od jednog dana, pa je %@ ograničen — provjerite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uscita registrata. Quel turno durava da oltre un giorno, quindi %@ è stato limitato — da controllare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgeklokt. Die dienst liep al meer dan een dag, dus %@ is afgetopt — even nakijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zakończono. Ta zmiana trwała ponad dobę, więc %@ ograniczono — warto sprawdzić."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Saída registada. Esse turno durava há mais de um dia, por isso %@ foi limitado — vale a pena verificar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjava. Ta izmena je trajala več kot dan, zato je bil %@ omejen — preverite."
          }
        }
      }
    },
