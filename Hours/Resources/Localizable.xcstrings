    "Close a month once its hours are handed over, so it can't change by mistake.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schließe einen Monat ab, sobald seine Stunden abgegeben sind, damit er sich nicht aus Versehen ändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra un mes cuando hayas entregado sus horas, para que no cambie por error."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturez un mois une fois ses heures remises, pour qu’il ne change pas par erreur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvori mjesec kad predaš njegove sate, da se ne promijeni slučajno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudi un mese quando ne hai consegnato le ore, così non cambia per sbaglio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sluit een maand af zodra de uren zijn ingeleverd, zodat hij niet per ongeluk verandert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknij miesiąc po oddaniu godzin, aby nie zmienił się przez pomyłkę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fecha um mês depois de entregares as horas, para que não mude por engano."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaključi mesec, ko oddaš njegove ure, da se ne spremeni pomotoma."
