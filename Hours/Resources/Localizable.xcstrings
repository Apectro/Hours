    "Written on the site's day, so it is changed there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird am Tag der Baustelle eingetragen und deshalb dort geändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se anota en el día de la obra, así que se cambia allí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisi sur la journée du chantier, donc modifiable là-bas."
          }
        },
