          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Zawsze tak było” zmienia zamknięte miesiące: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Sempre foi assim» altera meses fechados: %@."
          }
        },
        "sl": {
          "stringUnit": {
