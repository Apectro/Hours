    "Checked for %@. Paid days off: your contracted hours are credited. Each one can be edited, switched off or deleted later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geprüft für %@. Bezahlte freie Tage: Deine Sollstunden werden angerechnet. Jeder lässt sich später bearbeiten, ausschalten oder löschen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisado para %@. Días libres pagados: se acreditan tus horas de contrato. Cada uno se puede editar, desactivar o eliminar después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifié pour %@. Jours de repos payés : vos heures contractuelles sont créditées. Chacun peut être modifié, désactivé ou supprimé plus tard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjereno za %@. Plaćeni slobodni dani: priznaju se tvoji ugovoreni sati. Svaki se kasnije može urediti, isključiti ili izbrisati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificato per il %@. Giorni liberi retribuiti: le tue ore contrattuali vengono accreditate. Ognuno si può modificare, disattivare o eliminare in seguito."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gecontroleerd voor %@. Betaalde vrije dagen: je contracturen worden toegekend. Elke dag kun je later bewerken, uitzetten of verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdzone dla %@. Płatne dni wolne: zaliczane są twoje godziny z umowy. Każdy można później edytować, wyłączyć lub usunąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificado para %@. Dias de folga pagos: as tuas horas contratuais são creditadas. Cada um pode ser editado, desativado ou apagado mais tarde."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Preverjeno za %@. Plačani prosti dnevi: priznajo se tvoje pogodbene ure. Vsakega lahko pozneje urediš, izklopiš ali izbrišeš."
          }
        }
      }
    },
