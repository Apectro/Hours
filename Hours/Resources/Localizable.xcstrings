    "Every hour pays the same.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stunde wird gleich bezahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las horas se pagan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure est payée pareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki sat plaća se jednako."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ora è pagata allo stesso modo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk uur wordt hetzelfde betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda godzina płatna jest tak samo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as horas são pagas da mesma forma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka ura se plača enako."
          }
        }
      }
    },
    "Everyone else keeps the site times: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen behalten die Baustellenzeiten: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás mantienen el horario de la obra: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres gardent les horaires du chantier : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi ostali zadržavaju vrijeme gradilišta: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli altri mantengono gli orari del cantiere: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen houden de tijden van de bouwplaats: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostali zachowują godziny budowy: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os restantes mantêm o horário da obra: %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi drugi obdržijo čas gradbišča: %@."
          }
        }
      }
    },
    "Everyone on this day stops at this time. Anyone who had already left keeps the time they left.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle an diesem Tag hören zu dieser Zeit auf. Wer schon gegangen war, behält seine eigene Uhrzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese día todos paran a esta hora. Quien ya se había ido conserva su hora de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jour-là, tout le monde s’arrête à cette heure. Les personnes déjà parties gardent leur heure de départ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi tog dana završavaju u ovo vrijeme. Tko je već otišao, zadržava svoje vrijeme odlaska."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel giorno tutti smettono a quest’ora. Chi era già andato via mantiene il suo orario di uscita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen stopt die dag op dit tijdstip. Wie al weg was, houdt zijn eigen vertrektijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia wszyscy kończą o tej godzinie. Kto już wyszedł, zachowuje swoją godzinę wyjścia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesse dia todos param a esta hora. Quem já tinha saído mantém a sua hora de saída."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi ta dan končajo ob tej uri. Kdor je že odšel, obdrži svojo uro odhoda."
          }
        }
      }
    },
    "Everyone ticked gets the allowance": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Angehakten bekommen die Auslöse"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los marcados reciben la dieta"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes cochées reçoivent l’indemnité"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi označeni dobivaju terenski dodatak"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli spuntati ricevono la trasferta"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die is aangevinkt krijgt de toelage"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy zaznaczeni dostają dietę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os marcados recebem ajudas de custo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi označeni dobijo terenski dodatek"
          }
        }
      }
    },
    "Everyone ticked in on a new day gets the field allowance. It can be taken off one person on the day. Days already written stay as they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die an einem neuen Tag abgehakt werden, bekommen die Auslöse. Am Tag kann sie einzelnen Personen abgenommen werden. Bereits erfasste Tage bleiben, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los marcados en un día nuevo reciben la dieta. Ese día se le puede quitar a una persona. Los días ya escritos se quedan como están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes cochées un nouveau jour reçoivent l’indemnité. Vous pouvez la retirer à une personne ce jour-là. Les jours déjà saisis restent tels quels."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi označeni na novom danu dobivaju terenski dodatak. Na danu ga se može maknuti pojedinoj osobi. Već upisani dani ostaju kakvi jesu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chi viene spuntato in un nuovo giorno riceve la trasferta. Nel giorno si può togliere a una singola persona. I giorni già scritti restano come sono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die op een nieuwe dag wordt aangevinkt, krijgt de toelage. Op de dag kun je die bij één persoon weghalen. Dagen die al zijn ingevuld blijven zoals ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy zaznaczony w nowym dniu dostaje dietę. W danym dniu można ją odebrać jednej osobie. Dni już zapisane zostają bez zmian."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os marcados num dia novo recebem as ajudas de custo. Nesse dia podem ser retiradas a uma pessoa. Os dias já escritos ficam como estão."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi, označeni na novem dnevu, dobijo terenski dodatek. Na dnevu ga lahko odvzameš posamezniku. Že vpisani dnevi ostanejo, kot so."
          }
        }
      }
    },
    "Everyone ticked on this day gets these times, except people whose own times you changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die an diesem Tag abgehakt sind, bekommen diese Zeiten – außer denen, deren eigene Zeiten du geändert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los marcados este día reciben este horario, salvo quienes tienen un horario propio que cambiaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes cochées ce jour-là reçoivent ces horaires, sauf celles dont vous avez modifié les horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi označeni na ovaj dan dobivaju ova vremena, osim onih kojima si promijenio vlastito vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli spuntati in questo giorno ricevono questi orari, tranne chi ha orari propri che hai cambiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die op deze dag is aangevinkt krijgt deze tijden, behalve wie je eigen tijden hebt gegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy zaznaczeni tego dnia dostają te godziny, oprócz osób, którym zmieniłeś własne godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os marcados neste dia ficam com este horário, exceto quem tem um horário próprio que alteraste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi, označeni na ta dan, dobijo te čase, razen tistih, ki si jim spremenil lastni čas."
          }
        }
      }
    },
    "Everything recorded through %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles erfasst bis %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo registrado hasta el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est enregistré jusqu'au %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve evidentirano do %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è registrato fino al %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles vastgelegd tot en met %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zapisane do %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está registado até %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse zabeleženo do %@."
          }
        }
      }
    },
    "Everything stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
