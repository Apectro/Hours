    "Tick the people who come along. Anyone else can be added from the site's crew later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hake die Leute an, die mitkommen. Alle anderen kannst du später in der Mannschaft der Baustelle hinzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca a las personas que vienen contigo. A los demás puedes añadirlos más tarde desde la cuadrilla de la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cochez les personnes qui viennent avec vous. Les autres pourront être ajoutées plus tard depuis l’équipe du chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi ljude koji dolaze s tobom. Ostale možeš dodati kasnije u ekipi gradilišta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta le persone che vengono con te. Gli altri si possono aggiungere più tardi dalla squadra del cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vink de mensen aan die meegaan. Anderen kun je later toevoegen bij de ploeg van de bouwplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz osoby, które idą z tobą. Pozostałych możesz dodać później w ekipie budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca as pessoas que vêm contigo. As outras podem ser adicionadas mais tarde na equipa da obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Označi ljudi, ki pridejo s tabo. Ostale lahko dodaš pozneje v ekipi gradbišča."
          }
        }
      }
    },
