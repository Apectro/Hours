    "Hand the phone to each person. They check their own days and sign with a finger. A signature is printed on the director's sheet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib das Handy jeder Person. Sie prüft ihre eigenen Tage und unterschreibt mit dem Finger. Die Unterschrift wird auf die Stundenliste für die Bauleitung gedruckt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasa el teléfono a cada persona. Revisa sus propios días y firma con el dedo. La firma se imprime en la hoja para el director."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Passez le téléphone à chaque personne. Elle vérifie ses propres jours et signe du doigt. La signature est imprimée sur la feuille pour le directeur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj telefon svakoj osobi. Ona provjeri svoje dane i potpiše se prstom. Potpis se ispisuje na listi za voditelja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa il telefono a ogni persona. Controlla i propri giorni e firma con un dito. La firma viene stampata sul foglio per il direttore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geef de telefoon aan iedereen. Ieder controleert de eigen dagen en tekent met een vinger. De handtekening komt op de lijst voor de uitvoerder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj telefon każdej osobie. Sprawdza swoje dni i podpisuje się palcem. Podpis zostaje wydrukowany na arkuszu dla kierownika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Passa o telemóvel a cada pessoa. Verifica os seus próprios dias e assina com o dedo. A assinatura é impressa na folha para o diretor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Daj telefon vsaki osebi. Preveri svoje dneve in se podpiše s prstom. Podpis se natisne na seznam za vodjo."
          }
        }
      }
    },
