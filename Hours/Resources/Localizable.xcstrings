    },
    "What your contract gives each leave year. Half days are fine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dein Vertrag pro Urlaubsjahr vorsieht. Halbe Tage gehen auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te da tu contrato cada año de vacaciones. Se admiten medios días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que votre contrat vous accorde par année de congés. Les demi-journées sont possibles."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ti ugovor daje svake godine odmora. Može i pola dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti spetta per contratto ogni anno di ferie. Vanno bene anche le mezze giornate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je contract per verlofjaar geeft. Halve dagen kunnen ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile daje ci umowa w każdym roku urlopowym. Można też pół dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o teu contrato dá em cada ano de férias. Meios dias também servem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ti pogodba da vsako dopustniško leto. Tudi pol dneva gre."
          }
        }
      }
    },
