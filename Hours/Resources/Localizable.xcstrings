    "It goes on the sheets you hand in. Nothing else uses it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er steht auf den Listen, die du abgibst. Sonst wird er nirgends verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece en las hojas que entregas. No se usa para nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il figure sur les feuilles que vous remettez. Rien d’autre ne l’utilise."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoji na listama koje predaješ. Ništa ga drugo ne koristi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare sui fogli che consegni. Non viene usato per altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hij staat op de lijsten die je inlevert. Verder wordt hij nergens gebruikt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pojawia się na arkuszach, które oddajesz. Nic innego z niego nie korzysta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparece nas folhas que entregas. Não é usado para mais nada."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Piše na seznamih, ki jih oddaš. Nič drugega ga ne uporablja."
          }
        }
      }
    },
    "It was always like this": {
