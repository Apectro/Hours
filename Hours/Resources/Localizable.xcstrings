          }
        }
      }
    },
    "Pick your country and they show in the calendar as paid days off. On one you worked, tap I worked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl dein Land, dann erscheinen sie im Kalender als bezahlte freie Tage. Hast du an einem gearbeitet, tipp auf Ich habe gearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu país y aparecen en el calendario como días libres pagados. Si trabajaste uno, toca Trabajé."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre pays et ils apparaissent dans le calendrier comme jours de repos payés. Si vous en avez travaillé un, touchez J’ai travaillé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi zemlju i prikazat će se u kalendaru kao plaćeni slobodni dani. Ako si na neki radio, dodirni Radio sam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il paese e compaiono nel calendario come giorni liberi retribuiti. Se ne hai lavorato uno, tocca Ho lavorato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je land en ze verschijnen in de kalender als betaalde vrije dagen. Heb je er een gewerkt, tik dan op Ik heb gewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kraj, a pojawią się w kalendarzu jako płatne dni wolne. Jeśli w któryś pracowałeś, stuknij Pracowałem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o país e aparecem no calendário como dias de folga pagos. Se trabalhaste num, toca em Trabalhei."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi državo in v koledarju bodo prikazani kot plačani prosti dnevi. Če si na katerega delal, tapni Delal sem."
          }
        }
      }
    },
    "Pick your country, and your state or canton where it matters. You see the list before anything is added.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähl dein Land und, wo es darauf ankommt, dein Bundesland oder deinen Kanton. Du siehst die Liste, bevor etwas hinzugefügt wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige tu país y, donde importe, tu estado federado o cantón. Ves la lista antes de que se añada nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez votre pays et, si cela compte, votre Land ou votre canton. Vous voyez la liste avant que quoi que ce soit soit ajouté."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberi svoju zemlju i, gdje je važno, saveznu zemlju ili kanton. Popis vidiš prije nego što se išta doda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli il tuo paese e, dove conta, il land o il cantone. Vedi l'elenco prima che venga aggiunto qualcosa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies je land en, waar het uitmaakt, je deelstaat of kanton. Je ziet de lijst voordat er iets wordt toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz kraj oraz, tam gdzie to ważne, land lub kanton. Zobaczysz listę, zanim cokolwiek zostanie dodane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolhe o teu país e, onde importar, o estado ou cantão. Vês a lista antes de ser adicionado o que quer que seja."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izberi svojo državo in, kjer je pomembno, zvezno deželo ali kanton. Seznam vidiš, preden se kar koli doda."
          }
        }
      }
    },
    "Place": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lieu"
          }
