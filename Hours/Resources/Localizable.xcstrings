    "Removes this job's rate and every change to it. Your hours are not touched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt den Stundenlohn dieser Tätigkeit und alle Änderungen daran. Deine Stunden bleiben, wie sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita la tarifa por hora de este trabajo y todos sus cambios. Tus horas no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime le taux horaire de ce poste et toutes ses modifications. Vos heures ne sont pas touchées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja satnicu ovog posla i sve njezine promjene. Tvoji sati ostaju netaknuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove la tariffa oraria di questo lavoro e ogni sua modifica. Le tue ore restano intatte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert het uurloon van deze functie en elke wijziging ervan. Je uren blijven onaangeroerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa stawkę godzinową tej pracy i wszystkie jej zmiany. Twoje godziny pozostają nietknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove o valor por hora deste trabalho e todas as suas alterações. As tuas horas não são tocadas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrani urno postavko tega dela in vse njene spremembe. Tvoje ure ostanejo nedotaknjene."
          }
        }
      }
    },
