    "Sync couldn't start: Zeitkonto couldn't confirm that this copy may use iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: Zeitkonto konnte nicht bestätigen, dass diese Kopie iCloud nutzen darf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: Zeitkonto no pudo confirmar que esta copia pueda usar iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : Zeitkonto n'a pas pu confirmer que cette copie peut utiliser iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: Zeitkonto nije mogao potvrditi da ova kopija smije koristiti iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: Zeitkonto non ha potuto confermare che questa copia possa usare iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: Zeitkonto kon niet bevestigen dat deze kopie iCloud mag gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: Zeitkonto nie mógł potwierdzić, że ta kopia może używać iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: o Zeitkonto não conseguiu confirmar que esta cópia pode usar o iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: Zeitkonto ni mogel potrditi, da ta kopija sme uporabljati iCloud."
          }
        }
      }
    },
    "Sync couldn't start: Zeitkonto stopped while connecting to iCloud last time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: Zeitkonto wurde beim letzten Mal beim Verbinden mit iCloud beendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: la última vez Zeitkonto se cerró mientras se conectaba a iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : la dernière fois, Zeitkonto s'est arrêté pendant la connexion à iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: Zeitkonto se prošli put zaustavio dok se povezivao s iCloudom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: l'ultima volta Zeitkonto si è chiuso mentre si collegava a iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: Zeitkonto stopte de vorige keer tijdens het verbinden met iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: ostatnim razem Zeitkonto zamknął się podczas łączenia z iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: da última vez, o Zeitkonto fechou enquanto se ligava ao iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: Zeitkonto se je zadnjič ustavil med povezovanjem z iCloudom."
          }
        }
      }
    },
    "Sync couldn't start: iCloud wouldn't open the data on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: iCloud wollte die Daten auf diesem Gerät nicht öffnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: iCloud no quiso abrir los datos de este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : iCloud n'a pas voulu ouvrir les données de cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: iCloud nije htio otvoriti podatke na ovom uređaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: iCloud non ha aperto i dati su questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: iCloud wilde de gegevens op dit apparaat niet openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: iCloud nie chciał otworzyć danych na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: o iCloud não quis abrir os dados deste dispositivo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: iCloud ni hotel odpreti podatkov v tej napravi."
          }
        }
      }
    },
    "Sync couldn't start: this copy of Zeitkonto isn't signed for iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync konnte nicht starten: Diese Kopie von Zeitkonto ist nicht für iCloud signiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización: esta copia de Zeitkonto no está firmada para iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'a pas pu démarrer : cette copie de Zeitkonto n'est pas signée pour iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija se nije mogla pokrenuti: ova kopija Zeitkonta nije potpisana za iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile avviare la sincronizzazione: questa copia di Zeitkonto non è firmata per iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie kon niet starten: deze kopie van Zeitkonto is niet ondertekend voor iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji: ta kopia Zeitkonto nie jest podpisana do iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização: esta cópia do Zeitkonto não está assinada para o iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije ni bilo mogoče zagnati: ta kopija Zeitkonta ni podpisana za iCloud."
          }
        }
      }
    },
    "Sync has been switched off, and everything is still saved on this device. Turn it on again to try once more.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync wurde ausgeschaltet, und alles ist weiter auf diesem Gerät gespeichert. Schalte es wieder ein, um es noch einmal zu versuchen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización se ha desactivado y todo sigue guardado en este dispositivo. Vuelve a activarla para intentarlo otra vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation a été désactivée, et tout reste enregistré sur cet appareil. Réactivez-la pour réessayer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija je isključena, a sve je i dalje spremljeno na ovom uređaju. Ponovno je uključi da pokušaš još jednom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione è stata disattivata e tutto resta salvato su questo dispositivo. Riattivala per riprovare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is uitgezet en alles staat nog op dit apparaat. Zet het weer aan om het opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja została wyłączona, a wszystko nadal jest zapisane na tym urządzeniu. Włącz ją ponownie, aby spróbować jeszcze raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização foi desligada e tudo continua guardado neste dispositivo. Volta a ligá-la para tentares outra vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija je izklopljena, vse pa je še vedno shranjeno v tej napravi. Znova jo vklopi, da poskusiš še enkrat."
          }
        }
      }
    },
    "Sync is not a backup: a day you delete is deleted on every device. A backup file is the copy that survives that. Settings › Backup and data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync ist keine Sicherung: Ein Tag, den du löschst, ist auf jedem Gerät gelöscht. Eine Sicherungsdatei ist die Kopie, die das übersteht. Einstellungen › Sicherung und Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización no es una copia de seguridad: un día que borras se borra en todos los dispositivos. Un archivo de copia es lo que sobrevive a eso. Ajustes › Copia de seguridad y datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation n'est pas une sauvegarde : un jour que vous supprimez l'est sur tous les appareils. Un fichier de sauvegarde est la copie qui y survit. Réglages › Sauvegarde et données."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija nije sigurnosna kopija: dan koji obrišeš briše se na svakom uređaju. Datoteka sigurnosne kopije je kopija koja to preživi. Postavke › Sigurnosna kopija i podaci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione non è un backup: un giorno che elimini viene eliminato su ogni dispositivo. Un file di backup è la copia che sopravvive. Impostazioni › Backup e dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie is geen back-up: een dag die je verwijdert, is op elk apparaat verwijderd. Een back-upbestand is de kopie die dat overleeft. Instellingen › Back-up en gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja to nie kopia zapasowa: dzień, który usuniesz, znika na każdym urządzeniu. Plik kopii zapasowej to kopia, która to przetrwa. Ustawienia › Kopia zapasowa i dane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização não é uma cópia de segurança: um dia que apagas é apagado em todos os dispositivos. Um ficheiro de cópia é o que sobrevive a isso. Definições › Cópia de segurança e dados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija ni varnostna kopija: dan, ki ga izbrišeš, je izbrisan na vsaki napravi. Datoteka varnostne kopije je kopija, ki to preživi. Nastavitve › Varnostna kopija in podatki."
          }
        }
      }
    },
    "Sync starts the next time you open Zeitkonto.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sync startet beim nächsten Öffnen von Zeitkonto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización empieza la próxima vez que abras Zeitkonto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation démarre la prochaine fois que vous ouvrez Zeitkonto."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija počinje sljedeći put kad otvoriš Zeitkonto."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione parte la prossima volta che apri Zeitkonto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronisatie start de volgende keer dat je Zeitkonto opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja ruszy przy następnym otwarciu Zeitkonto."
          }
        },
