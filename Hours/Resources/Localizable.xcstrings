    "Check it once, then it's ready.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal prüfen, dann ist sie fertig."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revísalo una vez y estará lista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez une fois, et c’est prêt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Provjeri jednom i spremno je."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlla una volta ed è pronto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer nakijken, dan is het klaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź raz i gotowe."
          }
        },
        "pt": {
