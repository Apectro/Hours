    "For your country's public holidays, so they show in the calendar as paid days off. Skip it to add holidays yourself later.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für die gesetzlichen Feiertage deines Landes, damit sie im Kalender als bezahlte freie Tage erscheinen. Überspring es, um Feiertage später selbst einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para los festivos de tu país, así aparecen en el calendario como días libres pagados. Sáltalo para añadirlos tú más tarde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour les jours fériés de votre pays, afin qu’ils apparaissent dans le calendrier comme jours de repos payés. Passez cette étape pour les ajouter vous-même plus tard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za državne blagdane tvoje zemlje, da se u kalendaru prikažu kao plaćeni slobodni dani. Preskoči ako ih želiš kasnije dodati sam."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per le festività del tuo paese, così compaiono nel calendario come giorni liberi retribuiti. Salta per aggiungerle tu più avanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor de feestdagen van je land, zodat ze in de kalender als betaalde vrije dagen verschijnen. Sla over om ze later zelf toe te voegen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla świąt państwowych twojego kraju, żeby w kalendarzu były płatnymi dniami wolnymi. Pomiń, aby dodać je później samodzielnie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Para os feriados do teu país, para aparecerem no calendário como dias de folga pagos. Salta para os adicionares tu mais tarde."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za državne praznike tvoje države, da so v koledarju prikazani kot plačani prosti dnevi. Preskoči, če jih želiš pozneje dodati sam."
          }
        }
      }
    },
