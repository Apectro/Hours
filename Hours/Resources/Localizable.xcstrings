    "Starts the clock, or stops it and records the hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Uhr oder stoppt sie und erfasst die Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia el fichaje, o lo detiene y registra las horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre le pointage, ou l’arrête et enregistre les heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće sat ili ga zaustavlja i bilježi sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la timbratura oppure la ferma e registra le ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de klok, of stopt hem en legt de uren vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia zegar albo go zatrzymuje i zapisuje godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o registo, ou para-o e regista as horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zažene uro ali jo ustavi in zabeleži ure."
