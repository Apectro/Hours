            "value": "Seulement dans une partie de la région"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo u dijelu regije"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo in parte della regione"
          }
        },
        "nl": {
          "stringUnit": {
