    "Fills each day with your usual start, end and break. Public holidays in the range are left alone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt jeden Tag mit deinem üblichen Beginn, Ende und deiner Pause. Feiertage im Zeitraum bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena cada día con tu inicio, fin y descanso habituales. Los festivos del intervalo no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit chaque jour avec vos début, fin et pause habituels. Les jours fériés de la plage ne sont pas touchés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popunjava svaki dan tvojim uobičajenim početkom, krajem i pauzom. Praznici u rasponu ostaju netaknuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila ogni giorno con inizio, fine e pausa abituali. Le festività nell’intervallo restano intatte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vult elke dag met je gebruikelijke begin, einde en pauze. Feestdagen in het bereik blijven ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnia każdy dzień twoim zwykłym początkiem, końcem i przerwą. Święta w zakresie pozostają nietknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche cada dia com o teu início, fim e pausa habituais. Os feriados no intervalo não são alterados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak dan zapolni s tvojim običajnim začetkom, koncem in odmorom. Prazniki v obsegu ostanejo nedotaknjeni."
          }
        }
      }
    },
