            "state": "translated",
            "value": "Schreib es auf dem Baustellenbildschirm unter die Stunden eines Tages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escríbelo en la pantalla de la obra, debajo de las horas de un día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rédigez-le sur l’écran du chantier, sous les heures d’un jour."
          }
        },
        "hr": {
