            "state": "translated",
            "value": "Zie wat je uren opleveren, overuren en toeslagen inbegrepen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobacz, ile przynoszą twoje godziny, z nadgodzinami i dodatkami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Vê quanto rendem as tuas horas, com horas extra e acréscimos incluídos."
