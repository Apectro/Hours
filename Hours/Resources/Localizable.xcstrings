    "On another site": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf einer anderen Baustelle"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En otra obra"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sur un autre chantier"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na drugom gradilištu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In un altro cantiere"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op een andere bouwplaats"
          }
        },
        "pl": {
          "stringUnit": {
