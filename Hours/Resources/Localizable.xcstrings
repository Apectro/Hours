      }
    },
    "Overtime is switched off in Zeitkonto, so there is no balance to show.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden sind in Zeitkonto ausgeschaltet, deshalb gibt es kein Saldo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra están desactivadas en Zeitkonto, así que no hay saldo que mostrar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures supplémentaires sont désactivées dans Zeitkonto : il n’y a pas de solde à afficher."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni su isključeni u Zeitkontu, pa nema salda za prikaz."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli straordinari sono disattivati in Zeitkonto, quindi non c’è un saldo da mostrare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overuren staan uit in Zeitkonto, dus er is geen saldo om te tonen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny są wyłączone w Zeitkonto, więc nie ma salda do pokazania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas extra estão desligadas no Zeitkonto, por isso não há saldo para mostrar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure so v Zeitkontu izklopljene, zato ni salda za prikaz."
          }
        }
      }
    },
    "Overtime needs expected hours to measure against, so it follows that setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden brauchen Sollstunden als Maßstab, also folgen sie dieser Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra necesitan horas previstas con las que medirse, así que siguen ese ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures supplémentaires ont besoin d’heures prévues comme référence : elles suivent donc ce réglage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni trebaju planirane sate kao mjerilo pa slijede tu postavku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli straordinari hanno bisogno di ore previste come riferimento, quindi seguono quell’impostazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overuren hebben verwachte uren nodig als maatstaf, dus ze volgen die instelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny potrzebują wymaganych godzin jako punktu odniesienia, więc podążają za tym ustawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas extra precisam de horas previstas como referência, por isso seguem essa definição."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure potrebujejo predvidene ure kot merilo, zato sledijo tej nastavitvi."
          }
        }
      }
    },
