    "Files you create in Export go through the system share sheet, and you choose where they go.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dateien aus dem Export laufen über das Teilen-Menü des Systems, und du wählst, wohin sie gehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los archivos creados en Exportar pasan por el panel de compartir del sistema y tú eliges su destino."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les fichiers créés dans Exporter passent par la feuille de partage du système, et vous choisissez leur destination."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke iz izvoza idu kroz sustavni izbornik za dijeljenje, a ti biraš kamo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I file creati in Esporta passano dal pannello di condivisione di sistema e scegli tu dove vanno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bestanden uit Exporteer gaan via het deelvenster van het systeem, en jij kiest waar ze heen gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pliki utworzone w Eksporcie przechodzą przez systemowe okno udostępniania, a ty wybierasz, dokąd trafiają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os ficheiros criados em Exportar passam pelo painel de partilha do sistema e escolhes tu para onde vão."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke iz izvoza gredo skozi sistemsko okno za deljenje, sam pa izbereš, kam."
          }
        }
      }
    },
    "Fill hours": {
      "extractionState": "manual",
      "localizations": {
