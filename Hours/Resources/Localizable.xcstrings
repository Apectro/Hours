            "state": "translated",
            "value": "%@ è chiuso, quindi quel turno non è stato registrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is afgesloten, dus die dienst is niet vastgelegd."
          }
        },
        "pl": {
