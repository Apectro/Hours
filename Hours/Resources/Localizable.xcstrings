          }
        }
      }
    },
    "Your hours are kept on this device and in your own private iCloud storage, which only your devices can read. %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stunden bleiben auf diesem Gerät und in Ihrem eigenen privaten iCloud-Speicher, den nur Ihre Geräte lesen können. %@ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus horas se quedan en este dispositivo y en tu propio almacenamiento privado de iCloud, que solo pueden leer tus dispositivos. %@ %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos heures restent sur cet appareil et dans votre propre stockage iCloud privé, que seuls vos appareils peuvent lire. %@ %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši sati ostaju na ovom uređaju i u vašoj privatnoj iCloud pohrani, koju mogu čitati samo vaši uređaji. %@ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue ore restano su questo dispositivo e nel tuo spazio iCloud privato, leggibile solo dai tuoi dispositivi. %@ %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je uren blijven op dit apparaat en in je eigen privé-iCloudopslag, die alleen jouw apparaten kunnen lezen. %@ %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje godziny pozostają na tym urządzeniu i w Twojej prywatnej przestrzeni iCloud, którą mogą odczytać tylko Twoje urządzenia. %@ %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas horas ficam neste dispositivo e no seu próprio armazenamento privado do iCloud, que só os seus dispositivos podem ler. %@ %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše ure ostanejo v tej napravi in v vaši zasebni shrambi iCloud, ki jo lahko berejo le vaše naprave. %@ %@"
          }
        }
      }
    },
    "Your hours are stored locally and nowhere else. %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stunden werden lokal gespeichert und sonst nirgends. %@ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus horas se guardan localmente y en ningún otro sitio. %@ %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos heures sont stockées en local et nulle part ailleurs. %@ %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši se sati pohranjuju lokalno i nigdje drugdje. %@ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue ore sono salvate solo in locale. %@ %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je uren worden lokaal opgeslagen en nergens anders. %@ %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje godziny są przechowywane lokalnie i nigdzie indziej. %@ %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas horas são guardadas localmente e em mais lado nenhum. %@ %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše ure so shranjene lokalno in nikjer drugje. %@ %@"
          }
        }
      }
    },
    "Your location couldn't be found. Try again outdoors.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort wurde nicht gefunden. Versuch es draußen noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado tu ubicación. Vuelve a intentarlo al aire libre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position est introuvable. Réessayez à l’extérieur."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lokacija nije pronađena. Pokušaj ponovno na otvorenom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile trovare la tua posizione. Riprova all’aperto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie is niet gevonden. Probeer het buiten opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się znaleźć twojej lokalizacji. Spróbuj ponownie na zewnątrz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar a tua localização. Tenta de novo ao ar livre."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoje lokacije ni bilo mogoče najti. Poskusi znova na prostem."
          }
        }
      }
    },
    "Your location never leaves your phone. Zeitkonto keeps only the site's saved place, and nothing is sent anywhere.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Standort verlässt nie dein Telefon. Zeitkonto behält nur den gespeicherten Ort der Baustelle, und nichts wird irgendwohin gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu ubicación nunca sale de tu teléfono. Zeitkonto solo guarda el lugar de la obra y no se envía nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre position ne quitte jamais votre téléphone. Zeitkonto ne garde que l’emplacement enregistré du chantier, et rien n’est envoyé nulle part."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lokacija nikad ne napušta tvoj telefon. Zeitkonto čuva samo spremljeno mjesto gradilišta i ništa se nikamo ne šalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posizione non lascia mai il tuo telefono. Zeitkonto conserva solo il luogo salvato del cantiere e nulla viene inviato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je locatie verlaat nooit je telefoon. Zeitkonto bewaart alleen de opgeslagen plek van de bouwplaats en er wordt niets verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja lokalizacja nigdy nie opuszcza twojego telefonu. Zeitkonto przechowuje tylko zapisane miejsce budowy i nic nie jest nigdzie wysyłane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua localização nunca sai do teu telefone. O Zeitkonto guarda apenas o local da obra e nada é enviado para lado nenhum."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja lokacija nikoli ne zapusti tvojega telefona. Zeitkonto hrani samo shranjeni kraj gradbišča in nič se nikamor ne pošilja."
          }
        }
      }
    },
