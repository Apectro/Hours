    "Because nothing is synced, a backup file is the only copy that survives losing the device. Settings › Backup and data.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil nichts synchronisiert wird, ist eine Sicherungsdatei die einzige Kopie, die den Verlust des Geräts übersteht. Einstellungen › Sicherung und Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como nada se sincroniza, un archivo de copia es lo único que sobrevive a perder el dispositivo. Ajustes › Copia de seguridad y datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme rien n'est synchronisé, un fichier de sauvegarde est la seule copie qui survit à la perte de l'appareil. Réglages › Sauvegarde et données."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budući da se ništa ne sinkronizira, datoteka sigurnosne kopije jedina je kopija koja preživi gubitak uređaja. Postavke › Sigurnosna kopija i podaci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché nulla viene sincronizzato, un file di backup è l'unica copia che sopravvive alla perdita del dispositivo. Impostazioni › Backup e dati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er niets wordt gesynchroniseerd, is een back-upbestand de enige kopie die het verlies van je apparaat overleeft. Instellingen › Back-up en gegevens."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponieważ nic nie jest synchronizowane, plik kopii zapasowej to jedyna kopia, która przetrwa utratę urządzenia. Ustawienia › Kopia zapasowa i dane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como nada é sincronizado, um ficheiro de cópia é a única cópia que sobrevive à perda do dispositivo. Definições › Cópia de segurança e dados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker se nič ne sinhronizira, je datoteka varnostne kopije edina kopija, ki preživi izgubo naprave. Nastavitve › Varnostna kopija in podatki."
          }
        }
      }
    },
    "Because nothing is synced, a backup file is the only copy that survives losing the device. Settings › iCloud & backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Weil nichts synchronisiert wird, ist eine Sicherungsdatei die einzige Kopie, die den Verlust des Geräts übersteht. Einstellungen › iCloud & Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como nada se sincroniza, un archivo de copia es lo único que sobrevive a perder el dispositivo. Ajustes › iCloud y copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme rien n'est synchronisé, un fichier de sauvegarde est la seule copie qui survit à la perte de l'appareil. Réglages › iCloud et sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Budući da se ništa ne sinkronizira, datoteka sigurnosne kopije jedina je kopija koja preživi gubitak uređaja. Postavke › iCloud i sigurnosna kopija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poiché nulla viene sincronizzato, un file di backup è l'unica copia che sopravvive alla perdita del dispositivo. Impostazioni › iCloud e backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Omdat er niets wordt gesynchroniseerd, is een back-upbestand de enige kopie die het verlies van je apparaat overleeft. Instellingen › iCloud en back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponieważ nic nie jest synchronizowane, plik kopii zapasowej to jedyna kopia, która przetrwa utratę urządzenia. Ustawienia › iCloud i kopia zapasowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como nada é sincronizado, um ficheiro de cópia é a única cópia que sobrevive à perda do dispositivo. Definições › iCloud e cópia de segurança."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ker se nič ne sinhronizira, je datoteka varnostne kopije edina kopija, ki preživi izgubo naprave. Nastavitve › iCloud in varnostna kopija."
          }
        }
      }
    },
