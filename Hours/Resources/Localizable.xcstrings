    "Swipe a name to rename or hide it. Nobody is ever deleted, so hours already recorded never disappear: someone hidden simply stops being offered for new days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische über einen Namen, um ihn umzubenennen oder auszublenden. Niemand wird je gelöscht, damit erfasste Stunden nie verschwinden: Wer ausgeblendet ist, wird für neue Tage einfach nicht mehr angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un nombre para cambiarlo u ocultarlo. Nunca se elimina a nadie, así que las horas ya registradas nunca desaparecen: a quien está oculto simplemente ya no se le ofrece para días nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un nom pour le renommer ou le masquer. Personne n’est jamais supprimé, donc les heures déjà enregistrées ne disparaissent jamais : une personne masquée n’est simplement plus proposée pour les nouveaux jours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci preko imena da ga preimenuješ ili sakriješ. Nitko se nikad ne briše, pa zabilježeni sati nikad ne nestaju: skrivena osoba samo se više ne nudi za nove dane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su un nome per rinominarlo o nasconderlo. Nessuno viene mai eliminato, così le ore già registrate non spariscono mai: chi è nascosto semplicemente non viene più proposto per i nuovi giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg over een naam om die te wijzigen of te verbergen. Niemand wordt ooit verwijderd, dus vastgelegde uren verdwijnen nooit: wie verborgen is, wordt gewoon niet meer aangeboden voor nieuwe dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń po imieniu, aby je zmienić lub ukryć. Nikt nigdy nie jest usuwany, więc zapisane godziny nigdy nie znikają: ukryta osoba po prostu nie jest już proponowana na nowe dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza um nome para o mudar ou ocultar. Ninguém é apagado, por isso as horas já registadas nunca desaparecem: quem está oculto deixa apenas de ser sugerido para novos dias."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj čez ime, da ga preimenuješ ali skriješ. Nihče ni nikoli izbrisan, zato zabeležene ure nikoli ne izginejo: skrita oseba se le ne ponuja več za nove dneve."
          }
        }
      }
    },
    "Swipe to remove a change. The week before it then runs on in its place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische, um eine Änderung zu entfernen. Die Woche davor gilt dann weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para quitar un cambio. La semana anterior sigue entonces en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour retirer un changement. La semaine d’avant s’applique alors à sa place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci da ukloniš promjenu. Tjedan prije nje tada vrijedi i dalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rimuovere una modifica. La settimana precedente continua allora a valere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg om een wijziging te verwijderen. De week ervoor geldt dan verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby usunąć zmianę. Tydzień sprzed niej obowiązuje wtedy dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para remover uma alteração. A semana anterior continua então em vigor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj, da odstraniš spremembo. Teden pred njo potem velja še naprej."
          }
        }
      }
    },
    "Switch these off to enter worked hours, or the balance, by hand on each day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das aus, um gearbeitete Stunden oder den Saldo an jedem Tag von Hand einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalos para introducir a mano las horas trabajadas, o el saldo, en cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez ceci pour saisir à la main les heures travaillées, ou le solde, sur chaque jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi ovo da ručno unosiš odrađene sate ili saldo za svaki dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivali per inserire a mano le ore lavorate, o il saldo, su ogni giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit uit om gewerkte uren, of het saldo, per dag met de hand in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz to, aby ręcznie wpisywać przepracowane godziny lub saldo w każdym dniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga isto para introduzires à mão as horas trabalhadas, ou o saldo, em cada dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopi to, če želiš opravljene ure ali saldo vnašati ročno za vsak dan."
          }
        }
      }
    },
