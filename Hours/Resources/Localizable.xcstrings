    "Including empty days keeps every date in the range on its own row, which is what most timesheets expect.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Leere Tage einzubeziehen hält jedes Datum im Zeitraum in einer eigenen Zeile, was die meisten Stundenzettel erwarten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir los días vacíos mantiene cada fecha del intervalo en su propia fila, que es lo que esperan casi todas las hojas de horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Inclure les jours vides conserve chaque date de la plage sur sa propre ligne, ce qu’attendent la plupart des feuilles d’heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključivanje praznih dana zadržava svaki datum u rasponu u vlastitom retku, što većina evidencija očekuje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Includere i giorni vuoti mantiene ogni data dell’intervallo su una riga propria, come si aspettano quasi tutti i fogli ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege dagen meenemen houdt elke datum in het bereik op een eigen rij, wat de meeste urenstaten verwachten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uwzględnienie pustych dni zostawia każdą datę z zakresu we własnym wierszu, czego oczekuje większość ewidencji."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Incluir os dias vazios mantém cada data do intervalo na sua própria linha, que é o que a maioria das folhas de horas espera."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vključitev praznih dni ohrani vsak datum v obsegu v svoji vrstici, kar večina evidenc pričakuje."
          }
        }
      }
    },
