    "Removes every recorded day, holiday and site from this device and, because sync is on, from your other devices too. Settings are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jeden erfassten Tag, Feiertag und jede Baustelle von diesem Gerät und, weil Sync an ist, auch von deinen anderen Geräten. Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina cada día, festivo y obra registrados de este dispositivo y, como la sincronización está activada, también de tus otros dispositivos. Los ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime chaque jour, jour férié et chantier enregistré de cet appareil et, comme la synchronisation est activée, de vos autres appareils aussi. Les réglages sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja svaki zabilježeni dan, praznik i gradilište s ovog uređaja i, jer je sinkronizacija uključena, i s tvojih drugih uređaja. Postavke ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni giorno, festività e cantiere registrati da questo dispositivo e, poiché la sincronizzazione è attiva, anche dagli altri tuoi dispositivi. Le impostazioni restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke vastgelegde dag, feestdag en bouwplaats van dit apparaat en, omdat synchronisatie aan staat, ook van je andere apparaten. Instellingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa każdy zapisany dzień, święto i budowę z tego urządzenia, a ponieważ synchronizacja jest włączona, także z twoich innych urządzeń. Ustawienia pozostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove todos os dias, feriados e obras registados deste dispositivo e, como a sincronização está ligada, também dos teus outros dispositivos. As definições são mantidas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrani vsak zabeležen dan, praznik in gradbišče iz te naprave in, ker je sinhronizacija vklopljena, tudi iz tvojih drugih naprav. Nastavitve ostanejo."
          }
        }
      }
    },
    "Removes every recorded day, holiday and site from this device. Settings are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jeden erfassten Tag, Feiertag und jede Baustelle von diesem Gerät. Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de este dispositivo cada día, festivo y obra registrados. Los ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime chaque jour, jour férié et chantier enregistré de cet appareil. Les réglages sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja svaki zabilježeni dan, praznik i gradilište s ovog uređaja. Postavke ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni giorno, festività e cantiere registrati da questo dispositivo. Le impostazioni restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke vastgelegde dag, feestdag en bouwplaats van dit apparaat. Instellingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa z tego urządzenia każdy zapisany dzień, święto i budowę. Ustawienia pozostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove deste dispositivo todos os dias, feriados e obras registados. As definições são mantidas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrani vsak zabeležen dan, praznik in gradbišče iz te naprave. Nastavitve ostanejo."
          }
