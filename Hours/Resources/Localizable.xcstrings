    "Records on your iPhone when it is in reach.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf deinem iPhone erfasst, sobald es in Reichweite ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se registra en tu iPhone cuando esté al alcance."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sera enregistré sur votre iPhone dès qu’il sera à portée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilježi se na tvom iPhoneu kad bude u dometu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene registrato sul tuo iPhone quando è a portata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt op je iPhone vastgelegd zodra die binnen bereik is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie zapisane na iPhonie, gdy będzie w zasięgu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica registado no teu iPhone quando estiver ao alcance."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zabeleži se na tvojem iPhonu, ko bo v dosegu."
          }
        }
      }
    },
    "Remembered for next time, on every site.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für das nächste Mal gemerkt, auf jeder Baustelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se recuerda para la próxima vez, en todas las obras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mémorisé pour la prochaine fois, sur chaque chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamćeno za idući put, na svakom gradilištu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricordato per la prossima volta, in ogni cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Onthouden voor de volgende keer, op elke bouwplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapamiętane na następny raz, na każdej budowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fica guardado para a próxima vez, em todas as obras."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapomnjeno za naslednjič, na vsakem gradbišču."
          }
        }
      }
    },
    "Remind me about gaps": {
