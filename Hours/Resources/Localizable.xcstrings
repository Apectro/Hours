          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«È sempre stato così» modifica mesi chiusi: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Het was altijd al zo’ wijzigt afgesloten maanden: %@."
