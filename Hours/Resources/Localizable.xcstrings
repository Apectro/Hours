    "Add the days that apply where you work. A recurring holiday only has to be entered once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage die Tage ein, die an deinem Arbeitsort gelten. Ein wiederkehrender Feiertag muss nur einmal erfasst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los días que se aplican donde trabajas. Un festivo recurrente solo hay que introducirlo una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les jours applicables là où vous travaillez. Un jour férié récurrent ne se saisit qu’une fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dane koji vrijede tamo gdje radiš. Praznik koji se ponavlja unosi se samo jednom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i giorni validi dove lavori. Una festività ricorrente va inserita una volta sola."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de dagen toe die gelden waar jij werkt. Een terugkerende feestdag hoef je maar één keer in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dni obowiązujące tam, gdzie pracujesz. Powtarzające się święto wystarczy wprowadzić raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os dias que se aplicam onde trabalhas. Um feriado recorrente só tem de ser introduzido uma vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dneve, ki veljajo tam, kjer delaš. Praznik, ki se ponavlja, je treba vnesti samo enkrat."
          }
        }
      }
    },
    "Add the site you work on, and today's crew is one tap away here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Baustelle hinzu, auf der du arbeitest – dann ist die Mannschaft von heute hier nur einen Tipp entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la obra en la que trabajas y la cuadrilla de hoy estará aquí a un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le chantier sur lequel vous travaillez, et l’équipe du jour sera ici à portée de doigt."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gradilište na kojem radiš i današnja ekipa bit će ovdje na dodir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il cantiere su cui lavori e la squadra di oggi sarà qui a portata di tocco."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de bouwplaats toe waar je werkt, dan is de ploeg van vandaag hier één tik verderop."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj budowę, na której pracujesz, a dzisiejsza ekipa będzie tu na jedno dotknięcie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a obra onde trabalhas e a equipa de hoje fica aqui a um toque."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gradbišče, na katerem delaš, in današnja ekipa bo tukaj le en dotik stran."
          }
        }
      }
    },
    "Add the site you work on, then its crew. Each day the times are entered once, for everyone who was there.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge die Baustelle hinzu, auf der du arbeitest, dann ihre Mannschaft. Jeden Tag werden die Zeiten einmal eingetragen, für alle, die da waren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade la obra en la que trabajas y luego su cuadrilla. Cada día los horarios se introducen una sola vez, para todos los que estuvieron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le chantier sur lequel vous travaillez, puis son équipe. Chaque jour, les horaires se saisissent une seule fois, pour tous ceux qui étaient là."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gradilište na kojem radiš, zatim njegovu ekipu. Svaki dan vremena se unose jednom, za sve koji su bili tamo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi il cantiere su cui lavori, poi la sua squadra. Ogni giorno gli orari si inseriscono una volta sola, per tutti quelli che c’erano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de bouwplaats toe waar je werkt, en daarna de ploeg. Elke dag worden de tijden één keer ingevoerd, voor iedereen die er was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj budowę, na której pracujesz, a potem jej ekipę. Każdego dnia godziny wpisuje się raz, dla wszystkich, którzy byli na miejscu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona a obra onde trabalhas e depois a sua equipa. Todos os dias os horários são introduzidos uma só vez, para todos os que lá estiveram."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj gradbišče, na katerem delaš, nato njegovo ekipo. Vsak dan se časi vnesejo enkrat, za vse, ki so bili tam."
          }
        }
      }
    },
    "Add your name": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen hinzufügen"
          }
        },
        "es": {
