            "state": "translated",
            "value": "Gewerkte uren deze maand, en of je voor of achter loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny przepracowane w tym miesiącu i czy jesteś do przodu, czy do tyłu."
          }
        },
        "pt": {
