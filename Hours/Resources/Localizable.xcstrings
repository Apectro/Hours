            "state": "translated",
            "value": "Puoi cambiarla più tardi in Impostazioni › Opzioni di esportazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit later wijzigen in Instellingen › Exportopties."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz go później zmienić w Ustawienia › Opcje eksportu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterá-lo mais tarde em Definições › Opções de exportação."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozneje ga lahko spremeniš v Nastavitve › Možnosti izvoza."
          }
        }
      }
    },
    "You can see, change or remove them later in Settings › Holidays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie später unter Einstellungen › Feiertage ansehen, ändern oder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes verlos, cambiarlos o quitarlos más tarde en Ajustes › Festivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez les voir, les modifier ou les retirer plus tard dans Réglages › Jours fériés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasnije ih možeš pregledati, promijeniti ili ukloniti u Postavke › Blagdani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi vederle, modificarle o rimuoverle più tardi in Impostazioni › Festività."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt ze later bekijken, wijzigen of verwijderen in Instellingen › Feestdagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz je później zobaczyć, zmienić lub usunąć w Ustawienia › Święta."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes vê-los, alterá-los ou removê-los mais tarde em Definições › Feriados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozneje jih lahko pregledaš, spremeniš ali odstraniš v Nastavitve › Prazniki."
          }
        }
      }
    },
    "You have been clocked in for %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie sind seit %@ eingestempelt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas fichado %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes pointé depuis %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeni ste %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in servizio da %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent %@ ingeklokt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zegar chodzi od %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Está com entrada registada há %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavljeni ste %@."
          }
        }
      }
    },
    "You turned sync on, so your days, holidays, sites and settings are kept in your private iCloud storage. Only your devices, signed in as you, can read it. Turn it off in Settings › iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast die Synchronisierung eingeschaltet, also liegen deine Tage, Feiertage, Baustellen und Einstellungen in deinem privaten iCloud-Speicher. Nur deine Geräte, mit deinem Konto angemeldet, können sie lesen. Ausschalten unter Einstellungen › iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has activado la sincronización, así que tus días, festivos, obras y ajustes se guardan en tu almacenamiento privado de iCloud. Solo tus dispositivos, con tu sesión iniciada, pueden leerlos. Desactívala en Ajustes › iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous avez activé la synchronisation : vos jours, jours fériés, chantiers et réglages sont conservés dans votre espace iCloud privé. Seuls vos appareils, connectés avec votre compte, peuvent les lire. Désactivez-la dans Réglages › iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uključio si sinkronizaciju pa se tvoji dani, praznici, gradilišta i postavke čuvaju u tvom privatnom iCloud prostoru. Čitati ih mogu samo tvoji uređaji prijavljeni kao ti. Isključi u Postavke › iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai attivato la sincronizzazione, quindi giorni, festività, cantieri e impostazioni sono nel tuo spazio iCloud privato. Solo i tuoi dispositivi, con il tuo account, possono leggerli. Disattivala in Impostazioni › iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je hebt synchronisatie aangezet, dus je dagen, feestdagen, bouwplaatsen en instellingen staan in je eigen iCloud-opslag. Alleen je eigen apparaten, ingelogd als jij, kunnen ze lezen. Zet het uit bij Instellingen › iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włączyłeś synchronizację, więc twoje dni, święta, budowy i ustawienia są w twoim prywatnym magazynie iCloud. Odczytać je mogą tylko twoje urządzenia zalogowane jako ty. Wyłącz w Ustawienia › iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ligaste a sincronização, por isso os teus dias, feriados, obras e definições ficam no teu armazenamento privado do iCloud. Só os teus dispositivos, com a tua sessão iniciada, os podem ler. Desliga em Definições › iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vklopil si sinhronizacijo, zato so tvoji dnevi, prazniki, gradbišča in nastavitve v tvojem zasebnem prostoru iCloud. Berejo jih lahko samo tvoje naprave, prijavljene kot ti. Izklopi v Nastavitve › iCloud."
          }
        }
      }
    },
    "You were already clocked in at %@.": {
      "extractionState": "manual",
      "localizations": {
