    "Sites are there if you ever lead a crew.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baustellen sind da, falls du einmal eine Mannschaft führst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las obras están ahí por si algún día llevas una cuadrilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chantiers sont là si un jour vous dirigez une équipe."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradilišta su tu ako ikad budeš vodio ekipu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cantieri ci sono, se un giorno guiderai una squadra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouwplaatsen zijn er als je ooit een ploeg leidt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budowy są tu, gdybyś kiedyś prowadził ekipę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As obras estão aqui se um dia liderares uma equipa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradbišča so tu, če boš kdaj vodil ekipo."
          }
        }
      }
    },
    "Sites keep your crew's hours, extra work and a site diary.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Baustellen halten die Stunden deiner Mannschaft fest, dazu Zusatzarbeiten und das Bautagebuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las obras guardan las horas de tu cuadrilla, los trabajos adicionales y un diario de obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les chantiers gardent les heures de votre équipe, les travaux supplémentaires et un journal de chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradilišta vode sate tvoje ekipe, dodatne radove i građevinski dnevnik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I cantieri tengono le ore della tua squadra, i lavori extra e il giornale dei lavori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bouwplaatsen houden de uren van je ploeg bij, het meerwerk en een bouwdagboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budowy prowadzą godziny twojej ekipy, prace dodatkowe i dziennik budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As obras guardam as horas da tua equipa, os trabalhos adicionais e um diário de obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gradbišča vodijo ure tvoje ekipe, dodatna dela in gradbeni dnevnik."
          }
        }
      }
    },
