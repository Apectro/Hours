    "You can add times to any day, holidays too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeiten lassen sich an jedem Tag eintragen, auch an Feiertagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes añadir horarios a cualquier día, también a los festivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez ajouter des horaires à n’importe quel jour, même aux jours fériés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vremena možeš upisati za svaki dan, i za blagdane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi aggiungere orari a qualsiasi giorno, anche ai festivi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt aan elke dag tijden toevoegen, ook aan feestdagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny możesz dodać do każdego dnia, także do świąt."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes adicionar horários a qualquer dia, também aos feriados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čase lahko vpišeš za vsak dan, tudi za praznike."
          }
        }
      }
    },
    "You can change it later in Settings › Export options.": {
