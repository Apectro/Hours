    "All recorded days, holidays and sites were removed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erfassten Tage, Feiertage und Baustellen wurden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado todos los días, festivos y obras registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jours, jours fériés et chantiers enregistrés ont été supprimés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi zabilježeni dani, praznici i gradilišta su uklonjeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giorni, le festività e i cantieri registrati sono stati rimossi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vastgelegde dagen, feestdagen en bouwplaatsen zijn verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisane dni, święta i budowy zostały usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias, feriados e obras registados foram removidos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi zabeleženi dnevi, prazniki in gradbišča so bili odstranjeni."
          }
        }
      }
    },
