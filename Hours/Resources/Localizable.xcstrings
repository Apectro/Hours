          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voorbeeld"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podgląd"
          }
        },
        "pt": {
