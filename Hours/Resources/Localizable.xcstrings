    "“From today” changes closed months: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Ab heute“ ändert abgeschlossene Monate: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Desde hoy» cambia meses cerrados: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« À partir d’aujourd’hui » modifie des mois clôturés : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Od danas” mijenja zatvorene mjesece: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«Da oggi» modifica mesi chiusi: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Vanaf vandaag’ wijzigt afgesloten maanden: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Od dzisiaj” zmienia zamknięte miesiące: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«A partir de hoje» altera meses fechados: %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Od danes« spremeni zaprte mesece: %@."
          }
        }
      }
    },
    "“It was always like this” changes closed months: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Das war schon immer so“ ändert abgeschlossene Monate: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Siempre fue así» cambia meses cerrados: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Ça a toujours été ainsi » modifie des mois clôturés : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Oduvijek je bilo ovako” mijenja zatvorene mjesece: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "«È sempre stato così» modifica mesi chiusi: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
