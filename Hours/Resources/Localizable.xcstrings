    "iCloud can't be reached right now. Sync carries on by itself when it can.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist gerade nicht erreichbar. Sync macht von selbst weiter, sobald es geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede acceder a iCloud. La sincronización seguirá sola en cuanto pueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est injoignable pour le moment. La synchronisation reprendra d'elle-même dès que possible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud trenutačno nije dostupan. Sinkronizacija će se sama nastaviti čim bude moguće."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è raggiungibile in questo momento. La sincronizzazione riprende da sola appena possibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is nu niet bereikbaar. De synchronisatie gaat vanzelf verder zodra het kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest teraz niedostępny. Synchronizacja wznowi się sama, gdy będzie to możliwe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não está acessível neste momento. A sincronização continua sozinha assim que puder."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud trenutno ni dosegljiv. Sinhronizacija se bo sama nadaljevala, ko bo mogoče."
          }
        }
      }
    },
    "iCloud is restricted on this device, so nothing is being synced.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt, deshalb wird nichts synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido en este dispositivo, así que no se sincroniza nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint sur cet appareil, rien n'est donc synchronisé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je na ovom uređaju ograničen pa se ništa ne sinkronizira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato su questo dispositivo, quindi non si sincronizza nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is beperkt op dit apparaat, dus er wordt niets gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony na tym urządzeniu, więc nic nie jest synchronizowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito neste dispositivo, por isso nada está a ser sincronizado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je v tej napravi omejen, zato se nič ne sinhronizira."
          }
        }
      }
    },
    "iCloud off · backup file": {
      "extractionState": "manual",
      "localizations": {
