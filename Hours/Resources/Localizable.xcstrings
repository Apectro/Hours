    "Its days can be changed again. Close it again from the calendar's ⋯ menu when you are done.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Seine Tage lassen sich wieder ändern. Schließe ihn danach über das ⋯-Menü im Kalender wieder ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sus días se pueden volver a cambiar. Cuando termines, ciérralo de nuevo desde el menú ⋯ del calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ses jours peuvent de nouveau être modifiés. Une fois terminé, clôturez-le à nouveau depuis le menu ⋯ du calendrier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovi se dani opet mogu mijenjati. Kad završiš, ponovno ga zatvori u izborniku ⋯ u kalendaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I suoi giorni si possono di nuovo modificare. Quando hai finito, richiudilo dal menu ⋯ del calendario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dagen kunnen weer worden gewijzigd. Sluit hem als je klaar bent weer af via het ⋯-menu van de kalender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego dni znów można zmieniać. Gdy skończysz, zamknij go ponownie w menu ⋯ kalendarza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os seus dias podem voltar a ser alterados. Quando terminares, fecha-o de novo no menu ⋯ do calendário."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegove dneve je spet mogoče spreminjati. Ko končaš, ga znova zaključi v meniju ⋯ v koledarju."
          }
        }
      }
    },
    "Its material, hours, photos and signature are deleted with it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
