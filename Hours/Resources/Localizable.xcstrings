            "state": "translated",
            "value": "Solo para ciertos años"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uniquement pour certaines années"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za određene godine"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo per certi anni"
          }
        },
        "nl": {
