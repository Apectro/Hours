    "What you have worked today, and whether the clock is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du heute gearbeitet hast und ob die Uhr läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que has trabajado hoy, y si el fichaje está en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez travaillé aujourd’hui, et si le pointage est en cours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrađeno danas i radi li sat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto hai lavorato oggi, e se la timbratura è in corso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je vandaag hebt gewerkt, en of de klok loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile dziś przepracowano i czy zegar działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que trabalhaste hoje, e se o registo está em curso."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes opravljeno in ali ura teče."
          }
        }
      }
    },
    "What your contract gives each leave year. Half days are fine.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dein Vertrag pro Urlaubsjahr vorsieht. Halbe Tage gehen auch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que te da tu contrato cada año de vacaciones. Se admiten medios días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que votre contrat vous accorde par année de congés. Les demi-journées sont possibles."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ti ugovor daje svake godine odmora. Može i pola dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ti spetta per contratto ogni anno di ferie. Vanno bene anche le mezze giornate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je contract per verlofjaar geeft. Halve dagen kunnen ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile daje ci umowa w każdym roku urlopowym. Można też pół dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que o teu contrato dá em cada ano de férias. Meios dias também servem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko ti pogodba da vsako dopustniško leto. Tudi pol dneva gre."
          }
        }
      }
    },
