            "value": "Das sind %@ pro Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Son %@ al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela fait %@ par jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je %@ dnevno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fanno %@ al giorno."
          }
        },
        "nl": {
          "stringUnit": {
