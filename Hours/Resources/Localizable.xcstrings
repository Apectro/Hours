    "Removes every recorded day, holiday and site from this device. Settings are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt jeden erfassten Tag, Feiertag und jede Baustelle von diesem Gerät. Einstellungen bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina de este dispositivo cada día, festivo y obra registrados. Los ajustes se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime chaque jour, jour férié et chantier enregistré de cet appareil. Les réglages sont conservés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja svaki zabilježeni dan, praznik i gradilište s ovog uređaja. Postavke ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove ogni giorno, festività e cantiere registrati da questo dispositivo. Le impostazioni restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert elke vastgelegde dag, feestdag en bouwplaats van dit apparaat. Instellingen blijven behouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa z tego urządzenia każdy zapisany dzień, święto i budowę. Ustawienia pozostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove deste dispositivo todos os dias, feriados e obras registados. As definições são mantidas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstrani vsak zabeležen dan, praznik in gradbišče iz te naprave. Nastavitve ostanejo."
          }
        }
      }
    },
    "Removes everything recorded on those days.": {
      "extractionState": "manual",
      "localizations": {
