    "%@ is closed, so that shift was not recorded.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist abgeschlossen, daher wurde diese Schicht nicht erfasst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está cerrado, así que ese turno no se registró."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est clôturé, ce poste n'a donc pas été enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je zatvoren, pa ta smjena nije zabilježena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è chiuso, quindi quel turno non è stato registrato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is afgesloten, dus die dienst is niet vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest zamknięty, więc ta zmiana nie została zapisana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está fechado, por isso esse turno não foi registado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ je zaprt, zato ta izmena ni bila zabeležena."
          }
        }
