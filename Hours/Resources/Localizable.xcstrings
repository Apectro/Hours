    "Travel time is added to the day's hours and balance.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrzeit wird zu den Stunden und zum Saldo des Tages gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de viaje se suma a las horas y al saldo del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de trajet s’ajoute aux heures et au solde de la journée."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme putovanja dodaje se satima i saldu dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di viaggio si aggiunge alle ore e al saldo del giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reistijd telt mee in de uren en het saldo van de dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas dojazdu dolicza się do godzin i salda dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de viagem soma-se às horas e ao saldo do dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas potovanja se prišteje uram in saldu dneva."
          }
        }
      }
    },
    "Travel time is recorded and shown, not added to your hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Fahrzeit wird erfasst und angezeigt, aber nicht zu deinen Stunden gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El tiempo de viaje se registra y se muestra, pero no se suma a tus horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps de trajet est enregistré et affiché, sans s’ajouter à vos heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrijeme putovanja bilježi se i prikazuje, ali se ne dodaje tvojim satima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo di viaggio viene registrato e mostrato, non aggiunto alle tue ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Reistijd wordt vastgelegd en getoond, niet bij je uren geteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czas dojazdu jest zapisywany i pokazywany, ale nie dolicza się do twoich godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O tempo de viagem é registado e mostrado, mas não se soma às tuas horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Čas potovanja se beleži in prikaže, ne prišteje pa se tvojim uram."
          }
        }
      }
    },
    "Travel time is recorded, not counted as work.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
