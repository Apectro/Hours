    "Today on your site, and who was there last time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute auf deiner Baustelle, und wer zuletzt da war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu obra, y quién estuvo la última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui sur votre chantier, et qui était là la dernière fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas na tvom gradilištu i tko je bio tamo zadnji put."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nel tuo cantiere, e chi c’era l’ultima volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je bouwplaats, en wie er de vorige keer was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś na twojej budowie i kto był tam ostatnio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na tua obra, e quem lá esteve da última vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes na tvojem gradbišču in kdo je bil tam zadnjič."
          }
        }
      }
    },
