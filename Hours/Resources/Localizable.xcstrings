    "Your break still gets written down, but it counts as worked time. Turn this on if your employer pays your breaks.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Pause wird weiterhin erfasst, zählt aber als Arbeitszeit. Schalte das ein, wenn dein Arbeitgeber deine Pausen bezahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu descanso se sigue anotando, pero cuenta como tiempo trabajado. Actívalo si tu empresa te paga los descansos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre pause reste enregistrée, mais elle compte comme temps de travail. Activez ceci si votre employeur rémunère vos pauses."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauza se i dalje bilježi, ali se računa kao radno vrijeme. Uključi ovo ako ti poslodavac plaća pauze."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La pausa viene comunque registrata, ma conta come tempo di lavoro. Attivalo se il tuo datore di lavoro ti paga le pause."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je pauze wordt nog steeds vastgelegd, maar telt als gewerkte tijd. Zet dit aan als je werkgever je pauzes betaalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przerwa nadal jest zapisywana, ale liczy się jako czas pracy. Włącz to, jeśli pracodawca płaci ci za przerwy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A tua pausa continua a ser registada, mas conta como tempo de trabalho. Ativa isto se o teu empregador te paga as pausas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmor se še vedno zabeleži, a šteje kot delovni čas. Vklopi to, če ti delodajalec plača odmore."
          }
        }
      }
    },
    "Your building sites. Tick your crew once for everyone, write extra work for your boss, keep the site diary.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Baustellen. Hak deine Mannschaft einmal für alle ab, schreib Zusatzarbeiten für den Chef auf, führ das Bautagebuch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus obras. Marca a tu cuadrilla una vez para todos, apunta los trabajos adicionales para el jefe, lleva el diario de obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos chantiers. Cochez votre équipe une fois pour tous, notez les travaux supplémentaires pour votre chef, tenez le journal de chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja gradilišta. Označi ekipu jednom za sve, upiši dodatne radove za šefa, vodi građevinski dnevnik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi cantieri. Spunta la squadra una volta per tutti, scrivi i lavori extra per il capo, tieni il giornale dei lavori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bouwplaatsen. Vink je ploeg één keer aan voor iedereen, schrijf meerwerk op voor je baas, houd het bouwdagboek bij."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje budowy. Zaznacz ekipę raz dla wszystkich, zapisz prace dodatkowe dla szefa, prowadź dziennik budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As tuas obras. Marca a equipa uma vez para todos, regista os trabalhos adicionais para o chefe, mantém o diário de obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja gradbišča. Označi ekipo enkrat za vse, vpiši dodatna dela za šefa, vodi gradbeni dnevnik."
          }
        }
      }
    },
    "Your data could not be opened, so this session is temporary. Nothing you enter now will be saved.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten konnten nicht geöffnet werden, deshalb ist diese Sitzung nur vorübergehend. Was du jetzt einträgst, wird nicht gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron abrir tus datos, así que esta sesión es temporal. Nada de lo que introduzcas ahora se guardará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données n'ont pas pu être ouvertes, cette session est donc temporaire. Rien de ce que vous saisissez maintenant ne sera enregistré."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podaci nisu se mogli otvoriti pa je ova sesija privremena. Ništa što sada uneseš neće se spremiti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aprire i tuoi dati, quindi questa sessione è temporanea. Nulla di ciò che inserisci ora verrà salvato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens konden niet worden geopend, dus deze sessie is tijdelijk. Wat je nu invoert, wordt niet bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się otworzyć twoich danych, więc ta sesja jest tymczasowa. Nic, co teraz wpiszesz, nie zostanie zapisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível abrir os teus dados, por isso esta sessão é temporária. Nada do que introduzires agora será guardado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvojih podatkov ni bilo mogoče odpreti, zato je ta seja začasna. Nič, kar zdaj vneseš, ne bo shranjeno."
          }
        }
      }
    },
    "Your data goes to your iCloud and nowhere else.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten gehen in deine iCloud und nirgendwo sonst hin."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos van a tu iCloud y a ningún otro sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données vont dans votre iCloud et nulle part ailleurs."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podaci idu u tvoj iCloud i nikamo drugamo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati vanno nel tuo iCloud e da nessun'altra parte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens gaan naar je iCloud en nergens anders heen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane trafiają do twojego iCloud i nigdzie indziej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados vão para o teu iCloud e para mais lado nenhum."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podatki gredo v tvoj iCloud in nikamor drugam."
          }
        }
      }
    },
    "Your data lives in this app's own storage and is included in an encrypted device backup if you make one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Daten liegen im eigenen Speicher dieser App und sind in einer verschlüsselten Gerätesicherung enthalten, wenn du eine machst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos están en el almacenamiento propio de esta app y se incluyen en una copia cifrada del dispositivo si haces una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos données restent dans le stockage propre à cette app et sont incluses dans une sauvegarde chiffrée de l'appareil si vous en faites une."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podaci nalaze se u vlastitoj pohrani ove aplikacije i uključeni su u šifriranu sigurnosnu kopiju uređaja ako je napraviš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano nella memoria di questa app e sono inclusi in un backup cifrato del dispositivo, se ne fai uno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je gegevens staan in de eigen opslag van deze app en zitten in een versleutelde back-up van je apparaat als je die maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane są w pamięci tej aplikacji i trafiają do zaszyfrowanej kopii zapasowej urządzenia, jeśli ją zrobisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os teus dados ficam no armazenamento próprio desta app e são incluídos numa cópia de segurança encriptada do dispositivo, se fizeres uma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoji podatki so v lastnem pomnilniku te aplikacije in so vključeni v šifrirano varnostno kopijo naprave, če jo narediš."
          }
        }
      }
    },
    "Your first entry": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein erster Eintrag"
