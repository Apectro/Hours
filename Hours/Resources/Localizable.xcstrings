    "Once a week, a note when finished extra work hasn't been sent to your boss. Tap it to open the extra-work report.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal pro Woche ein Hinweis, wenn fertige Zusatzarbeiten noch nicht an deinen Chef gesendet sind. Tippen öffnet den Zusatzarbeiten-Bericht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una vez a la semana, un aviso cuando hay trabajos adicionales terminados sin enviar a tu jefe. Tócalo para abrir el informe de trabajos adicionales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une fois par semaine, un rappel quand des travaux supplémentaires terminés n’ont pas été envoyés à votre patron. Touchez-le pour ouvrir le rapport de travaux supplémentaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednom tjedno obavijest kad završeni dodatni radovi još nisu poslani šefu. Dodir otvara izvještaj o dodatnim radovima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una volta a settimana, un avviso quando i lavori extra finiti non sono ancora stati inviati al capo. Toccalo per aprire il rapporto lavori extra."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén keer per week een melding als afgerond meerwerk nog niet naar je baas is verstuurd. Tik erop om het meerwerkrapport te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Raz w tygodniu przypomnienie, gdy ukończone prace dodatkowe nie zostały wysłane szefowi. Dotknij, aby otworzyć raport prac dodatkowych."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma vez por semana, um aviso quando há trabalhos adicionais concluídos por enviar ao chefe. Toca para abrir o relatório de trabalhos adicionais."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Enkrat na teden obvestilo, ko končana dodatna dela še niso poslana šefu. Dotik odpre poročilo o dodatnih delih."
          }
        }
      }
    },
    "One fewer: %@": {
