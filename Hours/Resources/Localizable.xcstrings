    "Off: kept for reference, not counted in any total.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus: bleibt zum Nachsehen erhalten, zählt aber in keiner Summe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado: se guarda como referencia, pero no cuenta en ningún total."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé : conservé pour mémoire, mais compté dans aucun total."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeno: dan ostaje zapisan, ali se ne računa ni u jedan zbroj."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivato: resta come riferimento, ma non conta in nessun totale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uit: blijft bewaard ter referentie, maar telt in geen enkel totaal mee."
