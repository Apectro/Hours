    "Write your hours each day, and Zeitkonto keeps your balance and makes the sheets for your boss.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag jeden Tag deine Stunden ein – Zeitkonto führt dein Saldo und macht die Listen für den Chef."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anota tus horas cada día y Zeitkonto lleva tu saldo y hace las hojas para el jefe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez vos heures chaque jour : Zeitkonto tient votre solde et prépare les feuilles pour votre chef."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši sate svaki dan, a Zeitkonto vodi tvoj saldo i radi liste za šefa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scrivi le ore ogni giorno: Zeitkonto tiene il tuo saldo e prepara i fogli per il capo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul elke dag je uren in, en Zeitkonto houdt je saldo bij en maakt de lijsten voor je baas."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisuj godziny każdego dnia, a Zeitkonto prowadzi twoje saldo i robi listy dla szefa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Regista as horas todos os dias e o Zeitkonto mantém o teu saldo e faz as folhas para o chefe."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak dan vpiši ure, Zeitkonto pa vodi tvoj saldo in pripravi liste za šefa."
          }
        }
      }
    },
