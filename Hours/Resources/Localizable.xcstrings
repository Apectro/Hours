          }
        }
      }
    },
    "iCloud sync could not be started, so this device is using its own copy. Everything you enter is still saved here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung konnte nicht starten, deshalb nutzt dieses Gerät seine eigene Kopie. Alles, was du einträgst, wird hier weiter gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización con iCloud, así que este dispositivo usa su propia copia. Todo lo que introduzcas se sigue guardando aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud n'a pas pu démarrer, cet appareil utilise donc sa propre copie. Tout ce que vous saisissez reste enregistré ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija s iCloudom nije se mogla pokrenuti pa ovaj uređaj koristi vlastitu kopiju. Sve što uneseš i dalje se sprema ovdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile avviare la sincronizzazione con iCloud, quindi questo dispositivo usa la sua copia. Tutto ciò che inserisci viene comunque salvato qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie kon niet starten, dus dit apparaat gebruikt zijn eigen kopie. Alles wat je invoert, wordt hier nog steeds bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji z iCloud, więc to urządzenie używa własnej kopii. Wszystko, co wpiszesz, nadal zapisuje się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização com o iCloud, por isso este dispositivo usa a sua própria cópia. Tudo o que introduzires continua a ser guardado aqui."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije z iCloudom ni bilo mogoče zagnati, zato ta naprava uporablja svojo kopijo. Vse, kar vneseš, se še vedno shrani tukaj."
          }
        }
      }
    },
    "iCloud syncing is off. Your data lives in this app's own storage and is included in an encrypted device backup if you make one. You can turn sync on in Settings › iCloud & backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist aus. Deine Daten liegen im eigenen Speicher dieser App und sind in einer verschlüsselten Gerätesicherung enthalten, falls du eine anlegst. Einschalten unter Einstellungen › iCloud & Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está desactivada. Tus datos están en el almacenamiento de la app y se incluyen en una copia cifrada del dispositivo, si la haces. Actívala en Ajustes › iCloud y copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est désactivée. Vos données se trouvent dans l’espace de l’app et sont incluses dans une sauvegarde chiffrée de l’appareil, si vous en faites une. Activez-la dans Réglages › iCloud et sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija s iCloudom je isključena. Tvoji podaci su u vlastitom spremniku ove aplikacije i uključeni su u šifriranu kopiju uređaja ako je napraviš. Uključi u Postavke › iCloud i sigurnosna kopija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è disattivata. I dati stanno nell’archivio dell’app e sono inclusi in un backup cifrato del dispositivo, se lo fai. Attivala in Impostazioni › iCloud e backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie staat uit. Je gegevens staan in de opslag van deze app en zitten in een versleutelde apparaatback-up als je die maakt. Zet het aan bij Instellingen › iCloud en back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja z iCloud jest wyłączona. Twoje dane są we własnym magazynie tej aplikacji i trafiają do zaszyfrowanej kopii urządzenia, jeśli ją utworzysz. Włącz w Ustawienia › iCloud i kopia zapasowa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com o iCloud está desligada. Os teus dados estão no armazenamento da app e são incluídos numa cópia encriptada do dispositivo, se fizeres uma. Liga em Definições › iCloud e cópia de segurança."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija z iCloudom je izklopljena. Tvoji podatki so v lastnem prostoru te aplikacije in so vključeni v šifrirano varnostno kopijo naprave, če jo ustvariš. Vklopi v Nastavitve › iCloud in varnostna kopija."
          }
        }
      }
    },
    "iCloud syncing is off. Your data lives in this app's own storage and is included in an encrypted device backup if you make one. You can turn sync on in Settings › iCloud.": {
      "extractionState": "manual",
      "localizations": {
