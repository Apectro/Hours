    "All recorded days and holidays were removed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erfassten Tage und Feiertage wurden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado todos los días y festivos registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jours et jours fériés enregistrés ont été supprimés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi zabilježeni dani i praznici su uklonjeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giorni e le festività registrati sono stati rimossi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vastgelegde dagen en feestdagen zijn verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisane dni i święta zostały usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias e feriados registados foram removidos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi zabeleženi dnevi in prazniki so bili odstranjeni."
          }
        }
      }
    },
    "Already recorded": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits erfasst"
          }
        },
        "es": {
