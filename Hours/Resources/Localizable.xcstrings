    "Applied to the worked total of each day, not to the times you enter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf die Tagessumme der Arbeitszeit angewendet, nicht auf die eingetragenen Zeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al total trabajado de cada día, no a los horarios que introduces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique au total travaillé de chaque jour, pas aux horaires que vous saisissez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje se na dnevni zbroj odrađenog, ne na vremena koja unosiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica al totale lavorato di ogni giorno, non agli orari che inserisci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt toegepast op het gewerkte dagtotaal, niet op de tijden die je invoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosowane do dziennej sumy przepracowanego czasu, nie do wpisywanych godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao total trabalhado de cada dia, não aos horários que introduzes."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi se za dnevno vsoto opravljenega, ne za vnesene čase."
          }
        }
      }
    },
    "Apply to ^[%lld day](inflect: true)": {
      "extractionState": "manual",
      "localizations": {
