    "Swipe for your year in numbers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch weiter für dein Jahr in Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para ver tu año en cifras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour voir votre année en chiffres."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za svoju godinu u brojkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per il tuo anno in numeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg voor je jaar in cijfers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby zobaczyć swój rok w liczbach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para ver o teu ano em números."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj za svoje leto v številkah."
          }
        }
      }
    },
    "Swipe to remove a change. The pay before it then runs on in its place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische, um eine Änderung zu entfernen. Der Lohn davor gilt dann weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para quitar un cambio. El pago anterior sigue entonces en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour retirer un changement. La rémunération d’avant s’applique alors à sa place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci da ukloniš promjenu. Plaća prije nje tada vrijedi i dalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rimuovere una modifica. La paga precedente continua allora a valere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg om een wijziging te verwijderen. Het loon ervoor geldt dan verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby usunąć zmianę. Wynagrodzenie sprzed niej obowiązuje wtedy dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para remover uma alteração. O pagamento anterior continua então em vigor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj, da odstraniš spremembo. Plačilo pred njo potem velja še naprej."
          }
        }
      }
    },
    "Swipe to remove a change. The week before it then runs on in its place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische, um eine Änderung zu entfernen. Die Woche davor gilt dann weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para quitar un cambio. La semana anterior sigue entonces en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour retirer un changement. La semaine d’avant s’applique alors à sa place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci da ukloniš promjenu. Tjedan prije nje tada vrijedi i dalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rimuovere una modifica. La settimana precedente continua allora a valere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg om een wijziging te verwijderen. De week ervoor geldt dan verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby usunąć zmianę. Tydzień sprzed niej obowiązuje wtedy dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para remover uma alteração. A semana anterior continua então em vigor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj, da odstraniš spremembo. Teden pred njo potem velja še naprej."
          }
        }
      }
    },
    "Swipe to rename or hide. Hidden people keep their hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wischen zum Umbenennen oder Ausblenden. Ausgeblendete behalten ihre Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para cambiar el nombre u ocultar. Quien está oculto conserva sus horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour renommer ou masquer. Les personnes masquées gardent leurs heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za preimenovanje ili skrivanje. Skrivene osobe zadržavaju svoje sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rinominare o nascondere. Chi è nascosto mantiene le sue ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg om te hernoemen of te verbergen. Wie verborgen is, houdt zijn uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby zmienić imię lub ukryć. Ukryte osoby zachowują swoje godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para mudar o nome ou ocultar. Quem está oculto mantém as suas horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj za preimenovanje ali skrivanje. Skrite osebe obdržijo svoje ure."
          }
        }
      }
    },
    "Switch these off to enter worked hours, or the balance, by hand on each day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das aus, um gearbeitete Stunden oder den Saldo an jedem Tag von Hand einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalos para introducir a mano las horas trabajadas, o el saldo, en cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez ceci pour saisir à la main les heures travaillées, ou le solde, sur chaque jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi ovo da ručno unosiš odrađene sate ili saldo za svaki dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivali per inserire a mano le ore lavorate, o il saldo, su ogni giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit uit om gewerkte uren, of het saldo, per dag met de hand in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz to, aby ręcznie wpisywać przepracowane godziny lub saldo w każdym dniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliga isto para introduzires à mão as horas trabalhadas, ou o saldo, em cada dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izklopi to, če želiš opravljene ure ali saldo vnašati ročno za vsak dan."
          }
        }
      }
    },
