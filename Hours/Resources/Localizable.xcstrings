    "Send your hours or a site's sheet as PDF or Excel, from the calendar's ⋯ menu or the site's. Report language: %@. Change it here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schick deine Stunden oder die Liste einer Baustelle als PDF oder Excel, über das ⋯-Menü im Kalender oder auf der Baustelle. Berichtssprache: %@. Hier änderst du sie."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Envía tus horas o la hoja de una obra en PDF o Excel, desde el menú ⋯ del calendario o de la obra. Idioma de los informes: %@. Se cambia aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyez vos heures ou la feuille d’un chantier en PDF ou Excel, depuis le menu ⋯ du calendrier ou du chantier. Langue des rapports : %@. Vous la changez ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošalji svoje sate ili listu gradilišta kao PDF ili Excel, iz izbornika ⋯ u kalendaru ili na gradilištu. Jezik izvješća: %@. Ovdje ga mijenjaš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invia le tue ore o il foglio di un cantiere come PDF o Excel, dal menu ⋯ del calendario o del cantiere. Lingua dei rapporti: %@. La cambi qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuur je uren of de lijst van een bouwplaats als pdf of Excel, via het ⋯-menu van de kalender of de bouwplaats. Taal van de rapporten: %@. Hier wijzig je die."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyślij swoje godziny albo listę budowy jako PDF lub Excel, z menu ⋯ w kalendarzu lub na budowie. Język raportów: %@. Tutaj go zmienisz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Envia as tuas horas ou a folha de uma obra em PDF ou Excel, a partir do menu ⋯ do calendário ou da obra. Idioma dos relatórios: %@. Altera-o aqui."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošlji svoje ure ali list gradbišča kot PDF ali Excel, iz menija ⋯ v koledarju ali na gradbišču. Jezik poročil: %@. Tukaj ga spremeniš."
          }
        }
      }
    },
