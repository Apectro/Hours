    "The director's sheet is part of Zeitkonto Pro. The preview is free, and every site day stays in your backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stundenliste für die Bauleitung gehört zu Zeitkonto Pro. Die Vorschau ist kostenlos, und jeder Baustellentag bleibt in deiner Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja para el director forma parte de Zeitkonto Pro. La vista previa es gratis y cada día de obra se queda en tu copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille pour le directeur fait partie de Zeitkonto Pro. L’aperçu est gratuit, et chaque journée de chantier reste dans votre sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista za voditelja dio je Zeitkonto Pro. Pregled je besplatan, a svaki dan na gradilištu ostaje u tvojoj sigurnosnoj kopiji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il foglio per il direttore fa parte di Zeitkonto Pro. L’anteprima è gratuita e ogni giornata di cantiere resta nel tuo backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst voor de uitvoerder hoort bij Zeitkonto Pro. Het voorbeeld is gratis, en elke dag op de bouwplaats blijft in je back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz dla kierownika jest częścią Zeitkonto Pro. Podgląd jest bezpłatny, a każdy dzień na budowie zostaje w twojej kopii zapasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha para o diretor faz parte do Zeitkonto Pro. A pré-visualização é grátis e cada dia de obra fica na tua cópia de segurança."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam za vodjo je del Zeitkonto Pro. Predogled je brezplačen, vsak dan na gradbišču pa ostane v tvoji varnostni kopiji."
          }
        }
      }
    },
