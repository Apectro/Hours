    "Preview: %@. Everyone on the sheet gets a file of their own.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vorschau: %@. Jede Person auf dem Blatt bekommt eine eigene Datei."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vista previa: %@. Cada persona de la hoja recibe su propio archivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aperçu : %@. Chaque personne de la feuille reçoit son propre fichier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pregled: %@. Svaka osoba s lista dobiva svoju datoteku."
          }
        },
        "it": {
