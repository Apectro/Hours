    "This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To se ne može poništiti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser anulado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti."
          }
        }
      }
    },
    "This cannot be undone. Create a backup first if you are not sure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Erstelle vorher eine Sicherung, wenn du unsicher bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Crea antes una copia si no estás seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Créez d’abord une sauvegarde en cas de doute."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To se ne može poništiti. Napravi prvo kopiju ako nisi siguran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Se hai dubbi, crea prima un backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Maak eerst een back-up als je twijfelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć. Najpierw utwórz kopię, jeśli nie masz pewności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser anulado. Cria primeiro uma cópia se não tiveres a certeza."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti. Če nisi prepričan, najprej ustvari varnostno kopijo."
          }
        }
      }
    },
    "This changes closed months: %@.": {
      "extractionState": "manual",
      "localizations": {
