    "Hiding weekends removes the Saturday and Sunday columns from the grid. The days themselves are still recorded and still counted.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wochenenden auszublenden entfernt die Spalten Samstag und Sonntag aus dem Raster. Die Tage werden weiterhin erfasst und gezählt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar los fines de semana quita las columnas de sábado y domingo de la cuadrícula. Los días se siguen registrando y contando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masquer les week-ends retire les colonnes samedi et dimanche de la grille. Les jours restent enregistrés et comptabilisés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivanje vikenda uklanja stupce subote i nedjelje iz mreže. Sami dani se i dalje bilježe i računaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nascondere i fine settimana rimuove le colonne di sabato e domenica dalla griglia. I giorni continuano a essere registrati e conteggiati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekenden verbergen haalt de kolommen zaterdag en zondag uit het raster. De dagen worden nog steeds vastgelegd en meegeteld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukrycie weekendów usuwa kolumny soboty i niedzieli z siatki. Same dni są nadal zapisywane i liczone."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ocultar os fins de semana remove as colunas de sábado e domingo da grelha. Os dias continuam a ser registados e contados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrivanje vikendov odstrani stolpca sobote in nedelje iz mreže. Dnevi se še naprej beležijo in štejejo."
          }
        }
      }
    },
