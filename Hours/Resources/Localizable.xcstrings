    "Everyone else keeps the site times: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen behalten die Baustellenzeiten: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás mantienen el horario de la obra: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres gardent les horaires du chantier : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi ostali zadržavaju vrijeme gradilišta: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli altri mantengono gli orari del cantiere: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen houden de tijden van de bouwplaats: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostali zachowują godziny budowy: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os restantes mantêm o horário da obra: %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi drugi obdržijo čas gradbišča: %@."
          }
        }
      }
    },
    "Everyone ticked on this day gets these times, except people whose own times you changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die an diesem Tag abgehakt sind, bekommen diese Zeiten – außer denen, deren eigene Zeiten du geändert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los marcados este día reciben este horario, salvo quienes tienen un horario propio que cambiaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes cochées ce jour-là reçoivent ces horaires, sauf celles dont vous avez modifié les horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi označeni na ovaj dan dobivaju ova vremena, osim onih kojima si promijenio vlastito vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli spuntati in questo giorno ricevono questi orari, tranne chi ha orari propri che hai cambiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die op deze dag is aangevinkt krijgt deze tijden, behalve wie je eigen tijden hebt gegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy zaznaczeni tego dnia dostają te godziny, oprócz osób, którym zmieniłeś własne godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os marcados neste dia ficam com este horário, exceto quem tem um horário próprio que alteraste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi, označeni na ta dan, dobijo te čase, razen tistih, ki si jim spremenil lastni čas."
          }
        }
      }
    },
    "Everything recorded through %@.": {
      "extractionState": "manual",
