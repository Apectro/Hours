    "Hours kept until the stop. Your own day counts them as worked.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stunden bis zum Abbruch bleiben. Dein eigener Tag zählt sie als gearbeitet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas hasta la parada se mantienen. Tu día las cuenta como trabajadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures jusqu’à l’arrêt sont conservées. Votre journée les compte comme travaillées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati do prekida ostaju. Tvoj dan ih računa kao odrađene."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore fino all’interruzione restano. La tua giornata le conta come lavorate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uren tot de stop blijven staan. Je eigen dag telt ze als gewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny do przerwania zostają. Twój dzień liczy je jako przepracowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas até à paragem mantêm-se. O teu dia conta-as como trabalhadas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure do prekinitve ostanejo. Tvoj dan jih šteje kot opravljene."
          }
        }
      }
    },
