    "Delete every recorded day, holiday and site?": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erfassten Tage, Feiertage und Baustellen löschen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar todos los días, festivos y obras registrados?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer tous les jours, jours fériés et chantiers enregistrés ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati sve zabilježene dane, praznike i gradilišta?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare tutti i giorni, le festività e i cantieri registrati?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vastgelegde dagen, feestdagen en bouwplaatsen wissen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć wszystkie zapisane dni, święta i budowy?"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar todos os dias, feriados e obras registados?"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišem vse zabeležene dneve, praznike in gradbišča?"
          }
        }
