    "All of this can be changed in Settings whenever you like. A short tour shows where everything is.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das alles kannst du jederzeit in den Einstellungen ändern. Eine kurze Tour zeigt, wo alles ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes cambiar todo esto en Ajustes cuando quieras. Un breve recorrido te enseña dónde está cada cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez modifier tout cela dans Réglages quand vous le souhaitez. Une courte visite vous montre où tout se trouve."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ovo možeš promijeniti u Postavkama kad god želiš. Kratki obilazak pokazuje gdje je što."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi cambiare tutto questo nelle Impostazioni quando vuoi. Un breve giro ti mostra dove si trova tutto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt dit allemaal wijzigen in Instellingen wanneer je wilt. Een korte rondleiding laat zien waar alles staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko to możesz zmienić w Ustawieniach, kiedy tylko chcesz. Krótka wycieczka pokaże, gdzie co jest."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Podes alterar tudo isto nas Definições quando quiseres. Uma visita rápida mostra onde está cada coisa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse to lahko kadar koli spremeniš v Nastavitvah. Kratek ogled pokaže, kje je kaj."
          }
        }
      }
    },
    "All recorded days, holidays and sites were removed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle erfassten Tage, Feiertage und Baustellen wurden entfernt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se han eliminado todos los días, festivos y obras registrados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les jours, jours fériés et chantiers enregistrés ont été supprimés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi zabilježeni dani, praznici i gradilišta su uklonjeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i giorni, le festività e i cantieri registrati sono stati rimossi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle vastgelegde dagen, feestdagen en bouwplaatsen zijn verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystkie zapisane dni, święta i budowy zostały usunięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os dias, feriados e obras registados foram removidos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi zabeleženi dnevi, prazniki in gradbišča so bili odstranjeni."
          }
        }
      }
    },
