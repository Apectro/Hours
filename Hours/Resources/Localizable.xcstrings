    "With a rate set, the calendar, Insights and widgets lead with earnings. Choose Hours balance to see hours instead. Sites never show money.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit Stundenlohn zeigen Kalender, Auswertung und Widgets zuerst den Verdienst. Wähle Stundensaldo, um Stunden zu sehen. Baustellen zeigen nie Geld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una tarifa, el calendario, Estadísticas y los widgets muestran primero lo ganado. Elige Saldo de horas para ver las horas. Las obras nunca muestran dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec un taux, le calendrier, Statistiques et les widgets affichent d’abord vos gains. Choisissez Solde d’heures pour voir les heures. Les chantiers ne montrent jamais d’argent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz satnicu kalendar, Uvidi i widgeti prvo pokazuju zaradu. Odaberi Saldo sati da vidiš sate. Gradilišta nikad ne prikazuju novac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una tariffa, il calendario, Statistiche e i widget mostrano prima il guadagno. Scegli Saldo ore per vedere le ore. I cantieri non mostrano mai denaro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met een uurloon tonen de kalender, Inzichten en de widgets eerst je verdiensten. Kies Urensaldo om uren te zien. Bouwplaatsen tonen nooit geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze stawką kalendarz, Statystyki i widżety pokazują najpierw zarobek. Wybierz Saldo godzin, aby widzieć godziny. Budowy nigdy nie pokazują pieniędzy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com um valor definido, o calendário, as Estatísticas e os widgets mostram primeiro o que ganhaste. Escolhe Saldo de horas para veres as horas. As obras nunca mostram dinheiro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Z urno postavko koledar, Vpogledi in pripomočki najprej pokažejo zaslužek. Izberi Saldo ur, da vidiš ure. Gradbišča nikoli ne kažejo denarja."
          }
        }
      }
    },
    "With several breaks switched on, each can be a length or a pair of times.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit mehreren Pausen kann jede eine Dauer oder ein Zeitpaar sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con varios descansos activados, cada uno puede ser una duración o un par de horarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avec plusieurs pauses activées, chacune peut être une durée ou un couple d’horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz uključene višestruke pauze, svaka može biti trajanje ili par vremena."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Con più pause attive, ciascuna può essere una durata o una coppia di orari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Met meerdere pauzes aan kan elke pauze een duur of een paar tijden zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy włączonych wielu przerwach każda może być czasem trwania lub parą godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Com várias pausas ativas, cada uma pode ser uma duração ou um par de horários."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ko je vklopljenih več odmorov, je lahko vsak trajanje ali par časov."
          }
        }
      }
    },
