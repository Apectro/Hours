    "Use this when a contract states a weekly figure that does not divide evenly across the days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimm das, wenn ein Vertrag eine Wochenzahl nennt, die sich nicht gleichmäßig auf die Tage aufteilen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa esto cuando un contrato indica una cifra semanal que no se reparte por igual entre los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez ceci lorsqu’un contrat indique un total hebdomadaire qui ne se répartit pas également sur les jours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristi ovo kad ugovor navodi tjedni broj koji se ne dijeli ravnomjerno po danima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usalo quando un contratto indica un monte ore settimanale che non si divide equamente sui giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik dit als een contract een weektotaal noemt dat niet gelijk over de dagen te verdelen is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj tego, gdy umowa podaje tygodniową liczbę, której nie da się równo rozdzielić na dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa isto quando um contrato indica um total semanal que não se divide igualmente pelos dias."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi to, kadar pogodba navaja tedensko številko, ki se ne deli enakomerno po dnevih."
          }
        }
      }
    },
