    "Overtime, surcharges and paid days off can be added later in Settings › Pay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden, Zuschläge und bezahlte freie Tage kannst du später unter Einstellungen › Lohn ergänzen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra, los pluses y los días libres pagados se pueden añadir más tarde en Ajustes › Pago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures supplémentaires, majorations et jours de congé payés peuvent être ajoutés plus tard dans Réglages › Rémunération."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni rad, dodaci i plaćeni slobodni dani mogu se dodati kasnije u Postavke › Plaća."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Straordinari, maggiorazioni e giorni liberi pagati si aggiungono più tardi in Impostazioni › Paga."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overuren, toeslagen en betaalde vrije dagen kun je later toevoegen in Instellingen › Loon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny, dodatki i płatne dni wolne możesz dodać później w Ustawienia › Wynagrodzenie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas extra, suplementos e dias de folga pagos podem ser acrescentados mais tarde em Definições › Pagamento."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure, dodatke in plačane proste dni lahko dodaš pozneje v Nastavitve › Plačilo."
          }
        }
      }
    },
