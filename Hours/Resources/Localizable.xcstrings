    },
    "That file could not be read as a backup. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei konnte nicht als Sicherung gelesen werden. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo leer ese archivo como copia de seguridad. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fichier n'a pas pu être lu comme une sauvegarde. %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu datoteku nije bilo moguće pročitati kao kopiju. %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere il file come backup. %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dat bestand kon niet als back-up worden gelezen. %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się odczytać tego pliku jako kopii zapasowej. %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível ler esse ficheiro como cópia de segurança. %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te datoteke ni bilo mogoče prebrati kot kopijo. %@"
          }
        }
      }
    },
    "The Sites tab stays either way.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tab Baustellen bleibt so oder so."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pestaña Obras se queda de todos modos."
