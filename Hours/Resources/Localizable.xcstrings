          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure, opravljene ta mesec, in ali si v plusu ali minusu."
          }
        }
      }
    },
    "Hours you enter in the calendar appear here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden, die du im Kalender einträgst, erscheinen hier."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas que introduces en el calendario aparecen aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures saisies dans le calendrier apparaissent ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati koje uneseš u kalendar pojavljuju se ovdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore inserite nel calendario compaiono qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uren die je in de agenda invoert, verschijnen hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny wprowadzone w kalendarzu pojawią się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas que introduzes no calendário aparecem aqui."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure, ki jih vneseš v koledar, se pojavijo tukaj."
          }
        }
      }
    },
    "How a type counts is what makes the balance right: paid absence credits your contracted hours, so a day of leave leaves the balance unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie eine Art zählt, macht den Saldo richtig: Bezahlte Abwesenheit schreibt deine Vertragsstunden gut, ein Urlaubstag lässt den Saldo also unverändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo cuenta un tipo es lo que hace que el saldo sea correcto: la ausencia retribuida acredita tus horas contratadas, así que un día de vacaciones deja el saldo igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La façon dont un type compte est ce qui rend le solde juste : une absence payée crédite vos heures contractuelles, un jour de congé laisse donc le solde inchangé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Način na koji se vrsta računa čini saldo ispravnim: plaćeni izostanak priznaje ugovorene sate, pa dan godišnjeg ne mijenja saldo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il modo in cui un tipo conta è ciò che rende corretto il saldo: l’assenza retribuita accredita le ore contrattuali, quindi un giorno di ferie lascia il saldo invariato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe een type telt, is wat het saldo kloppend maakt: betaald verlof schrijft je contracturen bij, dus een verlofdag laat het saldo ongewijzigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, jak liczy się dany typ, decyduje o poprawności salda: płatna nieobecność zalicza godziny umowne, więc dzień urlopu nie zmienia salda."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A forma como um tipo conta é o que torna o saldo correto: a ausência paga credita as horas contratadas, por isso um dia de férias deixa o saldo inalterado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Način štetja vrste je tisto, kar naredi saldo pravilen: plačana odsotnost prizna pogodbene ure, zato dan dopusta pusti saldo nespremenjen."
          }
        }
      }
    },
    "How am I doing in ${applicationName}": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie stehe ich in ${applicationName} da"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo voy en ${applicationName}"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Où j'en suis dans ${applicationName}"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako stojim u ${applicationName}"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sto andando in ${applicationName}"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe sta ik ervoor in ${applicationName}"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak mi idzie w ${applicationName}"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como estou no ${applicationName}"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako mi gre v ${applicationName}"
          }
        }
      }
    },
    "How far back to check. Days you have marked as excluded, and days that are not working days, are never counted as missing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie weit zurück geprüft wird. Als ausgenommen markierte Tage und Tage, die keine Arbeitstage sind, gelten nie als fehlend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta cuándo mirar atrás. Los días marcados como excluidos y los que no son laborables nunca cuentan como ausentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jusqu’où remonter. Les jours marqués comme exclus et les jours non travaillés ne comptent jamais comme manquants."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko unatrag provjeravati. Dani označeni kao isključeni i dani koji nisu radni nikad se ne broje kao nedostajući."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto indietro controllare. I giorni contrassegnati come esclusi e i giorni non lavorativi non contano mai come mancanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe ver terug er wordt gekeken. Dagen die je hebt uitgesloten en niet-werkdagen tellen nooit als ontbrekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak daleko wstecz sprawdzać. Dni oznaczone jako wykluczone i dni niebędące roboczymi nigdy nie liczą się jako brakujące."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Até quando verificar. Os dias marcados como excluídos e os dias não úteis nunca contam como em falta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako daleč nazaj se preverja. Dnevi, označeni kot izključeni, in dnevi, ki niso delovni, nikoli ne štejejo kot manjkajoči."
          }
        }
      }
    },
    "How hours are written throughout the app. Exports have their own setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wie Stunden in der gesamten App geschrieben werden. Exporte haben eine eigene Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se escriben las horas en toda la app. Las exportaciones tienen su propio ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La façon dont les heures s’écrivent dans toute l’app. Les exports ont leur propre réglage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako se sati pišu kroz cijelu aplikaciju. Izvozi imaju vlastitu postavku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come sono scritte le ore in tutta l’app. Le esportazioni hanno un’impostazione propria."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoe uren in de hele app worden geschreven. Exports hebben hun eigen instelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak godziny są zapisywane w całej aplikacji. Eksporty mają własne ustawienie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Como as horas são escritas em toda a app. As exportações têm a sua própria definição."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kako so ure zapisane po vsej aplikaciji. Izvozi imajo svojo nastavitev."
          }
        }
      }
    },
    "In the evening, a note that a site day you normally write is still missing. Writing the day removes it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abends ein Hinweis, dass ein Baustellentag, den du sonst einträgst, noch fehlt. Sobald der Tag eingetragen ist, entfällt er."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por la tarde, un aviso de que falta un día de obra que sueles anotar. Al anotarlo, el aviso desaparece."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le soir, un rappel qu'un jour de chantier que vous saisissez d'habitude manque encore. Une fois saisi, il disparaît."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Navečer podsjetnik da nedostaje dan gradilišta koji inače upisuješ. Kad se dan upiše, podsjetnik nestaje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sera, un avviso che manca un giorno di cantiere che di solito registri. Una volta registrato, l'avviso scompare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "'s Avonds een melding dat een bouwdag die je normaal invult nog ontbreekt. Zodra je de dag invult, verdwijnt de melding."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wieczorem przypomnienie, że brakuje dnia budowy, który zwykle wpisujesz. Po wpisaniu dnia przypomnienie znika."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "À noite, um aviso de que falta um dia de obra que costumas registar. Ao registá-lo, o aviso desaparece."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zvečer opomnik, da manjka dan gradbišča, ki ga običajno vpišeš. Ko dan vpišeš, opomnik izgine."
          }
        }
      }
    },
