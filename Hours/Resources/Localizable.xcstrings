    "Switch these off to enter worked hours, or the balance, by hand on each day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das aus, um gearbeitete Stunden oder den Saldo an jedem Tag von Hand einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalos para introducir a mano las horas trabajadas, o el saldo, en cada día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez ceci pour saisir à la main les heures travaillées, ou le solde, sur chaque jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključi ovo da ručno unosiš odrađene sate ili saldo za svaki dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivali per inserire a mano le ore lavorate, o il saldo, su ogni giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit uit om gewerkte uren, of het saldo, per dag met de hand in te voeren."
