        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteke ni bilo mogoče pripraviti. %@"
          }
        }
      }
    },
    "The hours already on this device are uploaded then, and nothing is lost if you change your mind before.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stunden auf diesem Gerät werden dann hochgeladen, und nichts geht verloren, wenn du es dir vorher anders überlegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas que ya están en este dispositivo se suben entonces, y no se pierde nada si cambias de idea antes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures déjà sur cet appareil sont alors envoyées, et rien n'est perdu si vous changez d'avis avant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati koji su već na ovom uređaju tada se šalju, i ništa se ne gubi ako se prije toga predomisliš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore già su questo dispositivo vengono caricate allora, e non si perde nulla se cambi idea prima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uren die al op dit apparaat staan, worden dan geüpload, en er gaat niets verloren als je je eerder bedenkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny, które są już na tym urządzeniu, zostaną wtedy wysłane, i nic nie przepadnie, jeśli wcześniej zmienisz zdanie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas que já estão neste dispositivo são enviadas nessa altura, e nada se perde se mudares de ideias antes."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure, ki so že na tej napravi, se takrat naložijo, in nič se ne izgubi, če si prej premisliš."
          }
        }
      }
    },
    "The job this site's hours count towards. Days already recorded keep the job they were recorded with.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tätigkeit, auf die die Stunden dieser Baustelle zählen. Bereits erfasste Tage behalten die Tätigkeit, mit der sie erfasst wurden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El trabajo al que cuentan las horas de esta obra. Los días ya registrados conservan el trabajo con el que se registraron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poste auquel comptent les heures de ce chantier. Les jours déjà enregistrés gardent le poste avec lequel ils l’ont été."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posao kojem se pribrajaju sati ovog gradilišta. Već zabilježeni dani zadržavaju posao s kojim su zabilježeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il lavoro a cui contano le ore di questo cantiere. I giorni già registrati mantengono il lavoro con cui sono stati registrati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De functie waarvoor de uren van deze bouwplaats tellen. Al vastgelegde dagen houden de functie waarmee ze zijn vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca, do której liczą się godziny z tej budowy. Już zapisane dni zachowują pracę, z którą je zapisano."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O trabalho para o qual contam as horas desta obra. Os dias já registados mantêm o trabalho com que foram registados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delo, ki se mu štejejo ure tega gradbišča. Že zabeleženi dnevi obdržijo delo, s katerim so bili zabeleženi."
          }
        }
      }
    },
    "The language your PDF, Excel and CSV files are written in. The app itself stays in your phone's language.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache deiner PDF-, Excel- und CSV-Dateien. Die App selbst bleibt in der Sprache deines Handys."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El idioma de tus archivos PDF, Excel y CSV. La app sigue en el idioma de tu teléfono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La langue de vos fichiers PDF, Excel et CSV. L’app elle-même reste dans la langue de votre téléphone."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jezik tvojih PDF, Excel i CSV datoteka. Sama aplikacija ostaje na jeziku tvog mobitela."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La lingua dei tuoi file PDF, Excel e CSV. L’app resta nella lingua del telefono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De taal van je pdf-, Excel- en csv-bestanden. De app zelf blijft in de taal van je telefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Język twoich plików PDF, Excel i CSV. Sama aplikacja zostaje w języku telefonu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O idioma dos teus ficheiros PDF, Excel e CSV. A app continua no idioma do telemóvel."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jezik tvojih datotek PDF, Excel in CSV. Aplikacija sama ostane v jeziku tvojega telefona."
          }
        }
      }
    },
    "The minutes of a shift that fall in the night window, across midnight too.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Minuten einer Schicht, die ins Nachtfenster fallen, auch über Mitternacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los minutos de un turno que caen en la franja nocturna, también pasada la medianoche."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les minutes d’un poste qui tombent dans la plage de nuit, y compris après minuit."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute smjene koje padaju u noćni prozor, i preko ponoći."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I minuti di un turno che cadono nella fascia notturna, anche oltre la mezzanotte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De minuten van een dienst die in het nachtvenster vallen, ook over middernacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minuty zmiany, które przypadają w porze nocnej, także po północy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os minutos de um turno que caem no período noturno, também depois da meia-noite."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Minute izmene, ki padejo v nočno okno, tudi čez polnoč."
          }
        }
      }
    },
    "The new pay applies from this day on. Days before it keep the pay they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der neue Lohn gilt ab diesem Tag. Tage davor behalten ihren bisherigen Lohn."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El nuevo pago se aplica desde este día. Los días anteriores conservan el que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle rémunération s’applique à partir de ce jour. Les jours antérieurs gardent celle qu’ils avaient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nova plaća vrijedi od ovog dana. Dani prije zadržavaju plaću koju su imali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova paga vale da questo giorno in poi. I giorni precedenti mantengono la paga che avevano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het nieuwe loon geldt vanaf deze dag. Dagen ervoor houden het loon dat ze hadden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowe wynagrodzenie obowiązuje od tego dnia. Dni wcześniejsze zachowują dotychczasowe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O novo pagamento aplica-se a partir deste dia. Os dias anteriores mantêm o que tinham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Novo plačilo velja od tega dne naprej. Dnevi pred njim obdržijo plačilo, ki so ga imeli."
          }
        }
      }
    },
    "The new week applies from this day on. Days before it keep the week they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die neue Woche gilt ab diesem Tag. Tage davor behalten ihre bisherige Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La nueva semana se aplica desde este día. Los días anteriores conservan la semana que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La nouvelle semaine s’applique à partir de ce jour. Les jours antérieurs gardent la semaine qu’ils avaient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Novi tjedan vrijedi od ovog dana. Dani prije zadržavaju tjedan koji su imali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nuova settimana vale da questo giorno in poi. I giorni precedenti mantengono la settimana che avevano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De nieuwe week geldt vanaf deze dag. Dagen ervoor houden de week die ze hadden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nowy tydzień obowiązuje od tego dnia. Dni wcześniejsze zachowują dotychczasowy tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A nova semana aplica-se a partir deste dia. Os dias anteriores mantêm a semana que tinham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Novi teden velja od tega dne naprej. Dnevi pred njim obdržijo teden, ki so ga imeli."
          }
        }
      }
    },
    "The one thing it asks the network is whether anything was bought, which it asks the App Store; no part of your hours goes with the question.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Einzige, was es im Netz abfragt, ist, ob etwas gekauft wurde, und zwar beim App Store; von Ihren Stunden geht dabei nichts mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo único que pregunta a la red es si se ha comprado algo, y se lo pregunta a la App Store; ninguna parte de tus horas viaja con la pregunta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La seule chose qu'il demande au réseau, c'est si quelque chose a été acheté, et il le demande à l'App Store ; aucune partie de vos heures n'accompagne la question."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedino što pita mrežu jest je li nešto kupljeno, a to pita App Store; ništa od vaših sati ne ide uz to pitanje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'unica cosa che chiede alla rete è se è stato acquistato qualcosa, e lo chiede all'App Store; nessuna parte delle tue ore parte con la domanda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het enige wat het aan het netwerk vraagt is of er iets gekocht is, en dat vraagt het de App Store; geen deel van je uren gaat mee met die vraag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedyne, o co pyta sieć, to czy coś zostało kupione — pyta o to App Store; żadna część Twoich godzin nie idzie razem z pytaniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A única coisa que pergunta à rede é se foi comprado algo, e pergunta-o à App Store; nenhuma parte das suas horas segue com a pergunta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Edino, kar vpraša omrežje, je, ali je bilo kaj kupljeno, in to vpraša App Store; z vprašanjem ne gre nič od vaših ur."
          }
        }
      }
    },
    "The running clock with its seconds, and where it is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die laufende Uhr mit Sekunden, und wo sie läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reloj en marcha con los segundos, y dónde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La pointeuse en cours, avec les secondes, et où elle tourne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat koji radi, sa sekundama, i gdje radi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’orologio in corso con i secondi, e dove."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lopende klok met seconden, en waar hij loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Działający zegar z sekundami i miejsce pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O relógio a contar, com os segundos, e onde."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ura, ki teče, s sekundami, in kje teče."
          }
        }
      }
    },
    "The site sheet is part of Zeitkonto Pro. The preview is free, and every site day stays in your backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Baustellenliste gehört zu Zeitkonto Pro. Die Vorschau ist kostenlos, und jeder Baustellentag bleibt in deiner Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja de obra forma parte de Zeitkonto Pro. La vista previa es gratis y cada día de obra se queda en tu copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille de chantier fait partie de Zeitkonto Pro. L’aperçu est gratuit, et chaque journée de chantier reste dans votre sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "List gradilišta dio je Zeitkonto Pro. Pregled je besplatan, a svaki dan na gradilištu ostaje u tvojoj sigurnosnoj kopiji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il foglio di cantiere fa parte di Zeitkonto Pro. L’anteprima è gratuita e ogni giornata di cantiere resta nel tuo backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bouwplaatslijst hoort bij Zeitkonto Pro. Het voorbeeld is gratis, en elke dag op de bouwplaats blijft in je back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz budowy jest częścią Zeitkonto Pro. Podgląd jest bezpłatny, a każdy dzień na budowie zostaje w twojej kopii zapasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha de obra faz parte do Zeitkonto Pro. A pré-visualização é grátis e cada dia de obra fica na tua cópia de segurança."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "List gradbišča je del Zeitkonto Pro. Predogled je brezplačen, vsak dan na gradbišču pa ostane v tvoji varnostni kopiji."
          }
        }
      }
    },
    "The words the app writes — column titles, day types and the summary — plus the names of months and days. Anything you typed yourself is left exactly as you wrote it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter, die die App schreibt – Spaltentitel, Tagesarten und die Zusammenfassung – sowie Monats- und Tagesnamen. Alles, was du selbst getippt hast, bleibt genau so stehen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras que escribe la app —títulos de columna, tipos de día y el resumen— además de los nombres de meses y días. Todo lo que hayas escrito tú se queda exactamente igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots écrits par l’app — titres de colonnes, types de jour et récapitulatif — ainsi que les noms des mois et des jours. Tout ce que vous avez saisi reste exactement tel quel."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Riječi koje aplikacija piše – naslovi stupaca, vrste dana i sažetak – te nazivi mjeseci i dana. Sve što si sam upisao ostaje točno kako si napisao."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole scritte dall’app — titoli delle colonne, tipi di giorno e riepilogo — più i nomi di mesi e giorni. Tutto ciò che hai scritto tu resta esattamente com’è."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De woorden die de app schrijft — kolomtitels, dagtypes en de samenvatting — plus de namen van maanden en dagen. Alles wat je zelf hebt getypt blijft precies zoals je het schreef."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa, które pisze aplikacja – tytuły kolumn, typy dni i podsumowanie – oraz nazwy miesięcy i dni. Wszystko, co wpisałeś sam, zostaje dokładnie tak, jak napisałeś."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras que a app escreve — títulos das colunas, tipos de dia e o resumo — mais os nomes dos meses e dos dias. Tudo o que escreveste fica exatamente como estava."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Besede, ki jih zapiše aplikacija – naslovi stolpcev, vrste dneva in povzetek – ter imena mesecev in dni. Vse, kar si vpisal sam, ostane natanko tako, kot si napisal."
          }
        }
      }
    },
