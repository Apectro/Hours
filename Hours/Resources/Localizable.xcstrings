    "Read-only until Zeitkonto Pro is active again or your other sites are archived. Nothing on it is lost.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur lesbar, bis Zeitkonto Pro wieder aktiv ist oder deine anderen Baustellen archiviert sind. Nichts darauf geht verloren."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo lectura hasta que Zeitkonto Pro vuelva a estar activo o archives tus otras obras. No se pierde nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En lecture seule jusqu’à ce que Zeitkonto Pro soit de nouveau actif ou que vos autres chantiers soient archivés. Rien n’est perdu."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za čitanje dok Zeitkonto Pro ponovno ne bude aktivan ili dok ostala gradilišta ne arhiviraš. Ništa na njemu se ne gubi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sola lettura finché Zeitkonto Pro non torna attivo o finché non archivi gli altri cantieri. Non si perde nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen-lezen tot Zeitkonto Pro weer actief is of je andere bouwplaatsen zijn gearchiveerd. Er gaat niets verloren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko do odczytu, dopóki Zeitkonto Pro nie będzie znów aktywne lub nie zarchiwizujesz pozostałych budów. Nic nie przepada."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Só de leitura até o Zeitkonto Pro voltar a estar ativo ou até arquivares as outras obras. Nada se perde."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Samo za branje, dokler Zeitkonto Pro ni spet aktiven ali dokler ne arhiviraš drugih gradbišč. Nič na njem se ne izgubi."
          }
        }
      }
    },
