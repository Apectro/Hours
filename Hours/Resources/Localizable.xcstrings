    "Reopen it in Settings › Calculation if you need to change these hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnen Sie ihn unter Einstellungen › Berechnung wieder, wenn Sie diese Stunden ändern müssen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrirlo en Ajustes › Cálculo si necesitas cambiar estas horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez-le dans Réglages › Calcul si vous devez modifier ces heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno ga otvorite u Postavke › Izračun ako trebate promijeniti ove sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riaprilo in Impostazioni › Calcolo se devi modificare queste ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropen hem in Instellingen › Berekening als je deze uren wilt wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz go ponownie w Ustawienia › Obliczenia, jeśli musisz zmienić te godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabra-o em Definições › Cálculo se precisar de alterar estas horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova ga odprite v Nastavitve › Izračun, če morate spremeniti te ure."
          }
        }
      }
    },
    "Reopen it to change these hours. You can close it again from the calendar's ⋯ menu.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne ihn wieder, um diese Stunden zu ändern. Abschließen kannst du ihn danach wieder über das ⋯-Menü im Kalender."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a abrirlo para cambiar estas horas. Puedes cerrarlo de nuevo desde el menú ⋯ del calendario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rouvrez-le pour modifier ces heures. Vous pourrez le clôturer à nouveau depuis le menu ⋯ du calendrier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponovno ga otvori da promijeniš ove sate. Poslije ga opet možeš zatvoriti u izborniku ⋯ u kalendaru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riaprilo per modificare queste ore. Puoi richiuderlo dal menu ⋯ del calendario."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Heropen hem om deze uren te wijzigen. Je kunt hem daarna weer afsluiten via het ⋯-menu van de kalender."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz go ponownie, aby zmienić te godziny. Potem możesz go znów zamknąć w menu ⋯ kalendarza."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Reabre-o para alterar estas horas. Podes fechá-lo de novo no menu ⋯ do calendário."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Znova ga odpri, da spremeniš te ure. Pozneje ga lahko spet zaključiš v meniju ⋯ v koledarju."
          }
        }
      }
    },
