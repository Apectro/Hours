    "Delete this day? Hours written on a site stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tag löschen? Auf einer Baustelle eingetragene Stunden bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este día? Las horas escritas en una obra se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce jour ? Les heures saisies sur un chantier sont conservées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati ovaj dan? Sati upisani na gradilištu ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo giorno? Le ore scritte in un cantiere restano."
          }
        },
        "nl": {
