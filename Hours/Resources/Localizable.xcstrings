          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo modifica mesi chiusi: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wijzigt afgesloten maanden: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zmienia zamknięte miesiące: %@."
          }
        },
        "pt": {
          "stringUnit": {
