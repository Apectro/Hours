    "iCloud can't be reached right now. Sync carries on by itself when it can.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist gerade nicht erreichbar. Sync macht von selbst weiter, sobald es geht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se puede acceder a iCloud. La sincronización seguirá sola en cuanto pueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est injoignable pour le moment. La synchronisation reprendra d'elle-même dès que possible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud trenutačno nije dostupan. Sinkronizacija će se sama nastaviti čim bude moguće."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud non è raggiungibile in questo momento. La sincronizzazione riprende da sola appena possibile."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is nu niet bereikbaar. De synchronisatie gaat vanzelf verder zodra het kan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest teraz niedostępny. Synchronizacja wznowi się sama, gdy będzie to możliwe."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud não está acessível neste momento. A sincronização continua sozinha assim que puder."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud trenutno ni dosegljiv. Sinhronizacija se bo sama nadaljevala, ko bo mogoče."
          }
        }
      }
    },
    "iCloud is restricted on this device, so nothing is being synced.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud ist auf diesem Gerät eingeschränkt, deshalb wird nichts synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud está restringido en este dispositivo, así que no se sincroniza nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud est restreint sur cet appareil, rien n'est donc synchronisé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je na ovom uređaju ograničen pa se ništa ne sinkronizira."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud è limitato su questo dispositivo, quindi non si sincronizza nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud is beperkt op dit apparaat, dus er wordt niets gesynchroniseerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud jest ograniczony na tym urządzeniu, więc nic nie jest synchronizowane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iCloud está restrito neste dispositivo, por isso nada está a ser sincronizado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud je v tej napravi omejen, zato se nič ne sinhronizira."
          }
        }
      }
    },
    "iCloud sync could not be started, so this device is using its own copy. Everything you enter is still saved here.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung konnte nicht starten, deshalb nutzt dieses Gerät seine eigene Kopie. Alles, was du einträgst, wird hier weiter gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar la sincronización con iCloud, así que este dispositivo usa su propia copia. Todo lo que introduzcas se sigue guardando aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud n'a pas pu démarrer, cet appareil utilise donc sa propre copie. Tout ce que vous saisissez reste enregistré ici."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija s iCloudom nije se mogla pokrenuti pa ovaj uređaj koristi vlastitu kopiju. Sve što uneseš i dalje se sprema ovdje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile avviare la sincronizzazione con iCloud, quindi questo dispositivo usa la sua copia. Tutto ciò che inserisci viene comunque salvato qui."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie kon niet starten, dus dit apparaat gebruikt zijn eigen kopie. Alles wat je invoert, wordt hier nog steeds bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić synchronizacji z iCloud, więc to urządzenie używa własnej kopii. Wszystko, co wpiszesz, nadal zapisuje się tutaj."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a sincronização com o iCloud, por isso este dispositivo usa a sua própria cópia. Tudo o que introduzires continua a ser guardado aqui."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacije z iCloudom ni bilo mogoče zagnati, zato ta naprava uporablja svojo kopijo. Vse, kar vneseš, se še vedno shrani tukaj."
          }
        }
      }
    },
    "iCloud syncing is off. Your data lives in this app's own storage and is included in an encrypted device backup if you make one. You can turn sync on in Settings › iCloud.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die iCloud-Synchronisierung ist aus. Deine Daten liegen im eigenen Speicher dieser App und sind in einer verschlüsselten Gerätesicherung enthalten, falls du eine anlegst. Einschalten unter Einstellungen › iCloud."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronización con iCloud está desactivada. Tus datos están en el almacenamiento de la app y se incluyen en una copia cifrada del dispositivo, si la haces. Actívala en Ajustes › iCloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La synchronisation iCloud est désactivée. Vos données se trouvent dans l’espace de l’app et sont incluses dans une sauvegarde chiffrée de l’appareil, si vous en faites une. Activez-la dans Réglages › iCloud."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinkronizacija s iCloudom je isključena. Tvoji podaci su u vlastitom spremniku ove aplikacije i uključeni su u šifriranu kopiju uređaja ako je napraviš. Uključi u Postavke › iCloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sincronizzazione iCloud è disattivata. I dati stanno nell’archivio dell’app e sono inclusi in un backup cifrato del dispositivo, se lo fai. Attivala in Impostazioni › iCloud."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "iCloud-synchronisatie staat uit. Je gegevens staan in de opslag van deze app en zitten in een versleutelde apparaatback-up als je die maakt. Zet het aan bij Instellingen › iCloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Synchronizacja z iCloud jest wyłączona. Twoje dane są we własnym magazynie tej aplikacji i trafiają do zaszyfrowanej kopii urządzenia, jeśli ją utworzysz. Włącz w Ustawienia › iCloud."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A sincronização com o iCloud está desligada. Os teus dados estão no armazenamento da app e são incluídos numa cópia encriptada do dispositivo, se fizeres uma. Liga em Definições › iCloud."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinhronizacija z iCloudom je izklopljena. Tvoji podatki so v lastnem prostoru te aplikacije in so vključeni v šifrirano varnostno kopijo naprave, če jo ustvariš. Vklopi v Nastavitve › iCloud."
          }
        }
      }
    },
