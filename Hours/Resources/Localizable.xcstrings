    "Each job keeps its own contracted week, so two jobs with different hours each get their own balance rather than sharing one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Tätigkeit hat ihre eigene Vertragswoche, damit zwei Tätigkeiten mit unterschiedlichen Stunden je einen eigenen Saldo haben statt eines gemeinsamen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trabajo tiene su propia semana contratada, así que dos trabajos con horas distintas tienen cada uno su saldo en vez de compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque poste a sa propre semaine contractuelle : deux postes aux heures différentes ont donc chacun leur solde plutôt qu’un solde commun."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki posao ima svoj ugovoreni tjedan pa dva posla s različitim satima imaju svaki svoj saldo umjesto zajedničkog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lavoro ha la propria settimana contrattuale, così due lavori con ore diverse hanno ciascuno il proprio saldo invece di condividerne uno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke functie heeft zijn eigen contractweek, dus twee functies met verschillende uren krijgen elk hun eigen saldo in plaats van één gedeeld saldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda praca ma własny tydzień umowny, więc dwie prace o różnych godzinach mają osobne salda zamiast wspólnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trabalho tem a sua própria semana contratada, por isso dois trabalhos com horas diferentes têm cada um o seu saldo em vez de partilharem um."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako delo ima svoj pogodbeni teden, zato imata dve deli z različnimi urami vsako svoj saldo namesto skupnega."
          }
        }
      }
    },
