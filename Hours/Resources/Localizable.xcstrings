    "Opens the day with your usual times filled in. The holiday stays paid.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den Tag mit deinen üblichen Zeiten. Der Feiertag bleibt bezahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el día con tus horas habituales. El festivo sigue pagado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la journée avec vos horaires habituels. Le jour férié reste payé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara dan s tvojim uobičajenim vremenima. Blagdan ostaje plaćen."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre il giorno con i tuoi orari abituali. La festività resta retribuita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de dag met je gebruikelijke tijden. De feestdag blijft betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera dzień z twoimi zwykłymi godzinami. Święto pozostaje płatne."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o dia com os teus horários habituais. O feriado continua pago."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre dan z tvojimi običajnimi časi. Praznik ostane plačan."
          }
        }
      }
    },
    "Opens today on your site, filled in like the last day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet heute auf deiner Baustelle, ausgefüllt wie am letzten Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre hoy en tu obra, rellenado como el último día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre aujourd’hui sur votre chantier, rempli comme le dernier jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara današnji dan na tvom gradilištu, ispunjen kao zadnji dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre oggi sul tuo cantiere, compilato come l’ultimo giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent vandaag op je bouwplaats, ingevuld zoals de laatste dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera dzisiejszy dzień na twojej budowie, wypełniony jak ostatni dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre hoje na tua obra, preenchido como no último dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre današnji dan na tvojem gradbišču, izpolnjen kot zadnji dan."
          }
        }
      }
    },
    "Opens today's day to write it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet den heutigen Tag zum Eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre el día de hoy para anotarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la journée d’aujourd’hui pour la saisir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara današnji dan za upis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la giornata di oggi per scriverla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent vandaag om het in te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera dzisiejszy dzień do wpisania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre o dia de hoje para o registar."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre današnji dan za vpis."
          }
        }
      }
    },
    "Optional — leave it out when the material says it all": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional – weglassen, wenn das Material alles sagt"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: déjalo fuera si el material lo dice todo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif – à omettre si le matériel suffit"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno – izostavi kad materijal govori sve"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo – tralascialo se il materiale dice tutto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel – weglaten als het materiaal alles zegt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie – pomiń, gdy materiał mówi wszystko"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional – deixa de fora quando o material diz tudo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno – izpusti, ko material pove vse"
          }
        }
      }
    },
    "Optional — the site manager confirms it on your phone": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional – die Bauleitung bestätigt es auf deinem Handy"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional: el jefe de obra lo confirma en tu teléfono"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif – le conducteur de travaux le confirme sur votre téléphone"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno – voditelj gradilišta potvrđuje na tvom mobitelu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo – il direttore lavori lo conferma sul tuo telefono"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel – de bouwleiding bevestigt het op je telefoon"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie – kierownik budowy potwierdza to na twoim telefonie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional – o diretor de obra confirma no teu telemóvel"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno – vodja gradbišča potrdi na tvojem telefonu"
          }
        }
      }
    },
    "Optional, only for seeing what a month earned. It stays off the sheets for your boss unless you add it in Settings › Export options, and a site's sheet never shows money.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Freiwillig, nur um zu sehen, was ein Monat gebracht hat. Auf den Listen für den Chef steht es nur, wenn du es unter Einstellungen › Exportoptionen hinzufügst, und die Liste einer Baustelle zeigt nie Geld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional, solo para ver lo que ha dado un mes. No aparece en las hojas para el jefe salvo que lo añadas en Ajustes › Opciones de exportación, y la hoja de una obra nunca muestra dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif, seulement pour voir ce qu’un mois a rapporté. Il n’apparaît pas sur les feuilles pour votre chef, sauf si vous l’ajoutez dans Réglages › Options d’export, et la feuille d’un chantier n’affiche jamais d’argent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobavezno, samo da vidiš koliko je mjesec donio. Na listama za šefa nije, osim ako ga dodaš u Postavke › Postavke izvoza, a lista gradilišta nikad ne prikazuje novac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo, solo per vedere quanto ha reso un mese. Non compare sui fogli per il capo se non lo aggiungi in Impostazioni › Opzioni di esportazione, e il foglio di un cantiere non mostra mai soldi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Optioneel, alleen om te zien wat een maand heeft opgeleverd. Het staat niet op de lijsten voor je baas, tenzij je het toevoegt in Instellingen › Exportopties, en de lijst van een bouwplaats toont nooit geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalnie, tylko żeby widzieć, ile przyniósł miesiąc. Nie ma tego na listach dla szefa, chyba że dodasz w Ustawienia › Opcje eksportu, a lista budowy nigdy nie pokazuje pieniędzy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional, só para veres quanto rendeu um mês. Não aparece nas folhas para o chefe a não ser que o acrescentes em Definições › Opções de exportação, e a folha de uma obra nunca mostra dinheiro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Neobvezno, samo da vidiš, koliko je prinesel mesec. Na listih za šefa ga ni, razen če ga dodaš v Nastavitve › Možnosti izvoza, list gradbišča pa nikoli ne kaže denarja."
          }
        }
      }
    },
