    "See what your hours earn, overtime and surcharges included.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sieh, was deine Stunden bringen, Überstunden und Zuschläge inklusive."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mira lo que ganan tus horas, con horas extra y recargos incluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voyez ce que rapportent vos heures, heures supp. et majorations comprises."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vidi koliko ti sati donose, s prekovremenima i dodacima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda quanto rendono le tue ore, straordinari e maggiorazioni compresi."
          }
        },
        "nl": {
