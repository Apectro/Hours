    "Tap a day to see it below. Tap it again to write your hours.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Tag, um ihn unten zu sehen. Tippe noch einmal, um deine Stunden einzutragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un día para verlo abajo. Tócalo otra vez para anotar tus horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un jour pour le voir en dessous. Touchez-le à nouveau pour saisir vos heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni dan da ga vidiš ispod. Dodirni ga opet da upišeš sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un giorno per vederlo sotto. Toccalo di nuovo per scrivere le ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een dag om hem hieronder te zien. Tik nog eens om je uren in te vullen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij dzień, żeby zobaczyć go poniżej. Stuknij jeszcze raz, żeby wpisać godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num dia para o veres em baixo. Toca outra vez para registar as horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni dan, da ga vidiš spodaj. Tapni ga še enkrat, da vpišeš ure."
          }
        }
      }
    },
    "Tap a name to tick or untick them. Tap their times to change just that person.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Namen, um ihn abzuhaken oder den Haken zu entfernen. Tippe auf die Zeiten, um nur diese Person zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un nombre para marcarlo o desmarcarlo. Toca sus horas para cambiar solo a esa persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un nom pour le cocher ou le décocher. Touchez ses horaires pour ne modifier que cette personne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni ime da ga označiš ili odznačiš. Dodirni vremena da promijeniš samo tu osobu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un nome per spuntarlo o togliere la spunta. Tocca gli orari per cambiare solo quella persona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een naam om die aan of uit te vinken. Tik op de tijden om alleen die persoon te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij imię, aby zaznaczyć lub odznaczyć osobę. Stuknij godziny, aby zmienić tylko tę osobę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num nome para o marcar ou desmarcar. Toca no horário para alterar só essa pessoa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tapni ime, da ga označiš ali odznačiš. Tapni čase, da spremeniš samo to osebo."
          }
        }
      }
    },
    "Tap to open full size": {
