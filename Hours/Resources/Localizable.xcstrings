    "Vacation days left this year, and your next days off.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übrige Urlaubstage in diesem Jahr und dein nächster Urlaub."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días de vacaciones que te quedan este año y tus próximos días libres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours de congé restants cette année, et vos prochains congés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Preostali dani godišnjeg ove godine i sljedeći slobodni dani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni di ferie rimasti quest’anno e le prossime ferie."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Resterende verlofdagen dit jaar, en je volgende vrije dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostałe dni urlopu w tym roku i najbliższe wolne."
          }
        },
