    "Working a day off or a public holiday is a real thing, so times can be added to any day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An einem freien Tag oder Feiertag zu arbeiten kommt vor, also lassen sich Zeiten an jedem Tag eintragen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajar en un día libre o festivo pasa, así que se pueden añadir horarios a cualquier día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travailler un jour de repos ou un jour férié arrive, les horaires peuvent donc être ajoutés à n’importe quel jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad na slobodan dan ili praznik se događa, pa se vremena mogu unijeti na bilo koji dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavorare in un giorno libero o festivo capita, quindi gli orari si possono aggiungere a qualsiasi giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werken op een vrije dag of feestdag komt voor, dus tijden kunnen op elke dag worden toegevoegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca w dzień wolny lub święto się zdarza, więc godziny można dodać do dowolnego dnia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalhar num dia de folga ou feriado acontece, por isso os horários podem ser adicionados a qualquer dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delo na prostem dnevu ali praznik se dogaja, zato je čase mogoče vnesti na kateri koli dan."
          }
        }
      }
    },
