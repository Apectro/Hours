    "iPhone watches at most 20 sites for one app. This one is past the first 20 sites with a reminder, so it isn't watched.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das iPhone überwacht höchstens 20 Baustellen pro App. Diese liegt hinter den ersten 20 Baustellen mit Erinnerung und wird daher nicht überwacht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El iPhone vigila como máximo 20 obras por app. Esta va después de las primeras 20 obras con recordatorio, así que no se vigila."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone surveille au plus 20 chantiers par app. Celui-ci vient après les 20 premiers chantiers avec rappel : il n’est donc pas surveillé."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone prati najviše 20 gradilišta po aplikaciji. Ovo je iza prvih 20 gradilišta s podsjetnikom, pa se ne prati."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’iPhone controlla al massimo 20 cantieri per app. Questo viene dopo i primi 20 cantieri con promemoria, quindi non è controllato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De iPhone houdt per app hoogstens 20 bouwplaatsen in de gaten. Deze komt na de eerste 20 bouwplaatsen met herinnering en wordt dus niet gevolgd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone obserwuje najwyżej 20 budów na aplikację. Ta jest za pierwszymi 20 budowami z przypomnieniem, więc nie jest obserwowana."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O iPhone vigia no máximo 20 obras por app. Esta vem depois das primeiras 20 obras com lembrete, por isso não é vigiada."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone spremlja največ 20 gradbišč na aplikacijo. To je za prvimi 20 gradbišči z opomnikom, zato se ne spremlja."
          }
        }
      }
    },
