    "Turn this off to keep a day's details without counting it towards any total.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte das aus, um die Angaben eines Tages zu behalten, ohne ihn in Summen einzurechnen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para conservar los detalles de un día sin incluirlo en los totales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez ceci pour conserver les détails d’un jour sans le compter dans les totaux."
