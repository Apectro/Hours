    "Drag to reorder. Columns for fields you have switched off are never offered.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Umsortieren ziehen. Spalten für ausgeschaltete Felder werden nie angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Las columnas de los campos desactivados nunca se ofrecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour réordonner. Les colonnes des champs désactivés ne sont jamais proposées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za promjenu redoslijeda. Stupci za isključena polja se nikad ne nude."
          }
        },
        "it": {
          "stringUnit": {
