    "Days before the change keep the week they had.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tage vor der Änderung behalten ihre bisherige Woche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días anteriores al cambio conservan la semana que tenían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours antérieurs au changement gardent la semaine qu’ils avaient."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani prije promjene zadržavaju tjedan koji su imali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni prima della modifica mantengono la settimana che avevano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagen vóór de wijziging houden de week die ze hadden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni przed zmianą zachowują dotychczasowy tydzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias antes da alteração mantêm a semana que tinham."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevi pred spremembo obdržijo teden, ki so ga imeli."
          }
        }
      }
    },
