    "Reminders only nag on a site's work days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen melden sich nur an den Arbeitstagen einer Baustelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios solo avisan los días de trabajo de la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne se manifestent que les jours de travail du chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici se javljaju samo radnim danima gradilišta."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria insistono solo nei giorni di lavoro del cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen zeuren alleen op de werkdagen van een bouwplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia odzywają się tylko w dni pracy budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes só insistem nos dias de trabalho da obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki se oglasijo le na delovne dni gradbišča."
          }
        }
      }
    },
    "Reminders only nag on these days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen melden sich nur an diesen Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios solo avisan estos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne se manifestent que ces jours-là."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici se javljaju samo tim danima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria insistono solo in questi giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen zeuren alleen op deze dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia odzywają się tylko w te dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes só insistem nestes dias."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki se oglasijo le te dni."
          }
        }
      }
    },
    "Reminders only nag on these days. With none ticked, they go by the days the site was worked lately.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen melden sich nur an diesen Tagen. Ist keiner angehakt, zählen die Tage, an denen zuletzt hier gearbeitet wurde."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios solo avisan estos días. Sin ninguno marcado, siguen los días en que se trabajó últimamente en la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne se manifestent que ces jours-là. Si aucun n’est coché, ils suivent les jours où le chantier a été travaillé récemment."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici se javljaju samo tim danima. Ako nijedan nije označen, ravnaju se po danima kad se zadnje radilo na gradilištu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria insistono solo in questi giorni. Senza spunte, seguono i giorni in cui si è lavorato di recente nel cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen zeuren alleen op deze dagen. Is er geen aangevinkt, dan tellen de dagen waarop er de laatste tijd is gewerkt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia odzywają się tylko w te dni. Gdy żaden nie jest zaznaczony, liczą się dni, w które ostatnio pracowano na budowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes só insistem nestes dias. Sem nenhum marcado, seguem os dias em que se trabalhou ultimamente na obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki se oglasijo le te dni. Če ni označen noben, se ravnajo po dneh, ko se je zadnje čase delalo na gradbišču."
          }
        }
      }
    },
    "Reminders only work when Zeitkonto may use your location “Always”. Change it in Settings › Zeitkonto › Location.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erinnerungen funktionieren nur, wenn Zeitkonto deinen Standort „Immer“ verwenden darf. Ändere das unter Einstellungen › Zeitkonto › Standort."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recordatorios solo funcionan si Zeitkonto puede usar tu ubicación «Siempre». Cámbialo en Ajustes › Zeitkonto › Ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les rappels ne fonctionnent que si Zeitkonto peut utiliser votre position « Toujours ». Modifiez-le dans Réglages › Zeitkonto › Position."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Podsjetnici rade samo kad Zeitkonto smije koristiti tvoju lokaciju „Uvijek”. Promijeni to u Postavke › Zeitkonto › Lokacija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I promemoria funzionano solo se Zeitkonto può usare la tua posizione “Sempre”. Cambialo in Impostazioni › Zeitkonto › Posizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herinneringen werken alleen als Zeitkonto je locatie ‘Altijd’ mag gebruiken. Wijzig dit in Instellingen › Zeitkonto › Locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przypomnienia działają tylko wtedy, gdy Zeitkonto może używać twojej lokalizacji „Zawsze”. Zmień to w Ustawienia › Zeitkonto › Lokalizacja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os lembretes só funcionam se o Zeitkonto puder usar a tua localização «Sempre». Muda isso em Definições › Zeitkonto › Localização."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opomniki delujejo samo, če sme Zeitkonto uporabljati tvojo lokacijo »Vedno«. Spremeni to v Nastavitve › Zeitkonto › Lokacija."
          }
        }
      }
    },
