      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verfügbare Überstunden: %@ · etwa 1 freier Tag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas extra disponibles: %@ · aprox. 1 día libre"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Heures supp. disponibles : %@ · environ 1 jour de repos"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostupni prekovremeni: %@ · oko 1 slobodan dan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Straordinari disponibili: %@ · circa 1 giorno libero"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschikbare overuren: %@ · ongeveer 1 vrije dag"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostępne nadgodziny: %@ · około 1 dzień wolny"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas extra disponíveis: %@ · cerca de 1 dia de folga"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Razpoložljive nadure: %@ · približno 1 prost dan"
          }
        }
      }
    },
    "Overtime needs expected hours to measure against, so it follows that setting.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Überstunden brauchen Sollstunden als Maßstab, also folgen sie dieser Einstellung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas extra necesitan horas previstas con las que medirse, así que siguen ese ajuste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures supplémentaires ont besoin d’heures prévues comme référence : elles suivent donc ce réglage."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekovremeni trebaju planirane sate kao mjerilo pa slijede tu postavku."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli straordinari hanno bisogno di ore previste come riferimento, quindi seguono quell’impostazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Overuren hebben verwachte uren nodig als maatstaf, dus ze volgen die instelling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadgodziny potrzebują wymaganych godzin jako punktu odniesienia, więc podążają za tym ustawieniem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas extra precisam de horas previstas como referência, por isso seguem essa definição."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadure potrebujejo predvidene ure kot merilo, zato sledijo tej nastavitvi."
          }
        }
      }
    },
