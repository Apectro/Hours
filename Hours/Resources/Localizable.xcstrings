    "Plus %lld km from your site day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dazu %lld km von deinem Baustellentag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más %lld km de tu día en la obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %lld km de votre journée sur le chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uz to %lld km s tvog dana na gradilištu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più %lld km dal tuo giorno in cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %lld km van je dag op de bouwplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus %lld km z twojego dnia na budowie."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais %lld km do teu dia na obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poleg tega %lld km s tvojega dneva na gradbišču."
          }
        }
      }
    },
    "Precise Location is off for Zeitkonto, so arriving can't be noticed. Turn it on in Settings › Zeitkonto › Location.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Genauer Standort“ ist für Zeitkonto aus, daher kann die Ankunft nicht bemerkt werden. Schalte ihn unter Einstellungen › Zeitkonto › Standort ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "«Ubicación exacta» está desactivada para Zeitkonto, así que no se puede notar la llegada. Actívala en Ajustes › Zeitkonto › Ubicación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« Position exacte » est désactivée pour Zeitkonto, votre arrivée ne peut donc pas être détectée. Activez-la dans Réglages › Zeitkonto › Position."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "„Precizna lokacija” je za Zeitkonto isključena, pa se dolazak ne može primijetiti. Uključi je u Postavke › Zeitkonto › Lokacija."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "“Posizione esatta” è disattivata per Zeitkonto, quindi l’arrivo non può essere notato. Attivala in Impostazioni › Zeitkonto › Posizione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "‘Exacte locatie’ staat uit voor Zeitkonto, dus aankomst kan niet worden opgemerkt. Zet hem aan in Instellingen › Zeitkonto › Locatie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "„Dokładna lokalizacja” jest wyłączona dla Zeitkonto, więc nie można zauważyć przyjazdu. Włącz ją w Ustawienia › Zeitkonto › Lokalizacja."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "«Localização exata» está desativada para o Zeitkonto, por isso a chegada não pode ser notada. Ativa-a em Definições › Zeitkonto › Localização."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "»Natančna lokacija« je za Zeitkonto izklopljena, zato prihoda ni mogoče zaznati. Vklopi jo v Nastavitve › Zeitkonto › Lokacija."
          }
        }
      }
    },
