    "When a holiday falls on a Sunday, your region may move it to the Monday. Check the regional list.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fällt ein Feiertag auf einen Sonntag, kann deine Region ihn auf den Montag verlegen. Prüf die regionale Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un festivo cae en domingo, tu comunidad puede trasladarlo al lunes. Consulta el calendario autonómico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un jour férié tombe un dimanche, votre région peut le reporter au lundi. Vérifiez la liste régionale."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad blagdan padne u nedjelju, tvoja ga regija može premjestiti na ponedjeljak. Provjeri regionalni popis."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una festività cade di domenica, la tua regione può spostarla al lunedì. Controlla l'elenco regionale."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Valt een feestdag op zondag, dan kan je regio hem naar maandag verplaatsen. Kijk in de regionale lijst."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy święto wypada w niedzielę, twój region może przenieść je na poniedziałek. Sprawdź listę regionalną."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando um feriado calha a um domingo, a tua região pode passá-lo para segunda-feira. Confirma a lista regional."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Če praznik pade na nedeljo, ga lahko tvoja regija prestavi na ponedeljek. Preveri regionalni seznam."
          }
        }
      }
    },
    "When does this change start?": {
      "extractionState": "manual",
      "localizations": {
