    "Your hours are kept on this device and in your own private iCloud storage, which only your devices can read. %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stunden bleiben auf diesem Gerät und in Ihrem eigenen privaten iCloud-Speicher, den nur Ihre Geräte lesen können. %@ %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus horas se quedan en este dispositivo y en tu propio almacenamiento privado de iCloud, que solo pueden leer tus dispositivos. %@ %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos heures restent sur cet appareil et dans votre propre stockage iCloud privé, que seuls vos appareils peuvent lire. %@ %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaši sati ostaju na ovom uređaju i u vašoj privatnoj iCloud pohrani, koju mogu čitati samo vaši uređaji. %@ %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue ore restano su questo dispositivo e nel tuo spazio iCloud privato, leggibile solo dai tuoi dispositivi. %@ %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je uren blijven op dit apparaat en in je eigen privé-iCloudopslag, die alleen jouw apparaten kunnen lezen. %@ %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje godziny pozostają na tym urządzeniu i w Twojej prywatnej przestrzeni iCloud, którą mogą odczytać tylko Twoje urządzenia. %@ %@"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas horas ficam neste dispositivo e no seu próprio armazenamento privado do iCloud, que só os seus dispositivos podem ler. %@ %@"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše ure ostanejo v tej napravi in v vaši zasebni shrambi iCloud, ki jo lahko berejo le vaše naprave. %@ %@"
          }
        }
      }
    },
    "Your hours are stored locally and nowhere else. %@ %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihre Stunden werden lokal gespeichert und sonst nirgends. %@ %@"
