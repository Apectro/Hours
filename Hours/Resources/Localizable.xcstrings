    "Swipe a name to rename or hide it. Nobody is ever deleted, so hours already recorded never disappear: someone hidden simply stops being offered for new days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische über einen Namen, um ihn umzubenennen oder auszublenden. Niemand wird je gelöscht, damit erfasste Stunden nie verschwinden: Wer ausgeblendet ist, wird für neue Tage einfach nicht mehr angeboten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza un nombre para cambiarlo u ocultarlo. Nunca se elimina a nadie, así que las horas ya registradas nunca desaparecen: a quien está oculto simplemente ya no se le ofrece para días nuevos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez un nom pour le renommer ou le masquer. Personne n’est jamais supprimé, donc les heures déjà enregistrées ne disparaissent jamais : une personne masquée n’est simplement plus proposée pour les nouveaux jours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci preko imena da ga preimenuješ ili sakriješ. Nitko se nikad ne briše, pa zabilježeni sati nikad ne nestaju: skrivena osoba samo se više ne nudi za nove dane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su un nome per rinominarlo o nasconderlo. Nessuno viene mai eliminato, così le ore già registrate non spariscono mai: chi è nascosto semplicemente non viene più proposto per i nuovi giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg over een naam om die te wijzigen of te verbergen. Niemand wordt ooit verwijderd, dus vastgelegde uren verdwijnen nooit: wie verborgen is, wordt gewoon niet meer aangeboden voor nieuwe dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń po imieniu, aby je zmienić lub ukryć. Nikt nigdy nie jest usuwany, więc zapisane godziny nigdy nie znikają: ukryta osoba po prostu nie jest już proponowana na nowe dni."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza um nome para o mudar ou ocultar. Ninguém é apagado, por isso as horas já registadas nunca desaparecem: quem está oculto deixa apenas de ser sugerido para novos dias."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj čez ime, da ga preimenuješ ali skriješ. Nihče ni nikoli izbrisan, zato zabeležene ure nikoli ne izginejo: skrita oseba se le ne ponuja več za nove dneve."
          }
        }
      }
    },
    "Swipe for your year in numbers.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wisch weiter für dein Jahr in Zahlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para ver tu año en cifras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour voir votre année en chiffres."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci za svoju godinu u brojkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per il tuo anno in numeri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg voor je jaar in cijfers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby zobaczyć swój rok w liczbach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para ver o teu ano em números."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj za svoje leto v številkah."
          }
        }
      }
    },
    "Swipe to remove a change. The pay before it then runs on in its place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wische, um eine Änderung zu entfernen. Der Lohn davor gilt dann weiter."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para quitar un cambio. El pago anterior sigue entonces en su lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balayez pour retirer un changement. La rémunération d’avant s’applique alors à sa place."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Povuci da ukloniš promjenu. Plaća prije nje tada vrijedi i dalje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri per rimuovere una modifica. La paga precedente continua allora a valere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Veeg om een wijziging te verwijderen. Het loon ervoor geldt dan verder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń, aby usunąć zmianę. Wynagrodzenie sprzed niej obowiązuje wtedy dalej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza para remover uma alteração. O pagamento anterior continua então em vigor."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podrsaj, da odstraniš spremembo. Plačilo pred njo potem velja še naprej."
          }
        }
      }
    },
    "Swipe to remove a change. The week before it then runs on in its place.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
