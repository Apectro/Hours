    "Vacation, sick days and public holidays earn the hours credited for them, at the rate, with no surcharges.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Urlaub, Krankheitstage und Feiertage bringen die dafür angerechneten Stunden zum Stundenlohn, ohne Zuschläge."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las vacaciones, las bajas y los festivos suman las horas acreditadas, a la tarifa, sin recargos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les congés, les jours de maladie et les jours fériés rapportent les heures créditées, au taux, sans majoration."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Godišnji, bolovanje i praznici donose za njih priznate sate po satnici, bez dodataka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferie, malattia e festività fanno guadagnare le ore accreditate, alla tariffa, senza maggiorazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakantie, ziektedagen en feestdagen leveren de ervoor toegekende uren op, tegen het uurloon, zonder toeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Urlop, chorobowe i święta przynoszą zaliczone za nie godziny według stawki, bez dodatków."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As férias, as baixas e os feriados rendem as horas creditadas, ao valor, sem acréscimos."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dopust, bolniški dnevi in prazniki prinesejo zanje priznane ure po urni postavki, brez dodatkov."
          }
        }
      }
    },
