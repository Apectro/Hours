    "This cannot be undone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To se ne može poništiti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser anulado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti."
          }
        }
      }
    },
    "This cannot be undone. Create a backup first if you are not sure.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das lässt sich nicht rückgängig machen. Erstelle vorher eine Sicherung, wenn du unsicher bist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto no se puede deshacer. Crea antes una copia si no estás seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette action est irréversible. Créez d’abord une sauvegarde en cas de doute."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To se ne može poništiti. Napravi prvo kopiju ako nisi siguran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si può annullare. Se hai dubbi, crea prima un backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit kan niet ongedaan worden gemaakt. Maak eerst een back-up als je twijfelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tej operacji nie można cofnąć. Najpierw utwórz kopię, jeśli nie masz pewności."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Isto não pode ser anulado. Cria primeiro uma cópia se não tiveres a certeza."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tega ni mogoče razveljaviti. Če nisi prepričan, najprej ustvari varnostno kopijo."
          }
        }
      }
    },
    "This clock has been running for over a day. Stopping it now records a full day at most — check the times afterwards.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Uhr läuft seit über einem Tag. Wenn du sie jetzt stoppst, wird höchstens ein voller Tag erfasst – prüfe die Zeiten danach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este fichaje lleva abierto más de un día. Al detenerlo ahora se registra como mucho un día completo: revisa después los horarios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce pointage est ouvert depuis plus d’un jour. L’arrêter maintenant enregistre au maximum une journée complète : vérifiez ensuite les horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ovaj sat radi više od jednog dana. Ako ga sada zaustaviš, bilježi se najviše jedan puni dan – provjeri vremena poslije."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa timbratura è aperta da più di un giorno. Fermandola ora viene registrato al massimo un giorno intero: controlla poi gli orari."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze klok loopt al meer dan een dag. Nu stoppen legt hooguit één volle dag vast — controleer daarna de tijden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten zegar działa ponad dobę. Zatrzymanie go teraz zapisze najwyżej jeden pełny dzień – sprawdź potem godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Este registo está aberto há mais de um dia. Ao pará-lo agora regista-se no máximo um dia inteiro — verifica depois os horários."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta ura teče že več kot dan. Če jo zdaj ustaviš, se zabeleži največ en poln dan – čase pozneje preveri."
          }
        }
      }
    },
