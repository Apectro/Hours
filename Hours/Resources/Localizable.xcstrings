          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja sve zabilježeno na tim danima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove tutto ciò che è registrato in quei giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwijdert alles wat op die dagen is vastgelegd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa wszystko zapisane w tych dniach."
          }
        },
        "pt": {
