    "Work, sick, vacation, bad weather and your own: what each counts and pays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Arbeit, krank, Urlaub, Schlechtwetter und deine eigenen: was jede zählt und zahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo, baja, vacaciones, mal tiempo y los tuyos: qué cuenta y paga cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail, maladie, congés, intempéries et les vôtres : ce que chacun compte et paie."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rad, bolovanje, godišnji, loše vrijeme i tvoje vlastite: što svaka broji i plaća."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavoro, malattia, ferie, maltempo e i tuoi: cosa conta e paga ciascuno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Werk, ziek, verlof, slecht weer en je eigen: wat elk telt en betaalt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca, choroba, urlop, zła pogoda i twoje własne: co każdy liczy i płaci."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabalho, baixa, férias, mau tempo e os teus: o que cada um conta e paga."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Delo, bolniška, dopust, slabo vreme in tvoje lastne: kaj vsaka šteje in plača."
          }
        }
      }
    },
