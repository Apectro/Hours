    "Offered under Material, the most recently used first. Removing one here does not change any job.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unter Material angeboten, zuletzt verwendete zuerst. Hier entfernen ändert keine Arbeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ofrecen en Material, los más recientes primero. Quitar uno aquí no cambia ningún trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposés sous Matériel, les plus récents d’abord. En retirer un ici ne modifie aucun travail."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nudi se pod Materijal, najprije zadnje korišteno. Uklanjanje ovdje ne mijenja nijedan rad."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposti sotto Materiale, prima i più recenti. Rimuoverne uno qui non cambia nessun lavoro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangeboden onder Materiaal, laatst gebruikte eerst. Hier verwijderen verandert geen werk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponowane w sekcji Materiał, najpierw ostatnio używane. Usunięcie tutaj nie zmienia żadnej pracy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugeridos em Material, os mais recentes primeiro. Remover um aqui não altera nenhum trabalho."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponujeno pod Material, najprej nazadnje uporabljeno. Odstranitev tukaj ne spremeni nobenega dela."
