    "Hours already recorded against this job stay, and count towards %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits auf diese Tätigkeit erfasste Stunden bleiben und zählen zu %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas ya registradas en este trabajo se mantienen y cuentan para %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures déjà saisies sur ce poste restent et comptent pour %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već evidentirani sati na ovom poslu ostaju i broje se u %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore già registrate su questo lavoro restano e contano per %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vastgelegde uren op deze functie blijven staan en tellen mee voor %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny zapisane już przy tej pracy pozostają i liczą się do %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas já registadas neste trabalho mantêm-se e contam para %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že zabeležene ure pri tem delu ostanejo in se štejejo k %@."
          }
        }
      }
    },
