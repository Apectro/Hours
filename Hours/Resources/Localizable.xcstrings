    "Apple Maps has no address for the saved place. Type it instead.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Karten hat keine Adresse für den gespeicherten Ort. Tippe sie stattdessen ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapas de Apple no tiene una dirección para el lugar guardado. Escríbela tú."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plans n’a pas d’adresse pour l’emplacement enregistré. Saisissez-la vous-même."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Karte nema adresu za spremljeno mjesto. Upiši je ručno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mappe di Apple non ha un indirizzo per il luogo salvato. Scrivilo tu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Kaarten heeft geen adres voor de opgeslagen plek. Typ het zelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapy Apple nie mają adresu dla zapisanego miejsca. Wpisz go sam."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os Mapas da Apple não têm morada para o local guardado. Escreve-a tu."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Zemljevidi nimajo naslova za shranjeni kraj. Vpiši ga sam."
          }
        }
      }
    },
    "Applied to the worked total of each day, not to the times you enter.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird auf die Tagessumme der Arbeitszeit angewendet, nicht auf die eingetragenen Zeiten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica al total trabajado de cada día, no a los horarios que introduces."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique au total travaillé de chaque jour, pas aux horaires que vous saisissez."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Primjenjuje se na dnevni zbroj odrađenog, ne na vremena koja unosiš."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si applica al totale lavorato di ogni giorno, non agli orari che inserisci."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wordt toegepast op het gewerkte dagtotaal, niet op de tijden die je invoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stosowane do dziennej sumy przepracowanego czasu, nie do wpisywanych godzin."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplica-se ao total trabalhado de cada dia, não aos horários que introduzes."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uporabi se za dnevno vsoto opravljenega, ne za vnesene čase."
          }
        }
      }
    },
