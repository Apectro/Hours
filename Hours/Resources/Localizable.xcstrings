    "Fill in only what your payslip shows. Hours can be typed as 7.5 or 7:30.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trag nur ein, was auf deiner Lohnabrechnung steht. Stunden gehen als 7,5 oder 7:30."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena solo lo que muestra tu nómina. Las horas se pueden escribir como 7,5 o 7:30."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne saisissez que ce qui figure sur votre fiche de paie. Les heures peuvent s’écrire 7,5 ou 7:30."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upiši samo ono što piše na platnoj listi. Sate možeš upisati kao 7,5 ili 7:30."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci solo ciò che riporta la busta paga. Le ore si possono scrivere come 7,5 o 7:30."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vul alleen in wat op je loonstrook staat. Uren kun je typen als 7,5 of 7:30."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz tylko to, co jest na pasku wypłaty. Godziny można wpisać jako 7,5 lub 7:30."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche só o que o recibo mostra. As horas podem ser escritas como 7,5 ou 7:30."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vpiši samo to, kar piše na plačilni listi. Ure lahko vpišeš kot 7,5 ali 7:30."
          }
        }
      }
    },
    "Fills each day with your usual start, end and break. Public holidays in the range are left alone.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füllt jeden Tag mit deinem üblichen Beginn, Ende und deiner Pause. Feiertage im Zeitraum bleiben unberührt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena cada día con tu inicio, fin y descanso habituales. Los festivos del intervalo no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit chaque jour avec vos début, fin et pause habituels. Les jours fériés de la plage ne sont pas touchés."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Popunjava svaki dan tvojim uobičajenim početkom, krajem i pauzom. Praznici u rasponu ostaju netaknuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila ogni giorno con inizio, fine e pausa abituali. Le festività nell’intervallo restano intatte."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vult elke dag met je gebruikelijke begin, einde en pauze. Feestdagen in het bereik blijven ongemoeid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnia każdy dzień twoim zwykłym początkiem, końcem i przerwą. Święta w zakresie pozostają nietknięte."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Preenche cada dia com o teu início, fim e pausa habituais. Os feriados no intervalo não são alterados."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsak dan zapolni s tvojim običajnim začetkom, koncem in odmorom. Prazniki v obsegu ostanejo nedotaknjeni."
          }
        }
      }
    },
