            "value": "Die Uhr konnte nicht gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el fichaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pointage n'a pas pu démarrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat se nije mogao pokrenuti."
          }
        },
