    "Nothing recorded in %@ yet. Your review fills in as the days do.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ ist noch nichts erfasst. Dein Rückblick füllt sich mit den Tagen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay nada registrado en %@. Tu resumen se llena a medida que pasan los días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien d’enregistré en %@ pour l’instant. Votre bilan se remplit au fil des jours."
