    "One figure at most. A calendar that shows everything shows nothing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Höchstens eine Zahl. Ein Kalender, der alles zeigt, zeigt nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Como mucho una cifra. Un calendario que lo enseña todo no enseña nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chiffre au maximum. Un calendrier qui montre tout ne montre rien."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najviše jedan broj. Kalendar koji prikazuje sve ne prikazuje ništa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Al massimo un numero. Un calendario che mostra tutto non mostra nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hooguit één getal. Een agenda die alles toont, toont niets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwyżej jedna liczba. Kalendarz, który pokazuje wszystko, nie pokazuje nic."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No máximo um número. Um calendário que mostra tudo não mostra nada."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Največ ena številka. Koledar, ki pokaže vse, ne pokaže ničesar."
          }
        }
      }
    },
    "Only for certain years": {
