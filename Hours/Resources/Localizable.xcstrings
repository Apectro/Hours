    "You can see, change or remove them later in Settings › Day types & holidays.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie später unter Einstellungen › Tagesarten & Feiertage ansehen, ändern oder entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes verlos, cambiarlos o quitarlos más tarde en Ajustes › Tipos de día y festivos."
