    "Every hour pays the same.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Stunde wird gleich bezahlt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas las horas se pagan igual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque heure est payée pareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki sat plaća se jednako."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni ora è pagata allo stesso modo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk uur wordt hetzelfde betaald."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda godzina płatna jest tak samo."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas as horas são pagas da mesma forma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsaka ura se plača enako."
          }
        }
      }
    },
    "Everyone else keeps the site times: %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen behalten die Baustellenzeiten: %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los demás mantienen el horario de la obra: %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les autres gardent les horaires du chantier : %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi ostali zadržavaju vrijeme gradilišta: %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti gli altri mantengono gli orari del cantiere: %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle anderen houden de tijden van de bouwplaats: %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozostali zachowują godziny budowy: %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os restantes mantêm o horário da obra: %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi drugi obdržijo čas gradbišča: %@."
          }
        }
      }
    },
    "Everyone on this day stops at this time. Anyone who had already left keeps the time they left.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle an diesem Tag hören zu dieser Zeit auf. Wer schon gegangen war, behält seine eigene Uhrzeit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese día todos paran a esta hora. Quien ya se había ido conserva su hora de salida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce jour-là, tout le monde s’arrête à cette heure. Les personnes déjà parties gardent leur heure de départ."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi tog dana završavaju u ovo vrijeme. Tko je već otišao, zadržava svoje vrijeme odlaska."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quel giorno tutti smettono a quest’ora. Chi era già andato via mantiene il suo orario di uscita."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen stopt die dag op dit tijdstip. Wie al weg was, houdt zijn eigen vertrektijd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tego dnia wszyscy kończą o tej godzinie. Kto już wyszedł, zachowuje swoją godzinę wyjścia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Nesse dia todos param a esta hora. Quem já tinha saído mantém a sua hora de saída."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi ta dan končajo ob tej uri. Kdor je že odšel, obdrži svojo uro odhoda."
          }
        }
      }
    },
    "Everyone ticked on this day gets these times, except people whose own times you changed.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle, die an diesem Tag abgehakt sind, bekommen diese Zeiten – außer denen, deren eigene Zeiten du geändert hast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los marcados este día reciben este horario, salvo quienes tienen un horario propio que cambiaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toutes les personnes cochées ce jour-là reçoivent ces horaires, sauf celles dont vous avez modifié les horaires."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svi označeni na ovaj dan dobivaju ova vremena, osim onih kojima si promijenio vlastito vrijeme."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti quelli spuntati in questo giorno ricevono questi orari, tranne chi ha orari propri che hai cambiato."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Iedereen die op deze dag is aangevinkt krijgt deze tijden, behalve wie je eigen tijden hebt gegeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy zaznaczeni tego dnia dostają te godziny, oprócz osób, którym zmieniłeś własne godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os marcados neste dia ficam com este horário, exceto quem tem um horário próprio que alteraste."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsi, označeni na ta dan, dobijo te čase, razen tistih, ki si jim spremenil lastni čas."
          }
        }
      }
    },
    "Everything recorded through %@.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles erfasst bis %@."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo registrado hasta el %@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est enregistré jusqu'au %@."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve evidentirano do %@."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che è registrato fino al %@."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles vastgelegd tot en met %@."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zapisane do %@."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que está registado até %@."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse zabeleženo do %@."
          }
        }
      }
    },
    "Everything stays on this device.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles bleibt auf diesem Gerät."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout reste sur cet appareil."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ostaje na ovom uređaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto resta su questo dispositivo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles blijft op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko zostaje na tym urządzeniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo fica neste dispositivo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vse ostane na tej napravi."
          }
        }
      }
    },
    "Excel on Windows needs the byte-order mark to read accented characters correctly. Numbers, Google Sheets and LibreOffice are happy either way.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel unter Windows braucht die Byte-Order-Mark, um Zeichen mit Akzenten richtig zu lesen. Numbers, Google Sheets und LibreOffice kommen mit beidem zurecht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel en Windows necesita la marca de orden de bytes para leer bien los caracteres acentuados. Numbers, Google Sheets y LibreOffice funcionan igual con o sin ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel sous Windows a besoin de l’indicateur d’ordre des octets pour lire correctement les caractères accentués. Numbers, Google Sheets et LibreOffice s’accommodent des deux."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel na Windowsu treba oznaku redoslijeda bajtova da ispravno čita znakove s dijakritikom. Numbers, Google Sheets i LibreOffice rade i ovako i onako."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel su Windows ha bisogno del byte order mark per leggere correttamente i caratteri accentati. Numbers, Google Fogli e LibreOffice funzionano comunque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel op Windows heeft de byte-order mark nodig om letters met accenten goed te lezen. Numbers, Google Sheets en LibreOffice werken hoe dan ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel w Windowsie potrzebuje znacznika kolejności bajtów, aby poprawnie odczytać znaki diakrytyczne. Numbers, Arkusze Google i LibreOffice działają tak czy inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O Excel no Windows precisa da marca de ordem de bytes para ler corretamente os caracteres acentuados. O Numbers, o Google Sheets e o LibreOffice funcionam de qualquer forma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Excel v Windowsu potrebuje oznako vrstnega reda bajtov, da pravilno prebere znake z diakritiko. Numbers, Google Preglednice in LibreOffice delujejo tako ali tako."
          }
        }
      }
    },
