    "Days you excluded and days off never count as missing.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ausgenommene Tage und freie Tage gelten nie als fehlend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días excluidos y los no laborables nunca cuentan como ausentes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours exclus et les jours non travaillés ne comptent jamais comme manquants."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključeni dani i neradni dani nikad se ne broje kao nedostajući."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni esclusi e quelli non lavorativi non contano mai come mancanti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitgesloten dagen en vrije dagen tellen nooit als ontbrekend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni wykluczone i dni wolne nigdy nie liczą się jako brakujące."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias excluídos e os dias não úteis nunca contam como em falta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izključeni dnevi in prosti dnevi nikoli ne štejejo kot manjkajoči."
          }
        }
      }
    },
    "Days you have already recorded are left alone unless you turn the second one on.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits erfasste Tage bleiben unberührt, sofern du die zweite Option nicht einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días ya registrados no se tocan, salvo que actives la segunda opción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours déjà enregistrés ne sont pas touchés, sauf si vous activez la seconde option."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Već zabilježeni dani ostaju netaknuti osim ako ne uključiš drugu opciju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni già registrati restano intatti, a meno che non attivi la seconda opzione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Al vastgelegde dagen blijven ongemoeid, tenzij je de tweede optie aanzet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Już zapisane dni pozostają nietknięte, chyba że włączysz drugą opcję."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias já registados não são alterados, a não ser que ligues a segunda opção."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Že zabeleženi dnevi ostanejo nedotaknjeni, razen če vklopiš drugo možnost."
          }
        }
      }
    },
