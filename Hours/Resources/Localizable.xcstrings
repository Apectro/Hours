        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’onglet Chantiers reste dans tous les cas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartica Gradilišta ostaje u svakom slučaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La scheda Cantieri resta comunque."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het tabblad Bouwplaatsen blijft hoe dan ook."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Karta Budowy zostaje tak czy inaczej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O separador Obras fica de qualquer forma."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zavihek Gradbišča ostane v vsakem primeru."
          }
        }
      }
    },
    "The address is printed under the name on every sheet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresse steht auf jeder Liste unter dem Namen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dirección se imprime bajo el nombre en cada hoja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’adresse est imprimée sous le nom sur chaque feuille."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adresa se ispisuje ispod naziva na svakoj listi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indirizzo è stampato sotto il nome su ogni foglio."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het adres staat onder de naam op elk blad."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Adres jest drukowany pod nazwą na każdym arkuszu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A morada é impressa sob o nome em cada folha."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov je natisnjen pod imenom na vsakem listu."
          }
        }
      }
    },
