    "Delete this day? Hours written on a site stay.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Tag löschen? Auf einer Baustelle eingetragene Stunden bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Eliminar este día? Las horas escritas en una obra se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer ce jour ? Les heures saisies sur un chantier sont conservées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrisati ovaj dan? Sati upisani na gradilištu ostaju."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminare questo giorno? Le ore scritte in un cantiere restano."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze dag wissen? Uren die op een bouwplaats zijn ingevuld blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunąć ten dzień? Godziny wpisane na budowie zostają."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar este dia? As horas escritas numa obra mantêm-se."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Izbrišem ta dan? Ure, vpisane na gradbišču, ostanejo."
          }
        }
      }
    },
