        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bereits erfasste Tage bleiben unberührt, sofern du die zweite Option nicht einschaltest."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días ya registrados no se tocan, salvo que actives la segunda opción."
          }
