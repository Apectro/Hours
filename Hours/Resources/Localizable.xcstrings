    "The calendar already marks a working day with nothing on it. This tells you without having to look.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kalender markiert schon einen Arbeitstag ohne Eintrag. Das hier sagt es dir, ohne dass du nachsehen musst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El calendario ya marca un día laborable vacío. Esto te avisa sin tener que mirar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calendrier signale déjà un jour ouvré sans rien dedans. Ceci vous prévient sans avoir à regarder."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendar već označava radni dan bez upisa. Ovo ti to javi i bez gledanja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il calendario segna già un giorno lavorativo vuoto. Questo te lo dice senza che tu debba guardare."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De kalender markeert al een werkdag zonder invoer. Dit laat het je weten zonder dat je hoeft te kijken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalendarz już zaznacza pusty dzień pracy. To powie ci o tym bez zaglądania."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O calendário já marca um dia de trabalho vazio. Isto avisa-te sem teres de ir ver."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koledar že označi delovni dan brez vpisa. To ti pove, ne da bi moral pogledati."
          }
        }
      }
    },
    "The client's site manager can sign for all of these jobs at once. It is printed under the report.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bauleitung des Auftraggebers kann für alle diese Arbeiten auf einmal unterschreiben. Die Unterschrift steht unter dem Bericht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El jefe de obra del cliente puede firmar todos estos trabajos a la vez. La firma se imprime bajo el informe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le conducteur de travaux du client peut signer tous ces travaux en une fois. La signature figure sous le rapport."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voditelj gradilišta naručitelja može potpisati sve ove radove odjednom. Potpis se ispisuje ispod izvješća."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il direttore lavori del committente può firmare tutti questi lavori insieme. La firma viene stampata sotto il rapporto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bouwleider van de opdrachtgever kan al deze werkzaamheden in één keer aftekenen. De handtekening staat onder het rapport."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kierownik budowy zleceniodawcy może podpisać wszystkie te prace naraz. Podpis jest drukowany pod raportem."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O diretor de obra do cliente pode assinar todos estes trabalhos de uma vez. A assinatura é impressa por baixo do relatório."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vodja gradbišča naročnika lahko podpiše vsa ta dela hkrati. Podpis je natisnjen pod poročilom."
          }
        }
      }
    },
    "The clock could not be started.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Uhr konnte nicht gestartet werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo iniciar el fichaje."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pointage n'a pas pu démarrer."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sat se nije mogao pokrenuti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile avviare il timer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De klok kon niet worden gestart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się uruchomić zegara."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível iniciar a contagem."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure ni bilo mogoče zagnati."
          }
        }
      }
    },
    "The day is paid absence: your contracted hours are credited, so the balance is unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag ist bezahlte Abwesenheit: Deine Vertragsstunden werden gutgeschrieben, der Saldo bleibt also gleich."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día es una ausencia pagada: se acreditan tus horas de contrato, así que el saldo no cambia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour est une absence payée : vos heures contractuelles sont créditées, le solde ne change donc pas."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan je plaćeno odsustvo: ugovoreni sati se priznaju, pa se saldo ne mijenja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno è un'assenza retribuita: le ore contrattuali vengono accreditate, quindi il saldo non cambia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag is betaald verlof: je contracturen worden meegeteld, dus het saldo verandert niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień to płatna nieobecność: godziny z umowy są zaliczane, więc saldo się nie zmienia."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia é uma ausência paga: as tuas horas contratadas são creditadas, por isso o saldo não muda."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan je plačana odsotnost: pogodbene ure se priznajo, zato se saldo ne spremeni."
          }
        }
      }
    },
    "The day keeps its contracted hours and is expected to be worked. Only the name is carried through.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tag behält seine Vertragsstunden und wird gearbeitet. Nur der Name wird übernommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día mantiene sus horas de contrato y se espera que se trabaje. Solo se conserva el nombre."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le jour garde ses heures contractuelles et doit être travaillé. Seul le nom est repris."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan zadržava ugovorene sate i očekuje se rad. Prenosi se samo naziv."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giorno mantiene le ore contrattuali ed è lavorativo. Viene riportato solo il nome."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dag houdt zijn contracturen en er wordt gewerkt. Alleen de naam wordt overgenomen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzień zachowuje godziny z umowy i jest dniem pracy. Przenoszona jest tylko nazwa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O dia mantém as horas contratadas e espera-se que seja trabalhado. Só o nome é mantido."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dan obdrži pogodbene ure in se pričakuje delo. Prenese se samo ime."
          }
        }
      }
    },
    "The days you normally work and your usual hours. A day you leave empty is then a day short.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Tage, an denen du normalerweise arbeitest, und deine üblichen Zeiten. Ein Tag, den du leer lässt, fehlt dann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los días que trabajas normalmente y tu horario habitual. Un día que dejes vacío cuenta entonces como que falta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les jours où vous travaillez d’habitude et vos horaires habituels. Un jour laissé vide compte alors comme manquant."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dani kad obično radiš i tvoje uobičajeno vrijeme. Dan koji ostaviš prazan tada ti nedostaje."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I giorni in cui lavori di solito e il tuo orario abituale. Un giorno lasciato vuoto risulta poi mancante."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De dagen waarop je normaal werkt en je gebruikelijke tijden. Een dag die je leeg laat, komt dan tekort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni, w które zwykle pracujesz, i twoje zwykłe godziny. Dzień zostawiony pusty liczy się wtedy jako brakujący."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Os dias em que trabalhas normalmente e o teu horário habitual. Um dia que deixes vazio conta então como em falta."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevi, ko običajno delaš, in tvoj običajni čas. Dan, ki ga pustiš praznega, ti potem manjka."
          }
        }
      }
    },
    "The diary follows the hours: on pages of its own in the PDF, on a second sheet in Excel. A CSV holds the hours only.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Bautagebuch folgt den Stunden: auf eigenen Seiten im PDF, auf einem zweiten Blatt in Excel. Eine CSV enthält nur die Stunden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El diario va tras las horas: en páginas propias en el PDF, en una segunda hoja en Excel. Un CSV solo contiene las horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le journal suit les heures : sur ses propres pages dans le PDF, sur une deuxième feuille dans Excel. Un CSV ne contient que les heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevnik slijedi nakon sati: na vlastitim stranicama u PDF-u, na drugom listu u Excelu. CSV sadrži samo sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il giornale segue le ore: su pagine proprie nel PDF, su un secondo foglio in Excel. Un CSV contiene solo le ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het dagboek volgt na de uren: op eigen pagina's in de pdf, op een tweede blad in Excel. Een csv bevat alleen de uren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziennik jest po godzinach: na osobnych stronach w PDF, na drugim arkuszu w Excelu. CSV zawiera tylko godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O diário vem depois das horas: em páginas próprias no PDF, numa segunda folha no Excel. Um CSV só tem as horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dnevnik sledi uram: na lastnih straneh v PDF-ju, na drugem listu v Excelu. CSV vsebuje samo ure."
          }
        }
      }
    },
    "The director's sheet is part of Zeitkonto Pro. The preview is free, and every site day stays in your backup.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stundenliste für die Bauleitung gehört zu Zeitkonto Pro. Die Vorschau ist kostenlos, und jeder Baustellentag bleibt in deiner Sicherung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La hoja para el director forma parte de Zeitkonto Pro. La vista previa es gratis y cada día de obra se queda en tu copia de seguridad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La feuille pour le directeur fait partie de Zeitkonto Pro. L’aperçu est gratuit, et chaque journée de chantier reste dans votre sauvegarde."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lista za voditelja dio je Zeitkonto Pro. Pregled je besplatan, a svaki dan na gradilištu ostaje u tvojoj sigurnosnoj kopiji."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il foglio per il direttore fa parte di Zeitkonto Pro. L’anteprima è gratuita e ogni giornata di cantiere resta nel tuo backup."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De lijst voor de uitvoerder hoort bij Zeitkonto Pro. Het voorbeeld is gratis, en elke dag op de bouwplaats blijft in je back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkusz dla kierownika jest częścią Zeitkonto Pro. Podgląd jest bezpłatny, a każdy dzień na budowie zostaje w twojej kopii zapasowej."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A folha para o diretor faz parte do Zeitkonto Pro. A pré-visualização é grátis e cada dia de obra fica na tua cópia de segurança."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Seznam za vodjo je del Zeitkonto Pro. Predogled je brezplačen, vsak dan na gradbišču pa ostane v tvoji varnostni kopiji."
          }
        }
      }
    },
    "The file could not be opened. %@": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei konnte nicht geöffnet werden. %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo abrir el archivo. %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être ouvert. %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteku nije bilo moguće otvoriti. %@"
          }
        },
        "it": {
