          }
        }
      }
    },
    "A day off depending on your collective agreement": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Frei je nach Tarif- oder Kollektivvertrag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Libre según tu convenio colectivo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chômé selon votre convention collective"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slobodan ovisno o kolektivnom ugovoru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Libero a seconda del contratto collettivo"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vrij afhankelijk van je cao"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wolne zależnie od układu zbiorowego"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Livre conforme o teu contrato coletivo"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prost odvisno od kolektivne pogodbe"
          }
        }
      }
    },
    "A field allowance on the days you get one, kilometres in your own car, and travel time — on your own days and on sites.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auslöse an den Tagen, an denen du sie bekommst, Kilometer mit dem eigenen Auto und Fahrzeit – an deinen eigenen Tagen und auf Baustellen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La dieta los días que la cobras, los kilómetros con tu coche y el tiempo de viaje, en tus días y en las obras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’indemnité de déplacement les jours où vous y avez droit, les kilomètres avec votre voiture et le temps de trajet – sur vos journées et sur les chantiers."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terenski dodatak za dane kad ga dobiješ, kilometri vlastitim autom i vrijeme putovanja – na tvojim danima i na gradilištima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trasferta nei giorni in cui ti spetta, i chilometri con la tua auto e il tempo di viaggio – nei tuoi giorni e nei cantieri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toelage op de dagen dat je die krijgt, kilometers met je eigen auto en reistijd – op je eigen dagen en op bouwplaatsen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieta w dni, w które ci przysługuje, kilometry własnym autem i czas dojazdu – w twoich dniach i na budowach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As ajudas de custo nos dias em que as recebes, os quilómetros no teu carro e o tempo de viagem – nos teus dias e nas obras."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Terenski dodatek za dneve, ko ga dobiš, kilometri z lastnim avtom in čas potovanja – na tvojih dnevih in na gradbiščih."
          }
        }
      }
    },
    "A file for each person, with their days on every site. They all go in one share.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Datei für jede Person, mit ihren Tagen auf allen Baustellen. Alle werden zusammen geteilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un archivo para cada persona, con sus días en todas las obras. Se comparten todos a la vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un fichier par personne, avec ses jours sur tous les chantiers. Ils sont tous partagés en une fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka za svaku osobu, s danima na svim gradilištima. Sve se dijele odjednom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un file per ogni persona, con i suoi giorni in tutti i cantieri. Vengono condivisi tutti insieme."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een bestand per persoon, met de dagen op alle bouwplaatsen. Ze worden allemaal in één keer gedeeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plik dla każdej osoby, z dniami na wszystkich budowach. Wszystkie są udostępniane naraz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um ficheiro para cada pessoa, com os seus dias em todas as obras. São todos partilhados de uma vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteka za vsako osebo, z dnevi na vseh gradbiščih. Vse se delijo hkrati."
          }
        }
      }
    },
    "A file for each person, with their days on the sites on this sheet. They all go in one share.": {
      "extractionState": "manual",
