    "No hours for anyone. Your own day becomes Bad weather if nothing else is on it.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Stunden für niemanden. Dein eigener Tag wird zu Schlechtwetter, wenn sonst nichts darauf steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadie tiene horas. Tu día pasa a Mal tiempo si no hay nada más en él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune heure pour personne. Votre journée devient Intempéries si rien d’autre n’y figure."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nitko nema sati. Tvoj dan postaje Loše vrijeme ako na njemu nema ničeg drugog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna ora per nessuno. La tua giornata diventa Maltempo se non c’è nient’altro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Niemand heeft uren. Je eigen dag wordt Slecht weer als er verder niets op staat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nikt nie ma godzin. Twój dzień staje się Niepogodą, jeśli nie ma w nim nic innego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguém tem horas. O teu dia passa a Mau tempo se não houver mais nada nele."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nihče nima ur. Tvoj dan postane Slabo vreme, če na njem ni ničesar drugega."
          }
        }
      }
    },
    "No iCloud account is signed in on this device, so nothing is being synced. Sign in in the Settings app and sync starts by itself.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist kein iCloud-Account angemeldet, deshalb wird nichts synchronisiert. Melde dich in der Einstellungen-App an, dann startet Sync von selbst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna cuenta de iCloud en este dispositivo, así que no se sincroniza nada. Inicia sesión en la app Ajustes y la sincronización empezará sola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun compte iCloud n'est connecté sur cet appareil, rien n'est donc synchronisé. Connectez-vous dans l'app Réglages et la synchronisation démarrera d'elle-même."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na ovom uređaju nije prijavljen iCloud račun pa se ništa ne sinkronizira. Prijavi se u aplikaciji Postavke i sinkronizacija će krenuti sama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Su questo dispositivo non c'è nessun account iCloud, quindi non si sincronizza nulla. Accedi nell'app Impostazioni e la sincronizzazione partirà da sola."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op dit apparaat is geen iCloud-account ingelogd, dus er wordt niets gesynchroniseerd. Log in via de app Instellingen en de synchronisatie start vanzelf."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu nie jest zalogowane żadne konto iCloud, więc nic nie jest synchronizowane. Zaloguj się w aplikacji Ustawienia, a synchronizacja ruszy sama."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há nenhuma conta iCloud com sessão iniciada neste dispositivo, por isso nada está a ser sincronizado. Inicia sessão na app Definições e a sincronização começa sozinha."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "V tej napravi ni prijavljen noben račun iCloud, zato se nič ne sinhronizira. Prijavi se v aplikaciji Nastavitve in sinhronizacija se bo začela sama."
          }
        }
      }
    },
    "No line to sign on and no sign-off page. Signatures already given are kept.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Zeile zum Unterschreiben und keine Unterschriftenseite. Bereits geleistete Unterschriften bleiben gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin línea para firmar ni página de firmas. Las firmas ya dadas se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de ligne de signature ni de page de signatures. Les signatures déjà données sont conservées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez crte za potpis i bez stranice s potpisima. Već dani potpisi ostaju spremljeni."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna riga per la firma e nessuna pagina delle firme. Le firme già date restano salvate."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen regel om te tekenen en geen pagina met handtekeningen. Al gezette handtekeningen blijven bewaard."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez linii do podpisu i bez strony z podpisami. Złożone już podpisy pozostają zapisane."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem linha para assinar nem página de assinaturas. As assinaturas já dadas ficam guardadas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brez črte za podpis in brez strani s podpisi. Že dani podpisi ostanejo shranjeni."
          }
        }
      }
    },
