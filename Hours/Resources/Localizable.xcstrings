        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nel %@ non c’è ancora niente. Il tuo riepilogo si riempie insieme ai giorni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ is nog niets vastgelegd. Je overzicht vult zich met de dagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %@ nic jeszcze nie zapisano. Twoje podsumowanie wypełni się razem z dniami."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Ainda não há nada registado em %@. O teu resumo enche-se à medida que os dias passam."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za leto %@ še ni nič zabeleženo. Tvoj pregled se polni skupaj z dnevi."
