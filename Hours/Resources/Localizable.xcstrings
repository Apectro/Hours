            "value": "Na innej budowie"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Noutra obra"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na drugem gradbišču"
          }
        }
      }
    },
    "On the 1st, a note for each site from last month that its site sheet is ready. Tap it to open the sheet.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am 1. ein Hinweis für jede Baustelle vom letzten Monat, dass ihre Baustellenliste fertig ist. Tippen öffnet die Liste."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día 1, un aviso por cada obra del mes pasado: su hoja de obra está lista. Tócalo para abrirla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1er du mois, un avis pour chaque chantier du mois dernier : sa feuille de chantier est prête. Touchez-le pour l’ouvrir."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvog u mjesecu obavijest za svako gradilište iz prošlog mjeseca da je list gradilišta spreman. Dodir ga otvara."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo del mese, un avviso per ogni cantiere del mese scorso: il foglio di cantiere è pronto. Toccalo per aprirlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Op de 1e een melding voor elke bouwplaats van vorige maand dat de bouwplaatslijst klaar is. Tik erop om hem te openen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszego dnia miesiąca powiadomienie dla każdej budowy z zeszłego miesiąca, że arkusz budowy jest gotowy. Dotknij, aby go otworzyć."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "No dia 1, um aviso por cada obra do mês passado: a folha de obra está pronta. Toca nele para a abrir."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prvega v mesecu obvestilo za vsako gradbišče iz prejšnjega meseca, da je list gradbišča pripravljen. Dotik ga odpre."
          }
        }
      }
    },
