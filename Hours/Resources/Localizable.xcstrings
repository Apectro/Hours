    "Not offered for new days. Every day already recorded for them stays, on screen and on exports.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Werden für neue Tage nicht angeboten. Jeder bereits für sie erfasste Tag bleibt, auf dem Bildschirm und in Exporten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ofrecen para días nuevos. Cada día ya registrado para ellos se mantiene, en pantalla y en las exportaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne sont plus proposés pour les nouveaux jours. Chaque jour déjà enregistré pour eux reste, à l’écran et dans les exports."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne nude se za nove dane. Svaki dan koji je za njih već zabilježen ostaje, na zaslonu i u izvozima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vengono proposti per i nuovi giorni. Ogni giorno già registrato per loro resta, sullo schermo e nelle esportazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Worden niet aangeboden voor nieuwe dagen. Elke dag die al voor hen is vastgelegd blijft, op het scherm en in exports."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie są proponowani na nowe dni. Każdy dzień już dla nich zapisany zostaje, na ekranie i w eksportach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Não são sugeridos para novos dias. Cada dia já registado para eles mantém-se, no ecrã e nas exportações."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne ponujajo se za nove dneve. Vsak dan, ki je zanje že zabeležen, ostane, na zaslonu in v izvozih."
          }
        }
      }
    },
