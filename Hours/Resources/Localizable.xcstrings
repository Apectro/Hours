    "Tap a name to tick or untick them. Tap their times to change just that person.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf einen Namen, um ihn abzuhaken oder den Haken zu entfernen. Tippe auf die Zeiten, um nur diese Person zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un nombre para marcarlo o desmarcarlo. Toca sus horas para cambiar solo a esa persona."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez un nom pour le cocher ou le décocher. Touchez ses horaires pour ne modifier que cette personne."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirni ime da ga označiš ili odznačiš. Dodirni vremena da promijeniš samo tu osobu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca un nome per spuntarlo o togliere la spunta. Tocca gli orari per cambiare solo quella persona."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een naam om die aan of uit te vinken. Tik op de tijden om alleen die persoon te wijzigen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij imię, aby zaznaczyć lub odznaczyć osobę. Stuknij godziny, aby zmienić tylko tę osobę."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca num nome para o marcar ou desmarcar. Toca no horário para alterar só essa pessoa."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
