    },
    "Removes everything recorded on those days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt alles, was an diesen Tagen erfasst ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina todo lo registrado en esos días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
