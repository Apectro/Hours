            "value": "Adres"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Morada"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naslov"
          }
        }
      }
    },
    "Adds a button on today that starts and stops a clock. Switch it off if you would rather enter hours after the fact.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt bei „Heute“ eine Taste hinzu, die eine Uhr startet und stoppt. Schalte es aus, wenn du Stunden lieber nachträglich einträgst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un botón en hoy que inicia y detiene un fichaje. Desactívalo si prefieres introducir las horas después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bouton sur aujourd’hui qui démarre et arrête un pointage. Désactivez-le si vous préférez saisir les heures après coup."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje gumb na današnji dan koji pokreće i zaustavlja sat. Isključi ako radije unosiš sate naknadno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pulsante su oggi che avvia e ferma una timbratura. Disattivalo se preferisci inserire le ore dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een knop toe op vandaag die een klok start en stopt. Zet het uit als je de uren liever achteraf invoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przycisk na dziś, który uruchamia i zatrzymuje zegar. Wyłącz, jeśli wolisz wpisywać godziny później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão em hoje que inicia e para um registo. Desliga se preferires introduzir as horas depois."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doda gumb na današnji dan, ki zažene in ustavi uro. Izklopi, če raje vnašaš ure naknadno."
          }
        }
      }
    },
    "Adds each day's earnings as a last column. Off by default: timesheets usually go to someone. A site sheet never shows money.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt den Verdienst jedes Tages als letzte Spalte hinzu. Standardmäßig aus, da ein Stundenzettel meist weitergegeben wird. Eine Baustellenliste zeigt nie Geld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade lo ganado cada día como última columna. Desactivado de entrada: una hoja de horas suele entregarse. Una hoja de obra nunca muestra dinero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute la rémunération de chaque jour en dernière colonne. Désactivé par défaut : une feuille d’heures est souvent remise. Une feuille de chantier ne montre jamais d’argent."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje zaradu svakog dana kao zadnji stupac. Isključeno je jer se evidencija obično nekome predaje. List gradilišta nikad ne prikazuje novac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge il compenso di ogni giorno come ultima colonna. Spento di base: un foglio ore di solito si consegna. Il foglio di cantiere non mostra mai denaro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt wat elke dag opleverde toe als laatste kolom. Standaard uit: een urenstaat geef je meestal af. Een bouwplaatslijst toont nooit geld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje zarobek z każdego dnia jako ostatnią kolumnę. Domyślnie wyłączone, bo ewidencję zwykle się oddaje. Arkusz budowy nigdy nie pokazuje pieniędzy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Acrescenta o que cada dia rendeu como última coluna. Desligado de início: uma folha de horas costuma ser entregue. Uma folha de obra nunca mostra dinheiro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doda zaslužek vsakega dne kot zadnji stolpec. Privzeto izklopljeno, saj se evidenca običajno nekomu izroči. List gradbišča nikoli ne kaže denarja."
          }
        }
      }
    },
