    "1st of the month": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am 1. des Monats"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El día 1 del mes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1er du mois"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "1. u mjesecu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il 1° del mese"
          }
        },
        "nl": {
          "stringUnit": {
