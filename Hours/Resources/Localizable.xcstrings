            "state": "translated",
            "value": "Adicionar outro bloco"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj še en blok"
          }
        }
      }
    },
    "Add break": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pause hinzufügen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir descanso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter une pause"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj pauzu"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi pausa"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pauze toevoegen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj przerwę"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicionar pausa"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj odmor"
          }
        }
      }
    },
    "Add the days that apply where you work. A recurring holiday only has to be entered once.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Trage die Tage ein, die an deinem Arbeitsort gelten. Ein wiederkehrender Feiertag muss nur einmal erfasst werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los días que se aplican donde trabajas. Un festivo recurrente solo hay que introducirlo una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez les jours applicables là où vous travaillez. Un jour férié récurrent ne se saisit qu’une fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dane koji vrijede tamo gdje radiš. Praznik koji se ponavlja unosi se samo jednom."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi i giorni validi dove lavori. Una festività ricorrente va inserita una volta sola."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg de dagen toe die gelden waar jij werkt. Een terugkerende feestdag hoef je maar één keer in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dni obowiązujące tam, gdzie pracujesz. Powtarzające się święto wystarczy wprowadzić raz."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona os dias que se aplicam onde trabalhas. Um feriado recorrente só tem de ser introduzido uma vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj dneve, ki veljajo tam, kjer delaš. Praznik, ki se ponavlja, je treba vnesti samo enkrat."
          }
        }
      }
    },
    "Adds a button on today that starts and stops a clock. Switch it off if you would rather enter hours after the fact.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fügt bei „Heute“ eine Taste hinzu, die eine Uhr startet und stoppt. Schalte es aus, wenn du Stunden lieber nachträglich einträgst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un botón en hoy que inicia y detiene un fichaje. Desactívalo si prefieres introducir las horas después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute un bouton sur aujourd’hui qui démarre et arrête un pointage. Désactivez-le si vous préférez saisir les heures après coup."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje gumb na današnji dan koji pokreće i zaustavlja sat. Isključi ako radije unosiš sate naknadno."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiunge un pulsante su oggi che avvia e ferma una timbratura. Disattivalo se preferisci inserire le ore dopo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voegt een knop toe op vandaag die een klok start en stopt. Zet het uit als je de uren liever achteraf invoert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaje przycisk na dziś, który uruchamia i zatrzymuje zegar. Wyłącz, jeśli wolisz wpisywać godziny później."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Adiciona um botão em hoje que inicia e para um registo. Desliga se preferires introduzir as horas depois."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doda gumb na današnji dan, ki zažene in ustavi uro. Izklopi, če raje vnašaš ure naknadno."
          }
        }
      }
    },
    "Adjustment": {
      "extractionState": "manual",
      "localizations": {
