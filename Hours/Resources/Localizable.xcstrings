    "Closing a year fixes what it carries into the next. A cap limits overtime carried; a shortfall always carries in full.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Jahresabschluss legt fest, was ins nächste Jahr geht. Eine Grenze kürzt Überstunden; ein Minus geht immer ganz mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar un año fija lo que pasa al siguiente. Un límite recorta las horas extra; un déficit pasa siempre entero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clôturer une année fixe ce qu’elle reporte sur la suivante. Un plafond limite les heures reportées ; un déficit se reporte toujours en entier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje godine utvrđuje što se prenosi u sljedeću. Granica ograničava prekovremene; manjak se uvijek prenosi cijeli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere un anno fissa ciò che passa al successivo. Un limite riduce gli straordinari; un deficit passa sempre per intero."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een jaar afsluiten legt vast wat naar het volgende gaat. Een grens beperkt overuren; een tekort gaat altijd volledig mee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie roku ustala, co przechodzi na następny. Limit ogranicza nadgodziny; niedobór przechodzi zawsze w całości."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar um ano fixa o que transita para o seguinte. Um limite corta as horas extra; um défice transita sempre por inteiro."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaključek leta določi, kaj se prenese v naslednje. Omejitev omeji nadure; primanjkljaj se vedno prenese v celoti."
          }
        }
      }
    },
