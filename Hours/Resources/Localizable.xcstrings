        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "DANAS ZARAĐENO"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "GUADAGNATO OGGI"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "VANDAAG VERDIEND"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "ZAROBIONE DZIŚ"
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "GANHO HOJE"
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "DANES ZASLUŽENO"
          }
        }
      }
    },
    "Each building site on a card. A site has buttons for its Crew, Diary, Sheet and Extra work; the gear is its settings. New site sets one up step by step.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Baustelle auf einer Karte. Eine Baustelle hat Knöpfe für Mannschaft, Tagebuch, Liste und Zusatzarbeiten; das Zahnrad sind ihre Einstellungen. Neue Baustelle richtet eine Schritt für Schritt ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra en una tarjeta. Una obra tiene botones para la cuadrilla, el diario, la hoja y los trabajos adicionales; el engranaje son sus ajustes. Nueva obra prepara una paso a paso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chantier sur une carte. Un chantier a des boutons pour l’équipe, le journal, la feuille et les travaux supplémentaires ; l’engrenage ouvre ses réglages. Nouveau chantier en prépare un étape par étape."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako gradilište na kartici. Gradilište ima gumbe za ekipu, dnevnik, listu i dodatne radove; zupčanik su njegove postavke. Novo gradilište postavlja jedno korak po korak."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cantiere su una scheda. Un cantiere ha pulsanti per squadra, giornale, foglio e lavori extra; l’ingranaggio sono le sue impostazioni. Nuovo cantiere ne prepara uno passo per passo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bouwplaats op een kaart. Een bouwplaats heeft knoppen voor ploeg, dagboek, blad en meerwerk; het tandwiel zijn de instellingen. Nieuwe bouwplaats stelt er stap voor stap een in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda budowa na karcie. Budowa ma przyciski: ekipa, dziennik, arkusz i prace dodatkowe; zębatka to jej ustawienia. Nowa budowa przygotowuje ją krok po kroku."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra num cartão. Uma obra tem botões para a equipa, o diário, a folha e os trabalhos adicionais; a roda dentada são as definições. Nova obra prepara uma passo a passo."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako gradbišče na kartici. Gradbišče ima gumbe za ekipo, dnevnik, list in dodatna dela; zobnik so njegove nastavitve. Novo gradbišče ga nastavi korak za korakom."
          }
        }
      }
    },
    "Each job keeps its own contracted week, so two jobs with different hours each get their own balance rather than sharing one.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Tätigkeit hat ihre eigene Vertragswoche, damit zwei Tätigkeiten mit unterschiedlichen Stunden je einen eigenen Saldo haben statt eines gemeinsamen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trabajo tiene su propia semana contratada, así que dos trabajos con horas distintas tienen cada uno su saldo en vez de compartirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque poste a sa propre semaine contractuelle : deux postes aux heures différentes ont donc chacun leur solde plutôt qu’un solde commun."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svaki posao ima svoj ugovoreni tjedan pa dva posla s različitim satima imaju svaki svoj saldo umjesto zajedničkog."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni lavoro ha la propria settimana contrattuale, così due lavori con ore diverse hanno ciascuno il proprio saldo invece di condividerne uno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke functie heeft zijn eigen contractweek, dus twee functies met verschillende uren krijgen elk hun eigen saldo in plaats van één gedeeld saldo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda praca ma własny tydzień umowny, więc dwie prace o różnych godzinach mają osobne salda zamiast wspólnego."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada trabalho tem a sua própria semana contratada, por isso dois trabalhos com horas diferentes têm cada um o seu saldo em vez de partilharem um."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako delo ima svoj pogodbeni teden, zato imata dve deli z različnimi urami vsako svoj saldo namesto skupnega."
          }
        }
      }
    },
    "Each person's hours a day are added up across the sites you pick, on one sheet with a By site total.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Stunden jeder Person werden pro Tag über die gewählten Baustellen addiert, auf einem Blatt mit einer Summe nach Baustelle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de cada persona se suman por día en las obras que elijas, en una sola hoja con un total por obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de chaque personne sont additionnées par jour sur les chantiers que vous choisissez, sur une seule feuille avec un total par chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati svake osobe zbrajaju se po danu na odabranim gradilištima, na jednom listu sa zbrojem po gradilištu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di ogni persona vengono sommate per giorno sui cantieri scelti, in un unico foglio con il totale per cantiere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uren van elke persoon worden per dag opgeteld over de gekozen bouwplaatsen, op één blad met een totaal per bouwplaats."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny każdej osoby są sumowane dziennie na wybranych budowach, na jednym arkuszu z sumą według budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas de cada pessoa são somadas por dia nas obras que escolheres, numa só folha com um total por obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure vsake osebe se seštejejo po dnevih na izbranih gradbiščih, na enem listu s seštevkom po gradbišču."
          }
        }
      }
    },
    "Each site can change these in its own settings.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Baustelle kann das in ihren eigenen Einstellungen ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra puede cambiarlos en sus propios ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chantier peut les modifier dans ses propres réglages."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako gradilište to može promijeniti u svojim postavkama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cantiere può cambiarli nelle sue impostazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bouwplaats kan dit aanpassen in de eigen instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda budowa może to zmienić we własnych ustawieniach."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra pode alterá-los nas suas definições."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako gradbišče lahko to spremeni v svojih nastavitvah."
          }
        }
      }
    },
    "Each site keeps its own crew, so they are added to this one as new names. Their days on other sites stay where they are.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Baustelle hat ihre eigene Mannschaft, deshalb kommen sie hier als neue Namen dazu. Ihre Tage auf anderen Baustellen bleiben, wo sie sind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra tiene su propia cuadrilla, así que se añaden aquí como nombres nuevos. Sus días en otras obras se quedan donde están."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque chantier a sa propre équipe : ils sont donc ajoutés ici comme nouveaux noms. Leurs jours sur les autres chantiers restent où ils sont."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Svako gradilište ima svoju ekipu, pa se ovdje dodaju kao nova imena. Njihovi dani na drugim gradilištima ostaju gdje jesu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni cantiere ha la sua squadra, quindi vengono aggiunti qui come nuovi nomi. I loro giorni sugli altri cantieri restano dove sono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke bouwplaats heeft een eigen ploeg, dus ze komen hier als nieuwe namen bij. Hun dagen op andere bouwplaatsen blijven waar ze zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda budowa ma własną ekipę, więc zostaną tu dodani jako nowe nazwiska. Ich dni na innych budowach zostają tam, gdzie są."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada obra tem a sua própria equipa, por isso são adicionados aqui como nomes novos. Os seus dias noutras obras ficam onde estão."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vsako gradbišče ima svojo ekipo, zato so tukaj dodani kot nova imena. Njihovi dnevi na drugih gradbiščih ostanejo, kjer so."
          }
        }
      }
    },
