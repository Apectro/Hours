          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier n'a pas pu être préparé. %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Datoteku nije bilo moguće pripremiti. %@"
          }
        },
        "it": {
