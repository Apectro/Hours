    "Archived. Switch off Archived under Edit to change its days.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviert. Schalte „Archiviert“ unter „Bearbeiten“ aus, um ihre Tage zu ändern."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivado. Desactiva «Archivado» en «Editar» para cambiar sus días."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivé. Désactivez « Archivé » dans « Modifier » pour changer ses journées."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivirano. Isključi „Arhivirano” pod „Uredi” da promijeniš njegove dane."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiviato. Disattiva «Archiviato» in «Modifica» per cambiarne i giorni."
          }
        },
        "nl": {
