{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "Why the app asks for the camera: the site diary's Take photo button.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera is used only when you take a photo for a site diary."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera wird nur verwendet, wenn du ein Foto für ein Bautagebuch aufnimmst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara solo se usa cuando haces una foto para un diario de obra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo n’est utilisé que lorsque vous prenez une photo pour un journal de chantier."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera se koristi samo kad snimaš fotografiju za građevinski dnevnik."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera viene usata solo quando scatti una foto per un giornale dei lavori."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De camera wordt alleen gebruikt als je een foto maakt voor een bouwdagboek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aparat jest używany tylko wtedy, gdy robisz zdjęcie do dziennika budowy."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmara só é usada quando tiras uma foto para um diário de obra."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamera se uporablja samo, ko posnameš fotografijo za gradbeni dnevnik."
          }
        }
      }
    }
  },
  "version": "1.0"
}
