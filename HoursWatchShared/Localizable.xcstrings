    "Not a working day": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Arbeitstag"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No es un día laborable"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jour non travaillé"
          }
        },
        "hr": {
          "stringUnit": {
