    "What you have worked today, and whether the clock is running.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was du heute gearbeitet hast und ob die Uhr läuft."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que has trabajado hoy, y si el fichaje está en curso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que vous avez travaillé aujourd’hui, et si le pointage est en cours."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odrađeno danas i radi li sat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto hai lavorato oggi, e se la timbratura è in corso."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat je vandaag hebt gewerkt, en of de klok loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile dziś przepracowano i czy zegar działa."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que trabalhaste hoje, e se o registo está em curso."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes opravljeno in ali ura teče."
          }
        }
      }
    },
