    "What this month has earned so far: hours, allowance and kilometres.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was dieser Monat bisher eingebracht hat: Stunden, Auslöse und Kilometer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que llevas ganado este mes: horas, dietas y kilómetros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que ce mois a rapporté jusqu’ici : heures, indemnités et kilomètres."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko je ovaj mjesec dosad donio: sati, terenski dodatak i kilometri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto ha reso finora questo mese: ore, trasferta e chilometri."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wat deze maand tot nu toe oplevert: uren, toelage en kilometers."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile ten miesiąc dotąd przyniósł: godziny, diety i kilometry."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "O que este mês rendeu até agora: horas, ajudas de custo e quilómetros."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Koliko je ta mesec doslej prinesel: ure, terenski dodatek in kilometri."
          }
        }
      }
    },
