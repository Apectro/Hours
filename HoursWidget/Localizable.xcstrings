            "value": "Démarre le pointage, ou l’arrête et enregistre les heures."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokreće sat ili ga zaustavlja i bilježi sate."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la timbratura oppure la ferma e registra le ore."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de klok, of stopt hem en legt de uren vast."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uruchamia zegar albo go zatrzymuje i zapisuje godziny."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia o registo, ou para-o e regista as horas."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zažene uro ali jo ustavi in zabeleži ure."
          }
        }
      }
    },
