    "Hours this week, day by day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stunden dieser Woche, Tag für Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las horas de esta semana, día a día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures de cette semaine, jour par jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati ovog tjedna, dan po dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ore di questa settimana, giorno per giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uren deze week, dag voor dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny w tym tygodniu, dzień po dniu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "As horas desta semana, dia a dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure tega tedna, dan za dnem."
          }
        }
      }
    },
    "Hours worked this month, and whether you are ahead or behind.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Monat gearbeitete Stunden und ob du vorn oder hinten liegst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas trabajadas este mes, y si vas adelantado o atrasado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les heures travaillées ce mois-ci, et si vous êtes en avance ou en retard."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sati odrađeni ovaj mjesec i jesi li u plusu ili minusu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ore lavorate questo mese, e se sei avanti o indietro."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gewerkte uren deze maand, en of je voor of achter loopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Godziny przepracowane w tym miesiącu i czy jesteś do przodu, czy do tyłu."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas trabalhadas este mês, e se estás adiantado ou atrasado."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ure, opravljene ta mesec, in ali si v plusu ali minusu."
          }
        }
      }
    },
