    "Today on your site, and who was there last time.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Heute auf deiner Baustelle, und wer zuletzt da war."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy en tu obra, y quién estuvo la última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui sur votre chantier, et qui était là la dernière fois."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas na tvom gradilištu i tko je bio tamo zadnji put."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi nel tuo cantiere, e chi c’era l’ultima volta."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vandaag op je bouwplaats, en wie er de vorige keer was."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś na twojej budowie i kto był tam ostatnio."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje na tua obra, e quem lá esteve da última vez."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Danes na tvojem gradbišču in kdo je bil tam zadnjič."
          }
        }
      }
    },
    "Today's crew on your site: who is there, and why the others are not.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Mannschaft auf deiner Baustelle heute: wer da ist und warum die anderen fehlen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cuadrilla de hoy en tu obra: quién está y por qué faltan los demás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’équipe du jour sur votre chantier : qui est là, et pourquoi les autres non."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Današnja ekipa na gradilištu: tko je tu i zašto drugih nema."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La squadra di oggi in cantiere: chi c’è e perché gli altri no."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ploeg van vandaag op je bouwplaats: wie er is en waarom de anderen niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzisiejsza ekipa na budowie: kto jest i dlaczego reszty nie ma."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A equipa de hoje na tua obra: quem está e porque faltam os outros."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Današnja ekipa na gradbišču: kdo je tu in zakaj drugih ni."
          }
        }
      }
    },
