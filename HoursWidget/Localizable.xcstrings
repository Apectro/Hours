    "Opens today on your site, filled in like the last day.": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet heute auf deiner Baustelle, ausgefüllt wie am letzten Tag."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre hoy en tu obra, rellenado como el último día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre aujourd’hui sur votre chantier, rempli comme le dernier jour."
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara današnji dan na tvom gradilištu, ispunjen kao zadnji dan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre oggi sul tuo cantiere, compilato come l’ultimo giorno."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent vandaag op je bouwplaats, ingevuld zoals de laatste dag."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera dzisiejszy dzień na twojej budowie, wypełniony jak ostatni dzień."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre hoje na tua obra, preenchido como no último dia."
          }
        },
        "sl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpre današnji dan na tvojem gradbišču, izpolnjen kot zadnji dan."
          }
        }
      }
    },
